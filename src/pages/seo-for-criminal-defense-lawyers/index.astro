---
// /seo-for-criminal-defense-lawyers/ from content/v3/seo-for-criminal-defense-lawyers.md. The commercial top is the
// v2 build: a white hero with no split, the El Paso 9 -> 23 set huge across the page over its two charts, then the
// real calendar. The v2 bands after it gave way to the depth zone (src/content/depth/): the charge and county
// matrix, family searches as patterns, the court windows as steps, the intake checklist, a white mid-page CTA
// between ink rules, the marketing habits as inline rows, the price as plain lines (no PriceBand on this page),
// then the open FAQ (fog), the author box and FinalCta.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import NumPair from '../../components/kit/NumPair.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-criminal-defense-lawyers/';
const title = 'SEO for Criminal Defense Lawyers | Be the First Call';
const description =
  'SEO for criminal defense lawyers: charge and county pages, reach across counties, family searches, court dates, after-hours calls and specialist rules.';
const depth = await getDepth('seo-for-criminal-defense-lawyers');

// "What do family members search": patterns, not real searches, so plain text (never Q, never data-no-check).
const familyPatterns = [
  '“[relative] arrested, when is the first court date”',
  '“how to find out if someone is in [county] jail”',
  '“how to pay bail in [county]”',
  '“can I hire a lawyer for my [relative]”',
];

// "Which defense marketing habits cost a firm calls?": one template per row (the habit, why it fails, what we do).
const habits = [
  {
    title: 'Calling people from arrest lists.',
    text: 'ABA Formal Opinion 501 (April 13, 2022) treats a lawyer’s phone calls to people on a list of recent arrestees as a breach of Model Rule 7.3(b) (<a href="https://www.americanbar.org/news/abanews/aba-news-archives/2022/04/aba-issues-guidance-on-live-person-lawyer-solicitation/">ABA summary</a>). Each state adopts that rule in its own form. We build pages people find, so the person makes the first contact.',
  },
  { title: '“Open 24 hours” with voicemail behind it.', text: 'Each hour on the profile has a person on the line.' },
  { title: 'County pages with only the name swapped.', text: 'They fail the swap test and Google’s doorway policy. Each county page carries that county’s facts.' },
  { title: '“Expert” and “specialist” in page titles.', text: 'Titles follow the table above, and the firm approves them.' },
  {
    title: 'Reviews written by the agency.',
    text: 'The US FTC rule bans writing, buying or selling fake reviews (<a href="https://www.ftc.gov/business-guidance/resources/consumer-reviews-testimonials-rule-questions-answers">FTC questions and answers</a>). Every review comes from a real client.',
  },
  { title: 'Dismissals as headlines.', text: 'A dismissal is a past result, so your state’s past-results rule applies before it appears on a page.' },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for criminal defense lawyers' }]}
  service={{ name: 'SEO for criminal defense lawyers' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="stack"
    panel={false}
    class="cr-hero"
    h1="Be the first call after a charge: SEO for criminal defense lawyers."
    lead="After a charge, someone searches the charge and the county, then calls one of the first names Google shows. We put your firm among them."
    form={{ who: 'your defense firm', idPrefix: 'crim-hero', label: 'crim-hero', practiceArea: 'Criminal defense' }}
    formRow={false}
  >
    <figure slot="visual" class="cr-proof">
      <NumPair size="xl" before={9} after={23} beforeLabel="calls in six months before us" afterLabel="calls in three months with us" decorative={false} />
      <div class="cr-proof__shots">
        <Shot priority images={[shot(proof.elpasoCallsBefore, { marks: ['total'] })]} />
        <Shot priority tag="23 calls" tagSide="right" images={[shot(proof.elpasoCallsAfter, { marks: ['total'] })]} />
      </div>
      <figcaption class="lse-small">For a PI firm in El Paso, counted by Google from its Business Profile. A criminal defense search runs through the same Map, so the same profile work applies.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth}>
    <div slot="family" class="cr-family">
      <h3 class="cr-family__h">How family members search</h3>
      <ul class="cr-family__list">
        {familyPatterns.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div slot="habits" class="cr-habits">
      <Rows variant="inline" items={habits} />
    </div>
    <Band slot="mid" class="cr-mid">
      <div class="cr-mid__in">
        <p class="cr-mid__line">Fahim can check this page matrix against your own counties, live, in a ranking review.</p>
        <Button />
      </div>
    </Band>
    <Band slot="price" class="cr-price">
      <p class="cr-price__line">Criminal defense SEO with us starts from $2,000 a month. That covers the defense pages, the profile and review routine, links, call tracking and monthly checks on AI answers, and there is no setup fee. The full breakdown is on our <a href="/seo-pricing/">law firm SEO pricing</a> page.</p>
    </Band>
  </DepthZone>

  <FinalCta heading="What would it cost to be the first call after an arrest in your county?" writeHref="#crim-hero-form">
    In 30 minutes, Fahim searches your top charges in each county you serve and shows which page would win the next call.
  </FinalCta>
</InnerPage>

<style is:global>
  .cr-hero .lse-hero__h { max-width: 17ch; }
  .cr-hero .lse-hero__lead { max-width: 34em; }
  .cr-proof { display: grid; gap: clamp(28px, 3vw, 40px); margin-top: clamp(12px, 2vw, 24px); padding-top: clamp(32px, 4vw, 48px); border-top: 2px solid var(--ink); }
  .cr-proof .lse-nums__l { max-width: 11em; }
  .cr-proof__shots { display: grid; gap: 24px; }
  .cr-proof figcaption { max-width: 46em; }
  @media (min-width: 760px) {
    .cr-proof__shots { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; column-gap: clamp(24px, 3vw, 48px); }
  }

  /* Family searches: one column of patterns at the text's width, set like a search list but in plain type. */
  .cr-family { max-width: 35em; }
  .cr-family__h { font-size: 22px; padding-bottom: 12px; border-bottom: 2px solid var(--ink); }
  .cr-family__list { list-style: none; }
  .cr-family__list li { padding: 14px 0 15px; border-bottom: 1px solid var(--line-2); font-size: clamp(17px, .3vw + 15px, 19px); font-weight: 600; line-height: 1.35; color: var(--ink); }

  .cr-habits { max-width: 40em; }

  /* Mid-page CTA on white, between two ink rules, so it reads as its own stop in the long white text. */
  .cr-mid { padding-block: clamp(24px, 3vw, 40px); }
  .cr-mid__in {
    display: grid; gap: var(--s4); justify-items: start;
    padding-block: clamp(36px, 4vw, 56px); border-block: 2px solid var(--ink);
  }
  .cr-mid__line { max-width: 24em; font-size: clamp(24px, 1.2vw + 17px, 34px); font-weight: 750; line-height: 1.18; letter-spacing: -.02em; color: var(--ink); }
  @media (min-width: 1000px) {
    .cr-mid__in { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 64px; }
  }

  /* The price, as plain lines: no band colour and no button (no PriceBand on this page). */
  .cr-price { padding-top: 0; }
  .cr-price__line { max-width: 36em; padding-top: var(--s4); border-top: 1px solid var(--line-2); font-size: var(--fs-lead); line-height: 1.5; color: var(--ink); }
  .cr-price__line a { font-weight: 700; }
</style>
