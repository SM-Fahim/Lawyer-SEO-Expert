---
// /seo-for-dui-attorneys/. The commercial top is the row hero: the H1 across the top, then the form card with the
// new-profile calls chart beside it on the fog panel. The depth zone (src/content/depth/, v4: written from our own
// practice) opens on a fog band (byline, summary, jump list): the two clocks, the license page with the El Paso AI
// source beside it, the build steps, the profile, the "won't do" list drawn with crosses, the marker price band,
// then the accordion FAQ on white, the author box and FinalCta. No mid-page CTA.
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-dui-attorneys/';
const title = 'SEO for DUI Attorneys | Win the Near Me Search';
const description =
  'SEO for DUI attorneys: the license deadline page first, the DUI pages around it, the profile drivers find after release, what you may claim and the cost.';
const depth = await getDepth('seo-for-dui-attorneys');
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for DUI attorneys' }]}
  service={{ name: 'SEO for DUI attorneys' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    class="dui-hero"
    h1="SEO for DUI attorneys that wins the “near me” search after an arrest."
    lead="A DUI search is local and it is urgent. We get your firm onto the Map when a driver searches, and onto Google for the license questions that come next."
    form={{ who: 'your DUI practice', idPrefix: 'dui-hero', label: 'dui-hero', practiceArea: 'DUI' }}
  >
    <figure slot="visual" class="dui-fig">
      <Shot tag="1 to 9 calls" tagSide="left" priority images={[shot(proof.newProfileCalls, { crop: 'line', marks: ['points'], phone: 'axis', alt: 'Google Business Profile calls for a new profile, June to October 2026: about 1 call in July, rising to 9 in October' })]} />
      <figcaption>A new Google profile for a PI firm in New Orleans, July to October 2026.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} faqTone="white">
    <figure slot="proof" class="lse-depth__proof">
      <Shot tag="First source" tagSide="right" images={[shot(proof.elpasoAiDeadline, { marks: ['citedLine', 'sourceCard'] })]} />
      <figcaption>A Texas filing deadline: Google’s AI answer puts a PI firm in El Paso’s page at the top of its sources.</figcaption>
    </figure>
    <PriceBand
      slot="price"
      heading="What a DUI firm pays: one monthly price, from $2,000."
      headingId="price-h"
      lead="One price covers your DUI and license pages, profile care and reviews, links, upkeep of the site, call tracking and checks on Google’s AI answers, with nothing charged for setup."
    >
      <Fragment slot="link">What moves the figure: <a href="/seo-pricing/">law firm SEO pricing</a></Fragment>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="Ask what a steady run of DUI and license-hearing calls would cost your practice." writeHref="#dui-hero-form">
    In 30 minutes, Fahim runs your DUI and license-hearing searches with you and shows the first fix that would bring calls.
  </FinalCta>
</InnerPage>

<style is:global>
  .dui-fig { display: grid; gap: 12px; align-content: start; }

  /* The depth zone opens on a fog band (byline, summary, jump list), full bleed, then the sections on white. */
  .lse-depth[data-depth='seo-for-dui-attorneys'] > .lse-depth__part--first { padding-top: 0; }
  .lse-depth[data-depth='seo-for-dui-attorneys'] .lse-depth__intro {
    padding-block: clamp(56px, 6vw, 96px); border-top: 0;
    background: var(--fog); box-shadow: 0 0 0 100vmax var(--fog); clip-path: inset(0 -100vmax);
  }
  .lse-depth[data-depth='seo-for-dui-attorneys'] .lse-depth__intro + .lse-depth__sec { border-top: 0; }

  /* The shortcuts are things to avoid: the same hairline rows as a checklist, with a drawn cross for the check. */
  .lse-depth[data-depth='seo-for-dui-attorneys'] .lse-prose > ul.lse-check > li::before {
    left: 3px; top: calc(14px + .5lh - 9px); width: 18px; height: 18px; border: 0; transform: none;
    background:
      linear-gradient(45deg, transparent calc(50% - 1.5px), var(--ink) calc(50% - 1.5px), var(--ink) calc(50% + 1.5px), transparent calc(50% + 1.5px)),
      linear-gradient(-45deg, transparent calc(50% - 1.5px), var(--ink) calc(50% - 1.5px), var(--ink) calc(50% + 1.5px), transparent calc(50% + 1.5px));
  }
</style>
