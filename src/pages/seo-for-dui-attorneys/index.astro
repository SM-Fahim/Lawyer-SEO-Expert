---
// /seo-for-dui-attorneys/ from content/v2/seo-for-dui-attorneys.md. H1 across the top, then the new-profile
// calls chart on the fog panel (left) with the form beside it (right); one arrest, two searches as two
// columns with their proofs; which page owns which search; the price band; FAQ.
import Faq, { type FaqItem } from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import Band from '../../components/kit/Band.astro';
import HairTable from '../../components/kit/HairTable.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import Q from '../../components/kit/Q.astro';
import Related from '../../components/practice-a/Related.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';

const faq: FaqItem[] = [
  {
    q: 'Have you run SEO for a DUI firm?',
    html: 'The proof on this page is from PI firms. The Map and page work behind it is what a DUI firm needs too, and Fahim walks you through it for your county.',
  },
  {
    q: 'Should our pages say DUI, DWI or OWI?',
    html: 'The term your state uses, plus whatever people near you type. Often a page needs both.',
  },
  {
    q: 'Do we need a separate website for DUI?',
    html: 'Usually not. One site with its own DUI section is easier to rank and to keep up.',
  },
  {
    q: 'How soon will DUI pages bring calls?',
    html: 'It depends on your city and your site today. On your ranking review, Fahim gives you a realistic view for your county.',
  },
];
---
<InnerPage
  title="SEO for DUI Attorneys | Win the Near Me Search"
  description="SEO for DUI attorneys: be on the Map for “dui lawyer near me” and on Google for the license questions that follow an arrest. Book a ranking review."
  path="/seo-for-dui-attorneys/"
  crumbs={[{ label: 'SEO for DUI attorneys' }]}
  service={{ name: 'SEO for DUI attorneys' }}
  faq={faq}
>
  <PageHero
    layout="top"
    class="dui-hero"
    h1="SEO for DUI attorneys that wins the “near me” search after an arrest."
    lead="A DUI search is local and it is urgent. We get your firm onto the Map when a driver searches, and onto Google for the license questions that come next."
    form={{ title: 'Can a driver in your county find you?', sub: 'Fahim answers within an hour in business hours.', idPrefix: 'dui-hero', label: 'dui-hero', practiceArea: 'DUI' }}
  >
    <figure slot="visual" class="dui-fig">
      <Shot tag="9 calls" tagSide="right" priority images={[shot(proof.newProfileCalls, { marks: ['points'] })]} />
      <figcaption class="lse-small">For a PI firm in New Orleans: a new Google profile went from 1 call in July to 9 in October. A DUI firm’s Map listing is built the same way.</figcaption>
    </figure>
  </PageHero>

  <Band heading="One arrest, two searches." headingId="two-h">
    <div class="dui-two">
      <section class="dui-two__col" aria-labelledby="two-map-h">
        <h3 id="two-map-h">On the Map, right away</h3>
        <ul class="dui-two__qs">
          <li><Q text="dui lawyer near me" mark="near me" /></li>
          <li><Q text="dui attorney open now" mark="open now" /></li>
        </ul>
        <p class="dui-two__line">We keep your profile, hours and reviews ready, so you are a name they can call now.</p>
        <figure class="dui-fig">
          <Shot tag="139 calls" tagSide="right" images={[shot(proof.nolaCalls, { marks: ['total', 'growth'] })]} />
          <figcaption class="lse-small">For a PI firm in New Orleans: 139 calls from its Google profile in five months, up 39% on a year before.</figcaption>
        </figure>
      </section>
      <section class="dui-two__col" aria-labelledby="two-web-h">
        <h3 id="two-web-h">On Google, the days after</h3>
        <ul class="dui-two__qs">
          <li><Q text="should i get a lawyer for my first dui" /></li>
          <li><Q text="can my lawyer go to court for me for dui" /></li>
        </ul>
        <p class="dui-two__line">Each question gets a plain page for your state, checked by your attorneys. Google’s AI quotes pages like these.</p>
        <figure class="dui-fig">
          <Shot tag="Source #1" tagSide="right" images={[shot(proof.elpasoAiDeadline, { crop: 'answer', marks: ['citedLine', 'sourceCard'], alt: 'Google’s AI Overview for Texas El Paso car accident filing deadline, with an El Paso PI firm’s page as the first source card' })]} />
          <figcaption class="lse-small">For a PI firm in El Paso: Google’s AI answer cites its filing-deadline page first.</figcaption>
        </figure>
      </section>
    </div>
  </Band>

  <Band heading="DUI pages that never compete with your criminal pages." headingId="own-h" tone="fog" wideHeading>
    <div class="dui-table">
      <HairTable
        caption="Which page answers which search"
        head={['Search', 'The page that answers it']}
        rows={[
          [{ q: 'dui lawyer [city]' }, 'Your DUI page'],
          [{ q: 'criminal defense lawyer [city]' }, 'Your criminal defense page'],
          [{ q: 'should i get a lawyer for my first dui' }, 'First-offense page'],
          [{ q: '[state] license hearing after a dui' }, 'License page'],
        ]}
      />
      <p class="dui-table__line">One search, one page, so Google never has to choose between two of yours. More on <a href="/seo-for-criminal-defense-lawyers/">SEO for criminal defense lawyers</a>.</p>
    </div>
  </Band>

  <PriceBand
    heading="From $2,000 a month, nothing left out."
    headingId="price-h"
    lead="Your Map profile, DUI pages, links, site upkeep, call tracking and AI answer checks. No setup fee, month to month."
  >
    <Fragment slot="link">See <a href="/seo-pricing/">law firm SEO pricing</a></Fragment>
  </PriceBand>

  <Band heading="DUI questions for Fahim." headingId="faq-h">
    <Faq items={faq} />
    <Related
      links={[
        { label: 'SEO for personal injury lawyers', href: '/seo-for-personal-injury-lawyers/' },
        { label: 'law firm SEO services', href: '/law-firm-seo-services/' },
      ]}
    />
  </Band>

  <FinalCta heading="See who a driver finds in your county right now." formLabel="dui-final" idPrefix="dui-final" practiceArea="DUI">
    In 30 minutes, Fahim runs your DUI searches with you and shows the first fix that would bring calls.
  </FinalCta>
</InnerPage>

<style is:global>
  .dui-hero .lse-hero__h { max-width: 20ch; }
  .dui-fig { display: grid; gap: 12px; align-content: start; }

  /* Two searches: two columns with a hairline between them at 1000px and up. */
  .dui-two { display: grid; gap: 64px; }
  .dui-two__col { display: grid; gap: 20px; align-content: start; }
  .dui-two__col h3 { padding-bottom: 12px; border-bottom: 2px solid var(--ink); }
  .dui-two__qs { list-style: none; display: grid; gap: 6px; }
  .dui-two__qs li { font-size: clamp(20px, .6vw + 16px, 26px); font-weight: 700; letter-spacing: -.018em; line-height: 1.25; color: var(--ink); }
  .dui-two__line { color: var(--ink-2); max-width: 30em; }
  @media (min-width: 1000px) {
    .dui-two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; }
    .dui-two__col { padding-right: clamp(28px, 3vw, 48px); }
    .dui-two__col + .dui-two__col { padding: 0 0 0 clamp(28px, 3vw, 48px); border-left: 1px solid var(--line-2); }
  }

  .dui-table { max-width: 860px; }
  .dui-table__line { margin-top: var(--s4); color: var(--ink-2); max-width: 40em; }
  .dui-table__line a { font-weight: 600; }
</style>
