---
// /seo-for-employment-lawyers/ from content/v2/seo-for-employment-lawyers.md. Workers type what happened,
// employers type what to do next. Hero: H1 across, then the "what to do after" search over its #1 result,
// big on a fog block. No form in the hero: the calendar band follows (split, so it doesn't repeat the
// criminal and family bands). Two searchers, issue pages, the call with the price line under it (no price
// band on this page), FAQ.
import Faq, { type FaqItem } from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import Band from '../../components/kit/Band.astro';
import BookingBand from '../../components/kit/BookingBand.astro';
import NumPair from '../../components/kit/NumPair.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import SearchPanel from '../../components/kit/SearchPanel.astro';
import Split from '../../components/kit/Split.astro';
import Related from '../../components/practice-a/Related.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';

const faq: FaqItem[] = [
  {
    q: 'Have you done SEO for an employment firm?',
    html: 'So far our proven results are for injury firms in two cities. Question pages, the Map and Google’s AI answers behave the same way for employment searches.',
  },
  {
    q: 'Should plaintiff and employer work be on two websites?',
    html: 'Usually one site with two clear sections is enough, and easier to keep up. Your attorneys decide if the two sides need separate brands.',
  },
  {
    q: 'Can you rank for “do I have a case” searches?',
    html: 'They are questions, so a clear page can rank and be quoted by Google’s AI. We write them to help readers decide, never to promise an outcome.',
  },
  {
    q: 'Who does the work?',
    html: 'Fahim plans your pages, is on every call and checks the work before it goes out. A small team helps produce it, and you never deal with an account manager.',
  },
];

// The title line of the ranked result, measured on nola-wtd-rank.webp (900x162).
const wtdTitle = [{ l: 1.9, t: 39.5, w: 48.8, h: 19.5 }];
---
<InnerPage
  title="SEO for Employment Lawyers | Rank for What Workers Ask"
  description="SEO for employment lawyers: pages that answer what fired, unpaid and harassed workers ask, ranked on Google and quoted by its AI. Book a ranking review."
  path="/seo-for-employment-lawyers/"
  crumbs={[{ label: 'SEO for employment lawyers' }]}
  service={{ name: 'SEO for employment lawyers' }}
  faq={faq}
>
  <PageHero
    layout="stack"
    class="emp-hero"
    h1="Employment lawyer SEO that answers the question before they call."
    lead="A fired worker types what happened. An HR director types what to do next. We write the pages Google ranks first and its AI quotes, for the side you represent."
  >
    <figure slot="visual" class="emp-fig">
      <Shot tag="#1" tagSide="right" priority images={[shot(proof.nolaWtdQuery), shot(proof.nolaWtdRank, { marks: wtdTitle, alt: 'A New Orleans PI firm’s page, What to Do After a Truck Accident, as the first result on Google' })]} />
      <figcaption class="lse-small">For a PI firm in New Orleans: its “what to do after” page, #1 on Google. A worker’s “what do I do now” question is the same kind of search.</figcaption>
    </figure>
  </PageHero>

  <BookingBand
    heading="Start with a free ranking review."
    headingId="book-h"
    tone="fog"
    layout="split"
    lead="30 minutes with Fahim. Tell him which side you represent, and he searches it with you."
  />

  <Band heading="Workers and employers never type the same words." headingId="sides-h" wideHeading>
    <SearchPanel
      columns={[
        {
          heading: 'Workers',
          queries: [
            { text: 'what type of lawyer do i need for wrongful termination', mark: 'what type of lawyer' },
            { text: 'what kind of lawyer do i need for unpaid wages', mark: 'what kind of lawyer' },
            { text: 'should i tell hr i’m getting a lawyer' },
          ],
        },
        {
          heading: 'Employers',
          queries: [],
          placeholder: 'employer-side searches from a client’s market; our keyword files hold very few',
        },
      ]}
    />
    <p class="emp-under">Each side gets its own section, wording and way to get in touch. If you serve one side only, the other section doesn’t exist.</p>
  </Band>

  <Band heading="Pages named for what happened at work." headingId="issues-h" tone="fog">
    <div class="emp-issues">
      <Rows
        variant="inline"
        items={[
          { title: 'Fired.', text: 'Wrongful termination, in the worker’s words.' },
          { title: 'Not paid.', text: 'Unpaid wages and overtime.' },
          { title: 'Harassed or pushed out.', text: 'What counts, and what to do first.' },
          { title: 'For employers.', text: 'Policies, investigations and terminations, if you take that side.' },
        ]}
      />
      <p class="emp-under">Each page says which cases you take and which you don’t, so your intake gets fewer dead ends.</p>
    </div>
  </Band>

  <Band heading="Then the call comes from Google." headingId="call-h">
    <Split ratio="7/5" align="center">
      <Shot slot="a" tag="139 calls" tagSide="right" images={[shot(proof.nolaCalls, { marks: ['total', 'growth'] })]} />
      <div slot="b" class="emp-num">
        <NumPair after={139} afterLabel="calls" />
        <p>For a PI firm in New Orleans: 139 calls in five months from its Google profile, by Google’s own count.</p>
      </div>
    </Split>
    <div class="emp-price">
      <p class="emp-price__line">All of it <span class="lse-mk">from $2,000 a month</span>: pages, your Google profile, links, site upkeep, call tracking and AI answer checks. No setup fee.</p>
      <p class="emp-price__link"><a href="/seo-pricing/">See law firm SEO pricing</a></p>
    </div>
  </Band>

  <Band heading="Employment law SEO in four answers." headingId="faq-h" tone="fog">
    <Faq items={faq} />
    <Related
      links={[
        { label: 'SEO for immigration lawyers', href: '/seo-for-immigration-lawyers/' },
        { label: 'SEO for personal injury lawyers', href: '/seo-for-personal-injury-lawyers/' },
        { label: 'law firm SEO services', href: '/law-firm-seo-services/' },
      ]}
    />
  </Band>

  <FinalCta heading="Check your issue searches with Fahim." formLabel="emp-final" idPrefix="emp-final" practiceArea="Employment">
    In 30 minutes, Fahim searches the issues you want more of, for workers or employers, and shows what to fix first.
  </FinalCta>
</InnerPage>

<style is:global>
  .emp-hero .lse-hero__h { max-width: 19ch; }
  .emp-hero .lse-hero__lead { max-width: 38em; }
  .emp-fig { display: grid; gap: 14px; justify-items: center; }
  .emp-fig .lse-shot { width: 100%; }
  .emp-fig figcaption { max-width: 44em; justify-self: center; text-align: left; width: 100%; max-width: 978px; }
  .emp-under { margin-top: var(--s4); color: var(--ink-2); max-width: 40em; }
  .emp-issues { max-width: 860px; }
  .emp-num { display: grid; gap: 22px; }
  .emp-num p { color: var(--ink-2); max-width: 22em; }
  .emp-price { margin-top: clamp(48px, 6vw, 80px); padding-top: var(--s4); border-top: 2px solid var(--ink); }
  .emp-price__line { font-size: clamp(26px, 1.6vw + 16px, 40px); font-weight: 800; letter-spacing: -.03em; line-height: 1.12; color: var(--ink); max-width: 26ch; }
  .emp-price__link { margin-top: var(--s3); font-size: 17px; }
  .emp-price__link a { font-weight: 700; }
</style>
