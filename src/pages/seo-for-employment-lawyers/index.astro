---
// /seo-for-employment-lawyers/. Copy: content/v3/seo-for-employment-lawyers.md (critic: content/v3/CRITIC-practice-2.md).
// Facts: research/FACTS.md. The hero is the row hero (PageHero layout="row"): H1 and line across, the form card,
// Google's AI answer naming a New Orleans PI firm as a key firm (proof.nolaTankerAi) on the fog panel on the
// right, with a one-line caption. The v2 bands, FAQ and Related block gave way to
// the depth zone (src/content/depth/seo-for-employment-lawyers.md): an intro with the summary across and the jump
// list in two columns, the worker searches on a fog panel, the issue and deadline tables, the employer pages as
// rows, a mid-page CTA in a fog block, the price as a fog band (no PriceBand on this page), then the open FAQ on
// white, the author box and FinalCta.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import SearchBox from '../../components/kit/SearchBox.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-employment-lawyers/';
const title = 'SEO for Employment Lawyers | Rank for What Workers Ask';
const description =
  'SEO for employment lawyers: worker and employer searches, issue pages, filing deadlines, settlements and reviews, state pages and the Map.';
const depth = await getDepth('seo-for-employment-lawyers');

// The hero capture from "AI Overview" down to the key firm's rating and practice line (the faded "Open" line and
// "Show more" cut), so it keeps to the form card's height. % of the image's height.
const empCrop = { top: 0, height: 77 };

// "What do employer-side pages need that worker pages don't?": one template per row, the key noun first.
const employerPages = [
  { title: 'Dismissal process:', text: 'the steps to take before a termination.' },
  { title: 'Charge response:', text: 'what an EEOC notice means and what comes next.' },
  { title: 'Handbook reviews:', text: 'what gets checked, and how often.' },
  { title: 'Investigations:', text: 'who runs them and what the report covers.' },
  { title: 'Law change updates:', text: 'one dated page per change, such as Britain’s tribunal limit.' },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for employment lawyers' }]}
  service={{ name: 'SEO for employment lawyers' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    class="emp-hero"
    h1="Employment lawyer SEO that answers the question before they call."
    lead="We write the pages Google ranks first and its AI quotes, for the side you represent."
    form={{ who: 'your employment practice', idPrefix: 'emp-hero', label: 'emp-hero', practiceArea: 'Employment' }}
  >
    <figure slot="visual" class="emp-fig">
      <Shot tag="Named by AI" tagSide="right" priority images={[shot(proof.nolaTankerAi, { crop: empCrop, marks: ['name', 'rating'] })]} />
      <figcaption>A PI firm in New Orleans, named in Google’s AI answer on tanker accidents.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} faqTone="white" authorLinkLabel="S. M. Fahim’s background">
    <div slot="searches" class="emp-searches">
      <SearchBox
        label="Searches workers make about a problem at work"
        caption="From our keyword research."
        queries={[
          { text: 'what type of lawyer do i need for wrongful termination', mark: 'what type of lawyer' },
          { text: 'what kind of lawyer do i need for unpaid wages', mark: 'what kind of lawyer' },
          { text: 'should i tell hr i’m getting a lawyer' },
        ]}
      />
    </div>
    <div slot="employers" class="emp-rows"><Rows variant="inline" items={employerPages} /></div>

    <Band slot="mid" class="emp-mid">
      <div class="emp-mid__block">
        <p class="emp-mid__line">Find out which employment deadlines your firm ranks for today.</p>
        <Button />
      </div>
    </Band>

    <Band slot="price" tone="fog" class="emp-price">
      <p class="emp-price__line">For an employment practice, our SEO is <span class="lse-mk">from $2,000 a month</span>. There is no setup fee.</p>
      <p class="emp-price__more">You get the monthly figure from Fahim in writing before work begins. See <a href="/seo-pricing/">law firm SEO pricing</a>.</p>
    </Band>
  </DepthZone>

  <FinalCta heading="How many worker or employer calls could your employment practice add, and at what monthly cost?" writeHref="#emp-hero-form">
    In 30 minutes, Fahim searches the issues you want more of, for workers or employers, and shows what to fix first.
  </FinalCta>
</InnerPage>

<style is:global>
  /* Hero: the AI answer on the fog panel, its one-line caption under it. */
  .emp-fig { display: grid; gap: 12px; margin: 0; }

  /* Depth intro: the summary across the column, the jump list under it in two columns. */
  .lse-depth[data-depth='seo-for-employment-lawyers'] .lse-depth__intro { grid-template-columns: minmax(0, 1fr); }
  .lse-depth[data-depth='seo-for-employment-lawyers'] .lse-depth__summary { max-width: 38em; }
  .lse-depth[data-depth='seo-for-employment-lawyers'] .lse-jump { max-width: none; border-top: 1px solid var(--line-2); }
  .lse-depth[data-depth='seo-for-employment-lawyers'] .lse-jump__h { padding-top: 14px; }
  @media (min-width: 1000px) {
    .lse-depth[data-depth='seo-for-employment-lawyers'] .lse-jump ol { display: grid; grid-auto-flow: column; grid-template-rows: repeat(5, auto); grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(40px, 5vw, 80px); }
  }

  /* The worker searches on a rounded fog panel, as in the hero. */
  .emp-searches { max-width: 820px; padding: clamp(16px, 2.5vw, 32px); background: var(--fog); border-radius: 28px; }
  .emp-searches .lse-small { padding-left: 4px; }
  @media (max-width: 759px) {
    .emp-searches { margin-inline: calc(-1 * var(--gut)); padding-inline: var(--gut); border-radius: 0; }
  }

  /* The employer pages: inline rows at the text's size and measure. */
  .emp-rows { max-width: 35em; font-size: clamp(17px, .25vw + 16px, 19px); line-height: 1.6; }
  .emp-rows .lse-row { padding: 14px 0 15px; }
  .emp-rows .lse-row p { max-width: none; color: var(--ink-2); }
  .emp-rows .lse-row b { color: var(--ink); }
  .lse-depth__slot:has(> .emp-rows) { margin-top: 20px; }
  .lse-depth__slot:has(> .emp-rows) + .lse-prose { margin-top: 28px; }

  /* Mid-page CTA: a rounded fog block on white, the line and the button side by side from 1000px. */
  /* The fog block is the band's body, so Fahim's face (put first in the body by DepthZone) sits inside it. */
  .lse-depth .emp-mid { padding-block: 0; }
  .lse-depth .emp-mid .lse-band__body { padding: clamp(32px, 4vw, 56px) clamp(24px, 4vw, 56px); background: var(--fog); border-radius: 28px; }
  .emp-mid__block { display: grid; gap: var(--s4); justify-items: start; }
  .emp-mid__line { max-width: 22em; font-size: clamp(24px, 1.2vw + 17px, 36px); font-weight: 750; line-height: 1.15; letter-spacing: -.022em; color: var(--ink); }
  @media (min-width: 1000px) {
    .emp-mid__block { grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 64px; }
  }

  /* The price: a fog band, the line set large and the details under it. No button. */
  .emp-price .lse-band__body { display: grid; gap: var(--s3); }
  .emp-price__line { max-width: 24em; font-size: clamp(24px, 1vw + 18px, 32px); font-weight: 750; line-height: 1.2; letter-spacing: -.02em; color: var(--ink); }
  .emp-price__more { max-width: 36em; color: var(--ink-2); }
  .emp-price__more a { font-weight: 700; }
</style>
