---
// /seo-for-environmental-law-attorneys/ from content/v3/seo-for-environmental-law-attorneys.md (critic:
// content/v3/CRITIC-mixed.md). The commercial top is the v2 build: the H1 and line across, then the New Orleans calls
// chart led by "Up 39%" on the fog panel beside the short form. The v2 bands after it gave way to the depth zone
// (src/content/depth/). Its own look on this page: the jump list first and narrow, the summary beside it; the
// notices and deadlines section (the unique asset) as a fog band in the middle of the white text; the price as two
// lines on fog (no PriceBand); the open FAQ on white with each question beside its answer. No mid-page CTA (R8).
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import '../../components/mixed/mixed.css';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-environmental-law-attorneys/';
const title = 'SEO for Environmental Law Attorneys | Niche B2B Search';
const description =
  'SEO for environmental law attorneys: a demand check, pages for EPA notices and deadlines, dated rule-change pages, name search, AI answers and reach.';
const depth = await getDepth('seo-for-environmental-law-attorneys');
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for environmental law attorneys' }]}
  service={{ name: 'SEO for environmental law attorneys', offer: false }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="top"
    h1="SEO for environmental law attorneys: win the few searches that matter."
    lead="Companies, towns and landowners search for help with permits, compliance and contamination. These searches are few, and each one can be a large matter. We find the ones that exist for your issues and make your firm the answer."
    form={{ title: 'Send your website for a demand check.', sub: 'Fahim answers within an hour in business hours.', idPrefix: 'env-hero', label: 'environmental-hero', practiceArea: 'Environmental law' }}
    talk="Prefer a call?"
    class="env-hero"
  >
    <figure slot="visual" class="env-hero__fig">
      <div class="env-hero__shot">
        <Shot tag="Up 39%" tagSide="right" priority images={[shot(proof.nolaCallsSummary, { marks: ['range', 'growth'] }), shot(proof.nolaCalls, { crop: 'chart', alt: 'The same chart’s line of monthly calls, June to October 2026' })]} />
      </div>
      <figcaption>
        <span class="env-hero__cap">For a PI firm in New Orleans: calls from its Business Profile rose 39% on the year before, June to October 2026, by Google’s count.</span>
        <span class="env-hero__line">Environmental searches are rarer, so each call matters more. The same work puts your firm where those searches land.</span>
      </figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} faqTone="white" authorLinkLabel="About S. M. Fahim">
    <Band slot="price" tone="fog" class="env-price">
      <p class="env-price__big">Environmental law SEO is priced from $2,000 a month, and there’s no fee to set it up.</p>
      <p class="env-price__line">Fahim sets out the monthly fee in writing first, before any work. See <a href="/seo-pricing/">law firm SEO pricing</a>.</p>
    </Band>
  </DepthZone>

  <FinalCta heading="Find out which environmental issues your firm could own in search." formLabel="environmental-final" idPrefix="env-final" practiceArea="Environmental law">
    <p>In 30 minutes, Fahim checks your issues for real search demand and looks up your firm’s name the way a general counsel would.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  .env-hero__fig { display: grid; gap: 18px; }
  /* Never wider than the summary crop's own 680px, so neither part is upscaled. */
  .env-hero__shot { max-width: 682px; }
  .env-hero__fig figcaption { display: grid; gap: 10px; max-width: 38em; }
  .env-hero__cap { font-size: 17px; line-height: 1.45; color: var(--ink-2); }
  .env-hero__line { font-size: var(--fs-lead); line-height: 1.4; font-weight: 600; color: var(--ink); letter-spacing: -.01em; }

  /* The depth zone opens with the jump list first and narrow, the byline and summary beside it (phones: the summary
     first, as everywhere). */
  @media (min-width: 1000px) {
    .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__intro { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__toc { order: -1; }
  }

  /* The notices and deadlines section, the page's unique asset, as a fog band across the page. */
  .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__sec:has(> .lse-prose > h2#which-notices-and-deadlines-start-an-environmental-clients-search) {
    padding-block: clamp(56px, 6vw, 96px); border-top: 0;
    background: var(--fog); box-shadow: 0 0 0 100vmax var(--fog); clip-path: inset(0 -100vmax);
  }
  .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__sec:has(> .lse-prose > h2#which-notices-and-deadlines-start-an-environmental-clients-search) + .lse-depth__sec { border-top: 0; }

  /* The price: two lines on fog, the first set large. No button, no H2 (no PriceBand on this page). */
  .env-price .lse-band__body { display: grid; gap: var(--s3); }
  .env-price__big {
    max-width: 20em; font-size: clamp(28px, 1.6vw + 18px, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -.032em;
    color: var(--ink);
  }
  .env-price__line { max-width: 36em; font-size: var(--fs-lead); line-height: 1.5; color: var(--ink-2); }
  .env-price__line a { font-weight: 700; color: var(--ink); }

  /* The open FAQ on white: each question beside its answer from 1000px, on hairline rows. */
  @media (min-width: 1000px) {
    .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__faq .lse-faq--open { max-width: none; }
    .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__faq .lse-faq__item {
      display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(48px, 5vw, 80px); align-items: baseline;
    }
    .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__faq .lse-faq--open .lse-faq__a { padding-top: 0; max-width: 36em; }
  }
</style>
