---
// /seo-for-environmental-law-attorneys/. The hero is the row hero (PageHero layout="row"): the H1 and line across,
// then the form card and the New Orleans calls summary led by "Up 39%" on the fog panel. The depth zone
// (src/content/depth/, v4: written from our own practice) follows. Its own look on this page: the jump list first and
// narrow, the summary beside it; the pages section (notices, deadlines and rule stages, the page's unique asset) as a
// fog band in the middle of the white text; the tanker AI answer as the proof; the price as two lines on fog (no
// PriceBand); then the accordion FAQ on white. No mid-page CTA.
import FinalCta from '../../components/FinalCta.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Shot from '../../components/Shot.astro';
import '../../components/mixed/mixed.css';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-environmental-law-attorneys/';
const title = 'SEO for Environmental Law Attorneys | Niche B2B Search';
const description =
  'SEO for environmental law attorneys from our own practice: a demand check, pages for EPA notices and rule stages, AI answers, the name search and cost.';
const depth = await getDepth('seo-for-environmental-law-attorneys');
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for environmental law attorneys' }]}
  service={{ name: 'SEO for environmental law attorneys', offer: false }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    h1="SEO for environmental law attorneys: win the few searches that matter."
    lead="Companies, towns and landowners search for help with permits, compliance and contamination. We find the ones that exist for your issues and make your firm the answer."
    form={{ who: 'your environmental law firm', idPrefix: 'env-hero', label: 'environmental-hero', practiceArea: 'Environmental law' }}
    class="env-hero"
  >
    <figure slot="visual" class="env-hero__fig">
      <Shot tag="Up 39%" tagSide="right" priority images={[shot(proof.nolaCallsSummary, { marks: ['range', 'growth'], phone: false })]} />
      <figcaption>A PI firm in New Orleans: calls up 39% on the year before, by Google’s count.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} faqTone="white" authorLinkLabel="About S. M. Fahim">
    <figure slot="proof" class="lse-depth__proof">
      <Shot tag="Cited" tagSide="right" images={[shot(proof.nolaTankerSerpAnswer, { crop: 'answer', marks: ['aiChip'] }), shot(proof.nolaTankerSerpSource, { crop: 'firm', marks: ['sourceCard'] })]} />
      <figcaption>A New Orleans tanker crash search: the AI answer cites a PI firm, and the firm’s page sits among its sources.</figcaption>
    </figure>
    <Band slot="price" tone="fog" class="env-price">
      <p class="env-price__big">Environmental law SEO is priced from $2,000 a month, and there’s no fee to set it up.</p>
      <p class="env-price__line">Fahim sets out the monthly fee in writing first, before any work. See <a href="/seo-pricing/">law firm SEO pricing</a>.</p>
    </Band>
  </DepthZone>

  <FinalCta heading="Price the general counsel inquiries your environmental practice could win." writeHref="#env-hero-form">
    <p>In 30 minutes, Fahim checks your issues for real search demand and looks up your firm’s name the way a general counsel would.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  .env-hero__fig { display: grid; gap: 12px; margin: 0; }

  /* The depth zone opens with the jump list first and narrow, the byline and summary beside it (phones: the summary
     first, as everywhere). */
  @media (min-width: 1000px) {
    .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__intro { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__toc { order: -1; }
  }

  /* The pages section (notices, deadlines and rule stages), the page's unique asset, as a fog band across the page. */
  .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__sec:has(> .lse-prose > h2#pages-built-around-notices-deadlines-and-rule-changes) {
    padding-block: clamp(56px, 6vw, 96px); border-top: 0;
    background: var(--fog); box-shadow: 0 0 0 100vmax var(--fog); clip-path: inset(0 -100vmax);
  }
  .lse-depth[data-depth='seo-for-environmental-law-attorneys'] .lse-depth__sec:has(> .lse-prose > h2#pages-built-around-notices-deadlines-and-rule-changes) + .lse-depth__sec { border-top: 0; }

  /* The price: two lines on fog, the first set large. No button, no H2 (no PriceBand on this page). */
  .env-price .lse-band__body { display: grid; gap: var(--s3); }
  .env-price__big {
    max-width: 20em; font-size: clamp(28px, 1.6vw + 18px, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -.032em;
    color: var(--ink);
  }
  .env-price__line { max-width: 36em; font-size: var(--fs-lead); line-height: 1.5; color: var(--ink-2); }
  .env-price__line a { font-weight: 700; color: var(--ink); }
</style>
