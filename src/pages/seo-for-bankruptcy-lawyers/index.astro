---
// /seo-for-bankruptcy-lawyers/. Facts: research/FACTS.md. The hero is the row hero (PageHero layout="row"): the H1
// across, then the form card and the calls chart cropped to the September point on the fog panel; the urgent
// searches follow on fog. The depth zone (src/content/depth/seo-for-bankruptcy-lawyers.md, v4: written from our own
// practice) follows. Its own look on this page: the jump list with big ink numerals, the El Paso 9 to 23 pair and
// after chart beside the Map section, the built marker PriceBand, then the accordion FAQ (fog).
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import NumPair from '../../components/kit/NumPair.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import QueryRows from '../../components/practice-b/QueryRows.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-bankruptcy-lawyers/';
const title = 'SEO for Bankruptcy Lawyers | Get the Local Call';
const description =
  'SEO for bankruptcy lawyers: a page for each debt problem, a Google profile that takes the urgent call, district pages, and claims your counsel has cleared.';
const depth = await getDepth('seo-for-bankruptcy-lawyers');
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for bankruptcy lawyers' }]}
  service={{ name: 'SEO for bankruptcy lawyers', offer: false }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    h1="SEO for bankruptcy lawyers, built to win the local call."
    lead="Someone facing a garnishment searches for a lawyer nearby. We put your firm where that search lands: on the Map, in the results and in Google’s AI answers."
    form={{ who: 'your bankruptcy practice', idPrefix: 'bk-top', label: 'bankruptcy-top', practiceArea: 'Bankruptcy' }}
    class="bk-hero"
  >
    <figure slot="visual" class="bk-hero__fig">
      <Shot tag="43 calls" tagSide="left" priority images={[shot(proof.nolaCallsMaySepChart, { phone: 'augSep' })]} />
      <figcaption>September 2026: 43 calls from one New Orleans PI firm’s Business Profile.</figcaption>
    </figure>
  </PageHero>

  <Band heading="The searches that come before a bankruptcy call." headingId="bk-searches-h" lead="Urgent bankruptcy searches end the same way, with a tap on the call button." tone="fog" wideHeading>
    <div class="bk-searches">
      <QueryRows
        label="Searches people type before a bankruptcy call"
        caption="Each one a real search, from our keyword data."
        queries={[
          { text: 'best bankruptcy attorney near me', mark: 'near me' },
          { text: 'can a lawyer stop a garnishment', mark: 'stop' },
          { text: 'how much does a lawyer charge for chapter 7' },
          { text: 'can i file chapter 7 without a lawyer' },
          { text: 'do i need a lawyer for debt collection' },
        ]}
      />
    </div>
  </Band>

  <DepthZone depth={depth} authorLinkLabel="About S. M. Fahim">
    <figure slot="proof" class="lse-depth__proof">
      <NumPair before={9} after={23} beforeLabel="profile calls, Aug 2025 to Jan 2026" afterLabel="profile calls, May to Jul 2026" />
      <Shot images={[shot(proof.elpasoCallsAfter, { marks: ['total', 'range'], phone: 'totalRange' })]} />
      <figcaption>A PI firm in El Paso, by Google’s count: 9 profile calls from August 2025 to January 2026, and 23 from May to July 2026.</figcaption>
    </figure>

    <PriceBand slot="price" variant="plain" heading="The Map, the pages and the calls, in one price." headingId="bk-price-h" class="bk-price">
      <p class="bk-price__lead">One fee, <a href="/seo-pricing/">from $2,000 a month</a>, buys everything ranking takes: the profile and reviews, the pages, upkeep of the site, links, tracking for every call and form, and a monthly look at AI answers.</p>
      <p class="bk-price__terms">There is no setup fee and no minimum term, and the number comes in writing before any work.</p>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="Put a number on more Chapter 7 and Chapter 13 calls, district by district." writeHref="#bk-top-form">
    <p>In 30 minutes, Fahim runs your Chapter 7 and Chapter 13 searches for each district with you and shows who takes those calls today.</p>
  </FinalCta>
</InnerPage>

<style>
  /* Hero: the chart with its tag on the fog panel, beside the form; a one-line caption. */
  .bk-hero__fig { display: grid; gap: 12px; margin: 0; }
  /* The searches under the hero, at a readable width. */
  .bk-searches { max-width: 760px; }

  :global(.bk-price .lse-price__more) { display: grid; gap: 18px; }
  .bk-price__lead { font-size: clamp(24px, 1.4vw + 16px, 36px); font-weight: 700; line-height: 1.2; letter-spacing: -.025em; color: var(--ink); max-width: 24em; }
  .bk-price__lead a { font-weight: 900; background: var(--paper); padding: 0 .12em; margin: 0 -.04em; text-decoration-thickness: 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .bk-price__terms { padding-top: 16px; border-top: 2px solid var(--ink); font-size: clamp(19px, .5vw + 16px, 23px); font-weight: 700; color: var(--ink); max-width: 30em; }
</style>

<style is:global>
  /* The depth zone on this page. The jump list counts its sections in big ink numerals. */
  .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-jump li { grid-template-columns: 2.4em minmax(0, 1fr); align-items: baseline; }
  .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-jump li::before {
    padding-top: 9px; font-size: 26px; font-weight: 900; line-height: 1; letter-spacing: -.04em; color: var(--ink);
  }

  /* A plain bullet list in the copy: hairline rows, each bold lead on its own line at a small heading size. The v4
     copy has no bullet list, so these match nothing today. */
  .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-prose > ul:not(.lse-check) { list-style: none; padding: 0; border-top: 2px solid var(--ink); }
  .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-prose > ul:not(.lse-check) > li { margin: 0; padding: 16px 0 18px; border-bottom: 1px solid var(--line-2); }
  .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-prose > ul:not(.lse-check) > li > strong:first-child {
    display: block; margin-bottom: 4px; font-size: clamp(19px, .4vw + 16px, 22px); font-weight: 750; line-height: 1.25; letter-spacing: -.012em; color: var(--ink);
  }

  /* An open FAQ (front matter faqStyle: open) sets each question beside its answer from 1000px. The v4 copy uses
     the accordion, so these match nothing today. */
  @media (min-width: 1000px) {
    .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-depth__faq .lse-faq--open { max-width: none; }
    .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-depth__faq .lse-faq__item {
      display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(40px, 5vw, 80px); align-items: baseline;
    }
    .lse-depth[data-depth='seo-for-bankruptcy-lawyers'] .lse-depth__faq .lse-faq--open .lse-faq__a { padding-top: 0; }
  }
</style>
