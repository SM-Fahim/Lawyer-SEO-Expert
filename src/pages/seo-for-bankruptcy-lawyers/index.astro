---
// /seo-for-bankruptcy-lawyers/ from content/v2/seo-for-bankruptcy-lawyers.md (practice set B).
// Hero: number-led on white. H1 and line, then a giant marked "43" beside the calls chart cropped to the
// September point (a real rectangle crop of LCME's calls-rudin.webp, src/data/proof.ts). No form in the hero:
// section 1 straight after it puts the urgent searches beside the form. Then Map or page, the price band
// (the page's one marker band), FAQ, close.
import Faq, { type FaqItem } from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import LeadForm from '../../components/LeadForm.astro';
import Shot from '../../components/Shot.astro';
import Band from '../../components/kit/Band.astro';
import NumPair from '../../components/kit/NumPair.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import Rows from '../../components/kit/Rows.astro';
import Split from '../../components/kit/Split.astro';
import QueryRows from '../../components/practice-b/QueryRows.astro';
import Related from '../../components/practice-b/Related.astro';
import { proof, shot } from '../../data/proof';
import { site } from '../../data/site';
import InnerPage from '../../layouts/InnerPage.astro';

const faq: FaqItem[] = [
  {
    q: 'Is SEO worth it for a flat-fee practice?',
    html: 'Only if the qualified leads it brings cover the cost with room to spare. Bring your average fee for each chapter to the review, and Fahim works through the numbers with you.',
  },
  {
    q: 'Should we publish our fees?',
    html: 'If you can, yes. Cost is among the first things people search, and a clear fee page saves your staff calls from people who are not ready yet.',
  },
  {
    q: 'How do reviews work when clients want privacy?',
    html: 'The routine asks every client the same way and accepts first names. Replies never mention anyone’s case or debts.',
  },
  {
    q: 'Do the pages carry the statements our rules require?',
    html: 'Your attorneys decide which statements your rules require, and approve every page before it goes live. We keep that wording on every page that needs it.',
  },
  {
    q: 'How soon will calls pick up?',
    html: 'That depends on how crowded your city is and how your profile and site look today. Fahim checks both with you in the review and gives you an honest answer.',
  },
];
---
<InnerPage
  title="SEO for Bankruptcy Lawyers | Get the Local Call"
  description="SEO for bankruptcy lawyers: get on the Map and the first results when people nearby search for debt help, and turn those searches into calls."
  path="/seo-for-bankruptcy-lawyers/"
  crumbs={[{ label: 'SEO for bankruptcy lawyers' }]}
  service={{ name: 'SEO for bankruptcy lawyers', offer: false }}
  faq={faq}
>
  <PageHero
    layout="stack"
    panel={false}
    h1="SEO for bankruptcy lawyers, built to win the local call."
    lead="Someone facing a garnishment searches for a lawyer nearby and calls one of the first few they see. We put your firm there: on the Map, in the results and in Google’s AI answers."
    class="bk-hero"
  >
    <div slot="visual" class="bk-hero__vis">
      <div class="bk-hero__num">
        <NumPair after={43} afterLabel="calls in one month" size="xl" />
      </div>
      <figure class="bk-hero__fig">
        <div class="bk-hero__wide"><Shot tag="43 calls" tagSide="left" priority images={[shot(proof.nolaCallsMaySepChart)]} /></div>
        <div class="bk-hero__phone"><Shot tag="43 calls" tagSide="left" images={[shot(proof.nolaCallsAugSepChart)]} /></div>
        <figcaption>
          <span class="bk-hero__cap">For a PI firm in New Orleans. Google counted 43 calls from its Business Profile in September 2026.</span>
          <span class="bk-hero__line">Urgent bankruptcy searches end the same way, with a tap on the call button.</span>
        </figcaption>
      </figure>
    </div>
  </PageHero>

  <Band heading="The searches that come before a bankruptcy call." headingId="bk-searches-h" tone="fog" wideHeading>
    <Split ratio="7/5">
      <QueryRows
        slot="a"
        label="Searches people type before a bankruptcy call"
        caption="Each one a real search, from our keyword data."
        queries={[
          { text: 'best bankruptcy attorney near me', mark: 'near me' },
          { text: 'can a lawyer stop a garnishment', mark: 'stop' },
          { text: 'how much does a lawyer charge for chapter 7' },
          { text: 'can i file chapter 7 without a lawyer' },
          { text: 'do i need a lawyer for debt collection' },
        ]}
      />
      <div slot="b" class="bk-act">
        <LeadForm compact title="Where does your firm show up for these?" titleTag="h3" sub="Send your website. Fahim answers within an hour in business hours." idPrefix="bk-top" label="bankruptcy-top" format="Ranking review by email" practiceArea="Bankruptcy">
          <Fragment slot="privacy">We use your details to reply and to measure our ads. <a href="/privacy-policy/">Privacy policy</a>.</Fragment>
        </LeadForm>
        <p class="bk-act__talk">Prefer a call? <a href={site.cta.href} data-cal>{site.cta.label}</a></p>
      </div>
    </Split>
  </Band>

  <Band heading="Which search goes to the Map, and which to a page." headingId="bk-where-h">
    <div class="bk-where">
      <Rows
        variant="big"
        items={[
          { title: 'The Map', text: '“Near me” and “bankruptcy lawyer” plus your city. Your Google Business Profile, your reviews and the call button win these.' },
          { title: 'Your pages', text: 'Problem questions like a garnishment or a debt collector. One page for each, with your fee for Chapter 7 and Chapter 13 in plain view if you publish it.' },
          { title: 'Google’s AI answers', text: 'The same problem pages, written so Google’s AI can quote them.' },
        ]}
      />
    </div>
  </Band>

  <PriceBand variant="plain" heading="The Map, the pages and the calls, in one price." headingId="bk-price-h" class="bk-price">
    <p class="bk-price__lead"><a href="/seo-pricing/">From $2,000 a month</a> covers everything it takes to rank: your profile and reviews, the pages, site upkeep, links, call and form tracking, and AI answer checks.</p>
    <p class="bk-price__terms">No setup fee, no lock-in, and Fahim gives you the number in writing first.</p>
  </PriceBand>

  <Band heading="Bankruptcy SEO, asked and answered." headingId="bk-faq-h">
    <Faq items={faq} />
  </Band>

  <FinalCta heading="See who gets the call in your city today." formLabel="bankruptcy-final" idPrefix="bk-final" practiceArea="Bankruptcy">
    <p>In 30 minutes, Fahim runs the local bankruptcy searches for your city with you and shows which firms take the calls now, and what would move you up first.</p>
  </FinalCta>
  <Related links={[{ label: 'SEO for family lawyers', href: '/seo-for-family-lawyers/' }, { label: 'SEO for estate planning lawyers', href: '/seo-for-estate-planning-lawyers/' }]} />
</InnerPage>

<style>
  /* Hero: the number on the left, the chart on the right, both on white. */
  .bk-hero__vis { display: grid; gap: 36px; align-items: center; }
  .bk-hero__fig { display: grid; gap: 16px; }
  .bk-hero__fig figcaption { display: grid; gap: 8px; max-width: 40em; }
  .bk-hero__cap { font-size: 17px; line-height: 1.45; color: var(--ink-2); }
  .bk-hero__line { font-size: var(--fs-lead); line-height: 1.4; font-weight: 600; color: var(--ink); letter-spacing: -.01em; }
  .bk-hero__fig :global(.lse-shot__frame) { box-shadow: var(--shadow-lift); }
  /* Phones get the August to September crop, so the 43 label stays readable. */
  .bk-hero__wide { display: none; }
  @media (min-width: 640px) {
    .bk-hero__wide { display: block; }
    .bk-hero__phone { display: none; }
  }
  @media (min-width: 1000px) {
    .bk-hero__vis { grid-template-columns: auto minmax(0, 1fr); column-gap: clamp(48px, 5vw, 80px); margin-top: 8px; padding-top: clamp(32px, 3vw, 48px); border-top: 2px solid var(--ink); }
  }

  .bk-act { display: grid; gap: 14px; align-content: start; }
  .bk-act__talk { font-size: 16px; color: var(--ink-2); }
  .bk-act__talk a { font-weight: 700; }
  @media (min-width: 1000px) {
    .bk-act { position: sticky; top: 24px; }
  }

  .bk-where { max-width: 900px; }

  :global(.bk-price .lse-price__more) { display: grid; gap: 18px; }
  .bk-price__lead { font-size: clamp(24px, 1.4vw + 16px, 36px); font-weight: 700; line-height: 1.2; letter-spacing: -.025em; color: var(--ink); max-width: 24em; }
  .bk-price__lead a { font-weight: 900; background: var(--paper); padding: 0 .12em; margin: 0 -.04em; text-decoration-thickness: 2px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .bk-price__terms { padding-top: 16px; border-top: 2px solid var(--ink); font-size: clamp(19px, .5vw + 16px, 23px); font-weight: 700; color: var(--ink); max-width: 30em; }
</style>
