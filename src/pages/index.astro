---
// Homepage v2. Copy: content/home-v2.md. Facts: research/FACTS.md. Design: docs/design-system.md.
// Results lead and carry the page: every result has its real screenshot next to it, with the highlighter on
// the line that proves it. Mark boxes are % of each image, measured from its pixels.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import LeadForm from '../components/LeadForm.astro';
import PracticeLinks from '../components/PracticeLinks.astro';
import Shot from '../components/Shot.astro';
import Face from '../components/kit/Face.astro';
import NumPair from '../components/kit/NumPair.astro';
import PhoneShot from '../components/kit/PhoneShot.astro';
import PriceBand from '../components/kit/PriceBand.astro';
import ProofFigure from '../components/kit/ProofFigure.astro';
import Rows from '../components/kit/Rows.astro';
import TrustLine from '../components/kit/TrustLine.astro';
import { fahim, josh } from '../data/people';
import { proof, shot } from '../data/proof';
import { fahimSchema, joshSchema, site } from '../data/site';
import { faqSchema } from '../lib/schema';

const title = 'Lawyer SEO Expert | Get Found First, Get More Calls';
const description =
  'Lawyer SEO expert for law firms: we put you at the top of Google, the Map and AI answers. From $2,000 a month, month to month, no setup fee.';

const zones = [
  { title: 'Top of Google', text: 'Pages for each practice area and city, and links from relevant sites.' },
  { title: 'Google’s AI answers', text: 'Pages that Google’s AI can quote, checked every month.' },
  { title: 'The Map', text: 'Google Business Profile care and a routine for new reviews.' },
  { title: 'Your website', text: 'Design and content improvements, upkeep, and call and form tracking.' },
];

// The price band reads its rows from src/data/pricing.ts (shared with /seo-pricing/ and the services page).

const faq: FaqItem[] = [
  {
    q: 'How much does law firm SEO cost with you?',
    html: 'From $2,000 a month, and that covers everything it takes to rank. There is no setup fee. Fahim gives you your monthly number in writing before any work starts.',
  },
  {
    q: 'How soon will we get more calls?',
    html: 'It depends on your market and where your site starts. For the New Orleans firm, a new page reached #1 within 16 hours, after about three months of groundwork. In your ranking review, Fahim tells you what is realistic for your firm.',
  },
  {
    q: 'Do we sign a long contract?',
    html: 'No. You pay month to month. Everything we build is yours to keep: the site, the pages and the accounts we set up for you.',
  },
  {
    q: 'Who does the work?',
    html: 'Fahim leads your account, joins your calls and reviews all the work. A small team helps with production. You are never handed off to an account manager. Josh Henderson, our Sales Director, joins calls with firms too.',
  },
  {
    q: 'Does law firm SEO follow state bar advertising rules?',
    html: 'Each state bar sets its own advertising rules, including on words like “expert” and “specialist”. You or your ethics counsel approve every page before it is published. “Expert” in our name describes our SEO work, not a legal certification.',
  },
  {
    q: 'Does this cover Google’s AI answers?',
    html: 'Yes. We write pages that Google’s AI can quote, and we check the AI answers for your key searches every month.',
  },
];

const schema = [fahimSchema, joshSchema, faqSchema(faq, `${site.url}/`)];
---
<Base pageType="company" path="/" title={title} description={description} schema={schema}>

  <!-- Hero: the outcome, one line, a short form to act at once, a real result, and who we work with. -->
  <section class="lse-h-hero" aria-labelledby="hero-h">
    <div class="lse-wrap">
      <h1 id="hero-h">Get found first for the cases you want.</h1>
      <div class="lse-h-hero__grid">
        <p class="lse-lead lse-h-hero__lead">Lawyer SEO Expert puts your law firm at the top of Google, the Map and AI answers, so more of the right clients call.</p>
        <div class="lse-h-hero__act">
          <LeadForm
            compact
            title="Send your website for a ranking review."
            titleTag="h2"
            sub="Fahim answers within an hour in business hours."
            idPrefix="h"
            label="Homepage hero form"
            format="Ranking review by email"
          >
            <Fragment slot="privacy">We use your details to reply and to measure our ads. <a href="/privacy-policy/">Privacy policy</a>.</Fragment>
          </LeadForm>
          <p class="lse-h-hero__talk">Rather talk it through? <a href={site.cta.href} data-cal>Book a ranking review</a></p>
        </div>
        <figure class="lse-h-hero__proof">
          <Shot tag="139 calls" tagSide="right" priority images={[shot(proof.nolaCalls, { marks: ['total', 'growth'] })]} />
          <figcaption class="lse-h-cap">A PI firm in New Orleans. Google counted 139 calls from its Business Profile in five months, 39% more than a year before.</figcaption>
        </figure>
        <TrustLine class="lse-h-trust" priority />
      </div>
    </div>
  </section>

  <!-- Rankings: three real searches. -->
  <section class="lse-section lse-section--fog lse-h-rank" aria-labelledby="rank-h">
    <div class="lse-wrap">
      <h2 id="rank-h">New pages at the top of Google 16&nbsp;hours after going live.</h2>
      <p class="lse-lead lse-h2-lead">For a PI firm in New Orleans, after about three months of groundwork. Google’s AI answers cite the pages too.</p>
      <div class="lse-h-rank__grid">
        <ProofFigure
          class="lse-h-rank__main"
          tag="#1"
          images={[shot(proof.nolaWtdQuery), shot(proof.nolaWtdRank, { marks: ['age'] }), shot(proof.nolaWtdAi, { marks: ['citations'] })]}
          query="what to do after a truck accident in New Orleans"
          caption="Ranked #1 on Google, and quoted 3 times in Google’s AI answer."
        />
        <div class="lse-h-rank__side">
          <ProofFigure
            tag="#1"
            images={[shot(proof.nolaJackknife, { marks: ['aiChip', 'result'] })]}
            query="jackknife truck accident Louisiana"
            caption="Ranked #1. A week on, Google’s AI still cites it."
          />
          <ProofFigure
            tag="Source #1"
            images={[shot(proof.elpasoAiDeadline, { marks: ['citedLine', 'sourceCard'] })]}
            query="Texas El Paso car accident filing deadline"
            caption="For a PI firm in El Paso, its page is the first source Google’s AI answer cites."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Calls: Google's own counts, before and with us. -->
  <section class="lse-section lse-h-calls" aria-labelledby="calls-h">
    <div class="lse-wrap">
      <h2 id="calls-h">More calls, counted by Google.</h2>
      <p class="lse-lead lse-h2-lead">Calls from the Google Business Profiles we run. Google’s own numbers, not ours.</p>

      <article class="lse-h-case" aria-labelledby="case-ep">
        <div class="lse-h-case__head">
          <NumPair before={9} after={23} beforeLabel="calls in six months before us" afterLabel="calls in three months with us" />
          <h3 id="case-ep">A PI firm in El Paso went from 9 calls in six months to 23 in three.</h3>
        </div>
        <div class="lse-h-pair">
          <figure>
            <figcaption>Before us: Aug 2025 to Jan 2026</figcaption>
            <Shot images={[shot(proof.elpasoCallsBefore, { marks: ['total'] })]} />
          </figure>
          <figure>
            <figcaption>With us: May to Jul 2026</figcaption>
            <Shot images={[shot(proof.elpasoCallsAfter, { marks: ['total'] })]} />
          </figure>
        </div>
      </article>

      <article class="lse-h-case lse-h-case--flip" aria-labelledby="case-new">
        <div class="lse-h-case__head">
          <NumPair before={1} after={9} beforeLabel="call in July" afterLabel="calls in October" />
          <h3 id="case-new">A new Google profile went from 1 call in July to 9 in October.</h3>
          <p>It started with no history and climbed every month.</p>
        </div>
        <figure class="lse-h-case__shot">
          <Shot images={[shot(proof.newProfileCalls, { marks: ['points'] })]} />
        </figure>
      </article>

      <div class="lse-h-midcta">
        <Button />
        <p class="lse-small">{site.cta.sub}</p>
      </div>
    </div>
  </section>

  <!-- What one price covers: every place a firm can show up, with the real result for each. -->
  <section class="lse-section lse-section--fog lse-h-cover" aria-labelledby="cover-h">
    <div class="lse-wrap">
      <h2 id="cover-h">One monthly price covers everything it takes to rank.</h2>
      <p class="lse-lead lse-h2-lead">Most agencies sell SEO in pieces. We handle all of it, so nothing holds your firm back. See every part of our <a class="lse-link" href="/law-firm-seo-services/">law firm SEO services</a>.</p>
      <div class="lse-h-cover__grid">
        <Rows items={zones} />
        <div class="lse-h-board">
          <Shot class="lse-h-board__rank" tag="Top of Google" tagSmall tagSide="right" images={[shot(proof.nolaTankerRank, { marks: ['title'], alt: 'A New Orleans PI firm’s page in Google’s results for tanker truck accident lawyer in New Orleans' })]} />
          <Shot class="lse-h-board__ai" tag="AI answer" tagSmall tagSide="right" images={[shot(proof.nolaKeyFirm, { crop: 'answer', marks: ['aiChip'], alt: 'Google’s AI Overview citing a New Orleans PI firm' })]} />
          <Shot class="lse-h-board__map" tag="The Map" tagSmall tagSide="right" images={[shot(proof.nolaKeyFirm, { crop: 'keyFirms', marks: ['firmRow'], alt: 'Google lists a New Orleans PI firm under key legal firms, rated 5.0 from 317 reviews' })]} />
          <PhoneShot class="lse-h-board__site" tag="Your site" tagSmall tagSide="right" images={[shot(proof.elpasoSiteMobile)]} />
        </div>
      </div>
      <p class="lse-h-web">Need a new website? We build law firm sites to rank, from $2,000 for the build. <a class="lse-link" href="/lawyer-web-design-development/">Law firm web design</a></p>
    </div>
  </section>

  <!-- Our own result: one screenshot, one line. -->
  <section class="lse-section lse-h-own" aria-labelledby="own-h">
    <div class="lse-wrap lse-h-own__grid">
      <div class="lse-h-own__text">
        <h2 id="own-h">We rank #1 on Google for “lawyer seo expert”.</h2>
        <p class="lse-lead lse-h2-lead">The same work that got us there goes into your firm’s pages.</p>
        <p class="lse-small lse-h-own__src">Google search, United States, 8 November 2026.</p>
      </div>
      <Shot
        class="lse-h-own__shot"
        tag="#1"
        images={[shot(proof.lseSerp, { crop: 'result', marks: ['title'] })]}
      />
    </div>
  </section>

  <!-- The people. -->
  <section class="lse-section lse-section--fog lse-h-team" aria-labelledby="team-h">
    <div class="lse-wrap">
      <h2 id="team-h">You work with Fahim, from the first call on.</h2>
      <div class="lse-h-team__grid">
        <Face person={fahim} size="lg" />
        <div class="lse-h-team__text">
          <h3>S.&nbsp;M.&nbsp;Fahim</h3>
          <p class="lse-h-team__role">Law firm SEO expert</p>
          <p class="lse-h-team__bio">Fahim leads every account, joins every call and reviews all the work. A small team helps with production. You are never handed off to an account manager.</p>
          <ul class="lse-h-record">
            <li><b>6.5</b><span>years growing businesses online</span></li>
            <li><b>67+</b><span>businesses grown</span></li>
            <li><b>50+</b><span>ranked on Google</span></li>
            <li><b>200+</b><span>websites built</span></li>
          </ul>
          <div class="lse-h-josh">
            <Face person={josh} size="sm" />
            <div>
              <h3>Josh Henderson</h3>
              <p class="lse-h-team__role">Sales Director</p>
              <p>Texas attorney since 2008, and an advisor to more than 50 law firms. Josh joins calls with firms.</p>
            </div>
          </div>
          <p class="lse-h-team__more">Want a second opinion first? See <a class="lse-link" href="/law-firm-seo-consultant/">law firm SEO consulting</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Price and terms, in plain lines. -->
  <PriceBand
    variant="breakdown"
    heading={['From $2,000 a month.', 'Everything included.']}
    headingId="price-h"
    us="With us: all of it, from $2,000 a month."
    note="No setup fee."
  >
    <Fragment slot="link">What sets your firm’s price is on our <a href="/seo-pricing/">law firm SEO pricing</a> page.</Fragment>
  </PriceBand>

  <!-- Practice areas. -->
  <section class="lse-section lse-h-practice" id="practice-areas" aria-labelledby="practice-h">
    <div class="lse-wrap">
      <h2 id="practice-h">Find your practice area.</h2>
      <div class="lse-h-practice__links"><PracticeLinks /></div>
    </div>
  </section>

  <!-- FAQ. -->
  <section class="lse-section lse-h-faq" aria-labelledby="faq-h">
    <div class="lse-wrap">
      <h2 id="faq-h">Questions before your ranking review.</h2>
      <div class="lse-h-faq__list"><Faq items={faq} /></div>
    </div>
  </section>

  <FinalCta heading="See where your firm ranks today." formLabel="Homepage message">
    <p>In 30 minutes, Fahim looks at your real rankings with you and shows what would bring in more calls first.</p>
  </FinalCta>
</Base>

<style is:global>
  /* ---------- Hero ---------- */
  .lse-h-hero { position: relative; overflow: hidden; padding: clamp(36px, 4.5vw, 64px) 0 clamp(72px, 8vw, 112px); }
  .lse-h-hero h1 { max-width: 15ch; }
  .lse-h-hero__grid {
    display: grid; gap: 32px; margin-top: clamp(20px, 2.4vw, 32px);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "lead" "proof" "act" "trust";
  }
  .lse-h-hero__lead { grid-area: lead; max-width: 25em; }
  .lse-h-hero__act { grid-area: act; display: grid; gap: 14px; align-content: start; }
  .lse-h-hero__talk { font-size: 16px; color: var(--ink-2); }
  .lse-h-hero__talk a { font-weight: 700; }
  .lse-h-hero__proof { grid-area: proof; display: grid; gap: 14px; align-content: start; }
  .lse-h-cap { font-size: var(--fs-meta); color: var(--muted); max-width: 44em; }
  .lse-h-trust { grid-area: trust; }
  @media (min-width: 1000px) {
    .lse-h-hero h1 { max-width: 19ch; }
    .lse-h-hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "lead proof" "act proof" "act trust";
      column-gap: clamp(48px, 5vw, 80px); row-gap: 28px;
    }
    /* The result sits on a fog panel that runs off the right edge of the screen. */
    .lse-h-hero__proof { position: relative; z-index: 0; padding: 44px 0 36px 40px; }
    .lse-h-hero__proof::before { content: ""; position: absolute; z-index: -1; top: 0; bottom: 0; left: 0; right: -50vw; background: var(--fog); border-radius: 28px 0 0 28px; }
    .lse-h-hero__proof .lse-shot__frame { box-shadow: var(--shadow-lift); border-color: #cfd4cb; }
    .lse-h-trust { align-self: end; padding-top: 22px; border-top: 1px solid var(--line); }
  }

  /* ---------- Rankings ---------- */
  .lse-h-rank h2 { max-width: 22ch; }
  .lse-h-rank__grid { display: grid; gap: 56px; margin-top: var(--s6); }
  .lse-h-rank__side { display: grid; gap: 56px; align-content: start; }
  @media (min-width: 1000px) {
    .lse-h-rank__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 48px; }
  }

  /* ---------- Calls ---------- */
  .lse-h-case { display: grid; gap: 32px; margin-top: var(--s6); }
  .lse-h-case + .lse-h-case { margin-top: clamp(72px, 8vw, 112px); }
  .lse-h-case__head { display: grid; gap: 16px; align-content: start; }
  .lse-h-case__head h3 { max-width: 20ch; }
  .lse-h-case__head p { color: var(--ink-2); }
  .lse-h-pair { display: grid; gap: 28px; }
  .lse-h-pair figure { display: grid; gap: 10px; align-content: start; }
  .lse-h-pair figcaption { font-size: 16px; font-weight: 700; color: var(--ink); }
  .lse-h-midcta { margin-top: clamp(64px, 7vw, 96px); padding-top: var(--s5); border-top: 1px solid var(--line); display: grid; gap: 12px; justify-items: start; }
  @media (min-width: 760px) { .lse-h-pair { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) {
    .lse-h-case:not(.lse-h-case--flip) .lse-h-case__head { grid-template-columns: auto minmax(0, 1fr); column-gap: 64px; align-items: end; }
    .lse-h-case:not(.lse-h-case--flip) .lse-h-case__head h3 { max-width: 16ch; padding-bottom: 6px; }
    .lse-h-case--flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 64px; align-items: center; }
    .lse-h-case--flip .lse-h-case__head { order: 2; }
  }

  /* ---------- What one price covers ---------- */
  .lse-h-cover__grid { display: grid; gap: 48px; margin-top: var(--s6); }
  .lse-h-board { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); align-items: start; }
  .lse-h-board .lse-h-board__site { max-width: 210px; }
  @media (max-width: 699px) {
    /* On a phone the capture shows only its first screen, wide enough for its text to read. */
    .lse-h-board .lse-h-board__site { max-width: 300px; }
  }
  .lse-h-web { margin-top: var(--s6); font-size: var(--fs-lead); line-height: 1.45; color: var(--ink); max-width: 46em; }
  .lse-h-web a { white-space: nowrap; margin-left: 6px; }
  @media (min-width: 700px) {
    .lse-h-board { grid-template-columns: minmax(0, 1fr) 210px; grid-template-rows: auto auto 1fr; column-gap: 28px; }
    .lse-h-board__rank { grid-column: 1 / -1; }
    .lse-h-board__ai { grid-column: 1; grid-row: 2; }
    .lse-h-board__map { grid-column: 1; grid-row: 3; }
    .lse-h-board__site { grid-column: 2; grid-row: 2 / span 2; }
  }
  @media (min-width: 1000px) {
    .lse-h-cover__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: 64px; }
  }

  /* ---------- Our own result ---------- */
  .lse-h-own__grid { display: grid; gap: 48px; }
  .lse-h-own__src { margin-top: var(--s3); }
  @media (min-width: 1000px) {
    .lse-h-own__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 64px; align-items: center; }
  }

  /* ---------- People ---------- */
  .lse-h-team__grid { display: grid; gap: 40px; margin-top: var(--s6); }
  .lse-h-team__role { margin-top: 4px; font-size: var(--fs-meta); font-weight: 600; color: var(--muted); }
  .lse-h-team__bio { margin-top: var(--s2); font-size: var(--fs-lead); line-height: 1.45; max-width: 30em; }
  .lse-h-record { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; margin-top: var(--s5); padding-top: var(--s3); border-top: 2px solid var(--ink); }
  .lse-h-record li { display: grid; gap: 4px; align-content: start; }
  .lse-h-record b { font-size: clamp(30px, 1.6vw + 18px, 42px); font-weight: 900; letter-spacing: -.04em; line-height: 1; }
  .lse-h-record span { font-size: var(--fs-meta); color: var(--muted); line-height: 1.3; }
  .lse-h-team__more { margin-top: var(--s4); color: var(--ink-2); }
  .lse-h-josh { display: flex; gap: 24px; align-items: center; margin-top: var(--s5); padding-top: var(--s4); border-top: 1px solid var(--line-2); }
  .lse-h-josh h3 { font-size: 22px; }
  .lse-h-josh p:last-child { margin-top: 6px; color: var(--ink-2); max-width: 26em; }
  @media (min-width: 760px) { .lse-h-record { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .lse-h-team__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 72px; align-items: end; }
  }

  /* ---------- Practice areas and FAQ ---------- */
  .lse-h-practice__links, .lse-h-faq__list { margin-top: var(--s5); }
  .lse-h-faq { padding-top: 0; }
  .lse-final { background: var(--fog); }
</style>
