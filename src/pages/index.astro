---
// Homepage v2. Copy: content/home-v2.md. Facts: research/FACTS.md. Design: docs/design-system.md.
// Results lead and carry the page: every result has its real screenshot next to it, with the highlighter on
// the line that proves it. Mark boxes are % of each image, measured from its pixels.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import LeadForm from '../components/LeadForm.astro';
import PracticeLinks from '../components/PracticeLinks.astro';
import Shot from '../components/Shot.astro';
import { fahimSchema, joshSchema, site } from '../data/site';
import { faqSchema } from '../lib/schema';

const title = 'Lawyer SEO Expert | Get Found First, Get More Calls';
const description =
  'Law firm SEO that puts you at the top of Google, the Map and AI answers. From $2,000 a month, month to month, no setup fee. Book a ranking review.';

const P = '/img/proof/';

const logos = [
  { src: '/img/logos/rudin-ink.webp', width: 108, height: 120, alt: 'Rudin Law logo', h: 46 },
  { src: '/img/logos/915-ink.webp', width: 602, height: 120, alt: '915 Injury logo', h: 34 },
  { src: '/img/logos/cohen-ink.webp', width: 237, height: 120, alt: 'Cohen & Cohen logo', h: 40 },
  { src: '/img/logos/dedert-ink.webp', width: 248, height: 39, alt: 'Dedert logo', h: 21 },
];

const zones = [
  { title: 'Top of Google', text: 'Pages for each practice area and city, and links from relevant sites.' },
  { title: 'Google’s AI answers', text: 'Pages that Google’s AI can quote, checked every month.' },
  { title: 'The Map', text: 'Google Business Profile care and a routine for new reviews.' },
  { title: 'Your website', text: 'Design and content improvements, upkeep, and call and form tracking.' },
];

// What the monthly price includes, and what each part typically costs a month when a firm hires it separately.
// Proposals the owner confirms (2026-11-08). Every amount here must also be in PRICES_BY_PAGE['/'] in
// scripts/check-dist.mjs, or the build fails.
const included = [
  { item: 'Practice and location pages, written for you', cost: '$1,200+' },
  { item: 'Links from relevant sites', cost: '$1,000+' },
  { item: 'Website design and content improvements', cost: '$750+' },
  { item: 'Website maintenance and security', cost: '$500+' },
  { item: 'Google Business Profile and reviews', cost: '$125+' },
  { item: 'Call and form tracking', cost: '$300+' },
  { item: 'Rank tracking and AI answer checks', cost: '$150+' },
];
const separateTotal = '$4,000+';

const faq: FaqItem[] = [
  {
    q: 'How much does law firm SEO cost with you?',
    html: 'From $2,000 a month, and that covers everything it takes to rank. There is no setup fee. Fahim gives you your monthly number in writing before any work starts.',
  },
  {
    q: 'How soon will we get more calls?',
    html: 'It depends on your market and where your site starts. For the New Orleans firm, a new page reached #1 within 16 hours, after about three months of groundwork. In your ranking review, Fahim tells you what is realistic for your firm.',
  },
  {
    q: 'Do we sign a long contract?',
    html: 'No. You pay month to month. Everything we build is yours to keep: the site, the pages and the accounts we set up for you.',
  },
  {
    q: 'Who does the work?',
    html: 'Fahim leads your account, joins your calls and reviews all the work. A small team helps with production. You are never handed off to an account manager. Josh Henderson, our Sales Director, joins calls with firms too.',
  },
  {
    q: 'Does law firm SEO follow state bar advertising rules?',
    html: 'Each state bar sets its own advertising rules, including on words like “expert” and “specialist”. You or your ethics counsel approve every page before it is published. “Expert” in our name describes our SEO work, not a legal certification.',
  },
  {
    q: 'Does this cover Google’s AI answers?',
    html: 'Yes. We write pages that Google’s AI can quote, and we check the AI answers for your key searches every month.',
  },
];

const schema = [fahimSchema, joshSchema, faqSchema(faq, `${site.url}/`)];
---
<Base pageType="company" path="/" title={title} description={description} schema={schema}>

  <!-- Hero: the outcome, one line, a short form to act at once, a real result, and who we work with. -->
  <section class="lse-h-hero" aria-labelledby="hero-h">
    <div class="lse-wrap">
      <h1 id="hero-h">Get found first for the cases you want.</h1>
      <div class="lse-h-hero__grid">
        <p class="lse-lead lse-h-hero__lead">Lawyer SEO Expert puts your law firm at the top of Google, the Map and AI answers, so more of the right clients call.</p>
        <div class="lse-h-hero__act">
          <LeadForm
            compact
            title="Send your website for a ranking review."
            titleTag="h2"
            sub="Fahim answers within an hour in business hours."
            idPrefix="h"
            label="Homepage hero form"
            format="Ranking review by email"
          >
            <Fragment slot="privacy">We use your details to reply and to measure our ads. <a href="/privacy-policy/">Privacy policy</a>.</Fragment>
          </LeadForm>
          <p class="lse-h-hero__talk">Rather talk it through? <a href={site.cta.href} data-cal>Book a ranking review</a></p>
        </div>
        <figure class="lse-h-hero__proof">
          <Shot
            tag="139 calls"
            tagSide="right"
            priority
            images={[
              { src: `${P}nola-calls-jun-oct-2026.webp`, width: 1077, height: 582, alt: 'Google Business Profile: 139 calls from June to October 2026, up 39% on the same months of 2025', marks: [{ l: 3.4, t: 33.2, w: 7.8, h: 9.4 }, { l: 3.6, t: 47.6, w: 7.5, h: 4.4 }] },
            ]}
          />
          <figcaption class="lse-h-cap">A PI firm in New Orleans. Google counted 139 calls from its Business Profile in five months, 39% more than a year before.</figcaption>
        </figure>
        <div class="lse-h-trust">
          <p class="lse-h-trust__label">Law firms we work with</p>
          <ul class="lse-h-trust__logos">
            {logos.map((l) => (
              <li><img src={l.src} width={l.width} height={l.height} alt={l.alt} style={`height:${l.h}px;width:auto`} loading="eager" decoding="async"></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Rankings: three real searches. -->
  <section class="lse-section lse-section--fog lse-h-rank" aria-labelledby="rank-h">
    <div class="lse-wrap">
      <h2 id="rank-h">New pages at the top of Google 16&nbsp;hours after going live.</h2>
      <p class="lse-lead lse-h2-lead">For a PI firm in New Orleans, after about three months of groundwork. Google’s AI answers cite the pages too.</p>
      <div class="lse-h-rank__grid">
        <figure class="lse-h-proof lse-h-rank__main">
          <Shot
            tag="#1"
            tagSide="right"
            images={[
              { src: `${P}nola-wtd-query.webp`, width: 976, height: 67, alt: '' },
              { src: `${P}nola-wtd-rank.webp`, width: 900, height: 162, alt: 'The page in Google’s results, stamped 16 hours ago', marks: [{ l: 1.6, t: 63.5, w: 12.2, h: 16 }] },
              { src: `${P}nola-wtd-ai.webp`, width: 900, height: 776, alt: 'Google’s AI answer citing the firm’s page on recorded statements and Louisiana filing deadlines', marks: [{ l: 60, t: 25.8, w: 14.4, h: 3.2 }, { l: 14.1, t: 48.9, w: 11.8, h: 3.3 }, { l: 61.4, t: 63.3, w: 11.9, h: 3.1 }] },
            ]}
          />
          <figcaption><b><q data-no-check>what to do after a truck accident in New Orleans</q></b><span>Ranked #1 on Google, and quoted 3 times in Google’s AI answer.</span></figcaption>
        </figure>
        <div class="lse-h-rank__side">
          <figure class="lse-h-proof">
            <Shot
              tag="#1"
              tagSide="right"
              images={[
                { src: `${P}nola-jackknife.webp`, width: 1022, height: 625, alt: 'Google search for jackknife truck accident Louisiana: the firm’s page is the first result, 7 days after going live, and cited in the AI Overview', marks: [{ l: 39.9, t: 50.3, w: 8.7, h: 3.8 }, { l: 1.9, t: 88.4, w: 40, h: 4 }] },
              ]}
            />
            <figcaption><b><q data-no-check>jackknife truck accident Louisiana</q></b><span>Ranked #1. A week on, Google’s AI still cites it.</span></figcaption>
          </figure>
          <figure class="lse-h-proof">
            <Shot
              tag="Source #1"
              tagSide="right"
              images={[
                { src: `${P}elpaso-ai-deadline.webp`, width: 1400, height: 849, alt: 'Google’s AI Overview for Texas El Paso car accident filing deadline, with an El Paso PI firm’s page as the first source', marks: [{ l: 5.1, t: 35.3, w: 33.9, h: 2.6 }, { l: 69.6, t: 35.4, w: 24, h: 3.2 }] },
              ]}
            />
            <figcaption><b><q data-no-check>Texas El Paso car accident filing deadline</q></b><span>For a PI firm in El Paso, its page is the first source Google’s AI answer cites.</span></figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Calls: Google's own counts, before and with us. -->
  <section class="lse-section lse-h-calls" aria-labelledby="calls-h">
    <div class="lse-wrap">
      <h2 id="calls-h">More calls, counted by Google.</h2>
      <p class="lse-lead lse-h2-lead">Calls from the Google Business Profiles we run. Google’s own numbers, not ours.</p>

      <article class="lse-h-case" aria-labelledby="case-ep">
        <div class="lse-h-case__head">
          <div class="lse-h-nums" aria-hidden="true">
            <span class="lse-h-num lse-h-num--was">9</span>
            <span class="lse-h-nums__to"><svg viewBox="0 0 48 24" focusable="false"><path d="M2 12h40M32 3l10 9-10 9" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="lse-h-num lse-h-num--marked" data-count="23">23</span>
            <span class="lse-h-nums__l">calls in six months before us</span>
            <span class="lse-h-nums__l lse-h-nums__l--now">calls in three months with us</span>
          </div>
          <h3 id="case-ep">A PI firm in El Paso went from 9 calls in six months to 23 in three.</h3>
        </div>
        <div class="lse-h-pair">
          <figure>
            <figcaption>Before us: Aug 2025 to Jan 2026</figcaption>
            <Shot images={[{ src: `${P}elpaso-calls-before.webp`, width: 1200, height: 649, alt: 'Google Business Profile: 9 calls from August 2025 to January 2026', marks: [{ l: 3.9, t: 34, w: 2.9, h: 9 }] }]} />
          </figure>
          <figure>
            <figcaption>With us: May to Jul 2026</figcaption>
            <Shot images={[{ src: `${P}elpaso-calls-after.webp`, width: 1347, height: 727, alt: 'Google Business Profile: 23 calls from May to July 2026, rising every month', marks: [{ l: 3.7, t: 34, w: 5.6, h: 9 }] }]} />
          </figure>
        </div>
      </article>

      <article class="lse-h-case lse-h-case--flip" aria-labelledby="case-new">
        <div class="lse-h-case__head">
          <div class="lse-h-nums" aria-hidden="true">
            <span class="lse-h-num lse-h-num--was">1</span>
            <span class="lse-h-nums__to"><svg viewBox="0 0 48 24" focusable="false"><path d="M2 12h40M32 3l10 9-10 9" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="lse-h-num lse-h-num--marked" data-count="9">9</span>
            <span class="lse-h-nums__l">call in July</span>
            <span class="lse-h-nums__l lse-h-nums__l--now">calls in October</span>
          </div>
          <h3 id="case-new">A new Google profile went from 1 call in July to 9 in October.</h3>
          <p>It started with no history and climbed every month.</p>
        </div>
        <figure class="lse-h-case__shot">
          <Shot images={[{ src: `${P}new-profile-calls.webp`, width: 1067, height: 571, alt: 'Google Business Profile for a new profile: calls from June to October 2026, rising from about 1 in July to 9 in October', marks: [{ l: 26.4, t: 85.6, w: 4.4, h: 6 }, { l: 93.2, t: 54.6, w: 5, h: 6.4 }] }]} />
        </figure>
      </article>

      <div class="lse-h-midcta">
        <Button />
        <p class="lse-small">{site.cta.sub}</p>
      </div>
    </div>
  </section>

  <!-- What one price covers: every place a firm can show up, with the real result for each. -->
  <section class="lse-section lse-section--fog lse-h-cover" aria-labelledby="cover-h">
    <div class="lse-wrap">
      <h2 id="cover-h">One monthly price covers everything it takes to rank.</h2>
      <p class="lse-lead lse-h2-lead">Most agencies sell SEO in pieces. We handle all of it, so nothing holds your firm back.</p>
      <div class="lse-h-cover__grid">
        <ul class="lse-h-zones">
          {zones.map((z) => (
            <li class="lse-h-zone"><h3>{z.title}</h3><p>{z.text}</p></li>
          ))}
        </ul>
        <div class="lse-h-board">
          <Shot class="lse-h-board__rank" tag="Top of Google" tagSmall tagSide="right" images={[{ src: `${P}nola-tanker-rank.webp`, width: 900, height: 175, alt: 'A New Orleans PI firm’s page in Google’s results for tanker truck accident lawyer in New Orleans', marks: [{ l: 1.6, t: 33, w: 63.6, h: 20 }] }]} />
          <Shot class="lse-h-board__ai" tag="AI answer" tagSmall tagSide="right" images={[{ src: `${P}nola-key-firm.webp`, width: 790, height: 358, alt: 'Google’s AI Overview citing a New Orleans PI firm', crop: { top: 0, height: 50 }, marks: [{ l: 8.6, t: 40.4, w: 13.6, h: 6.4 }] }]} />
          <Shot class="lse-h-board__map" tag="The Map" tagSmall tagSide="right" images={[{ src: `${P}nola-key-firm.webp`, width: 790, height: 358, alt: 'Google lists a New Orleans PI firm under key legal firms, rated 5.0 from 317 reviews', crop: { top: 50, height: 50 }, marks: [{ l: 18.4, t: 68.5, w: 11.2, h: 6.2 }, { l: 18.4, t: 75.6, w: 19.2, h: 6.2 }] }]} />
          <Shot class="lse-h-board__site" tag="Your site" tagSmall tagSide="right" images={[{ src: `${P}elpaso-site-mobile.webp`, width: 824, height: 1760, alt: 'A website we built for a PI firm in El Paso, on a phone' }]} />
        </div>
      </div>
      <p class="lse-h-web">Need a new website? We build law firm sites to rank, from $2,000 for the build. <a class="lse-link" href="/lawyer-web-design-development/">Law firm web design</a></p>
    </div>
  </section>

  <!-- Our own result: one screenshot, one line. -->
  <section class="lse-section lse-h-own" aria-labelledby="own-h">
    <div class="lse-wrap lse-h-own__grid">
      <div class="lse-h-own__text">
        <h2 id="own-h">We rank #1 on Google for “lawyer seo expert”.</h2>
        <p class="lse-lead lse-h2-lead">The same work that got us there goes into your firm’s pages.</p>
        <p class="lse-small lse-h-own__src">Google search, United States, 8 November 2026.</p>
      </div>
      <Shot
        class="lse-h-own__shot"
        tag="#1"
        images={[{ src: `${P}lse-serp-lawyer-seo-expert-2026-11-08.webp`, width: 1800, height: 920, alt: 'Google search for lawyer seo expert in the United States: lawyerseoexpert.com is the first result under the sponsored results', crop: { top: 15, height: 46 }, marks: [{ l: 9.7, t: 30.6, w: 76.4, h: 7.6 }] }]}
      />
    </div>
  </section>

  <!-- The people. -->
  <section class="lse-section lse-section--fog lse-h-team" aria-labelledby="team-h">
    <div class="lse-wrap">
      <h2 id="team-h">You work with Fahim, from the first call on.</h2>
      <div class="lse-h-team__grid">
        <div class="lse-h-face lse-h-face--lg">
          <img src="/img/people/fahim.webp" width="720" height="716" alt="S. M. Fahim" loading="lazy" decoding="async">
        </div>
        <div class="lse-h-team__text">
          <h3>S.&nbsp;M.&nbsp;Fahim</h3>
          <p class="lse-h-team__role">Law firm SEO expert</p>
          <p class="lse-h-team__bio">Fahim leads every account, joins every call and reviews all the work. A small team helps with production. You are never handed off to an account manager.</p>
          <ul class="lse-h-record">
            <li><b>6.5</b><span>years growing businesses online</span></li>
            <li><b>67+</b><span>businesses grown</span></li>
            <li><b>50+</b><span>ranked on Google</span></li>
            <li><b>200+</b><span>websites built</span></li>
          </ul>
          <div class="lse-h-josh">
            <div class="lse-h-face lse-h-face--sm">
              <img src="/img/people/josh.webp" width="720" height="707" alt="Josh Henderson" loading="lazy" decoding="async">
            </div>
            <div>
              <h3>Josh Henderson</h3>
              <p class="lse-h-team__role">Sales Director</p>
              <p>Texas attorney since 2008, and an advisor to more than 50 law firms. Josh joins calls with firms.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Price and terms, in plain lines. -->
  <section class="lse-section lse-h-price" aria-labelledby="price-h">
    <div class="lse-wrap">
      <h2 id="price-h"><span>From $2,000 a month.</span> <span>Everything included.</span></h2>
      <div class="lse-h-price__grid">
        <div class="lse-h-price__list">
          <ul class="lse-h-costs">
            {included.map((r) => <li><span>{r.item}</span><b>{r.cost}</b></li>)}
          </ul>
          <p class="lse-h-sep"><span>Hired one by one:</span> <s class="lse-h-strike">{separateTotal} a month</s></p>
        </div>
        <div class="lse-h-price__us">
          <p class="lse-h-us">With us: all of it, from $2,000 a month.</p>
          <p class="lse-h-nofee">No setup fee.</p>
          <div class="lse-h-price__cta"><Button /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Practice areas. -->
  <section class="lse-section lse-h-practice" id="practice-areas" aria-labelledby="practice-h">
    <div class="lse-wrap">
      <h2 id="practice-h">SEO for your practice area.</h2>
      <div class="lse-h-practice__links"><PracticeLinks /></div>
    </div>
  </section>

  <!-- FAQ. -->
  <section class="lse-section lse-h-faq" aria-labelledby="faq-h">
    <div class="lse-wrap">
      <h2 id="faq-h">Questions before your ranking review.</h2>
      <div class="lse-h-faq__list"><Faq items={faq} /></div>
    </div>
  </section>

  <FinalCta heading="See where your firm ranks today." formLabel="Homepage message">
    <p>In 30 minutes, Fahim looks at your real rankings with you and shows what would bring in more calls first.</p>
  </FinalCta>
</Base>

<style is:global>
  /* ---------- Hero ---------- */
  .lse-h-hero { position: relative; overflow: hidden; padding: clamp(36px, 4.5vw, 64px) 0 clamp(72px, 8vw, 112px); }
  .lse-h-hero h1 { max-width: 15ch; }
  .lse-h-hero__grid {
    display: grid; gap: 32px; margin-top: clamp(20px, 2.4vw, 32px);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "lead" "proof" "act" "trust";
  }
  .lse-h-hero__lead { grid-area: lead; max-width: 25em; }
  .lse-h-hero__act { grid-area: act; display: grid; gap: 14px; align-content: start; }
  .lse-h-hero__talk { font-size: 16px; color: var(--ink-2); }
  .lse-h-hero__talk a { font-weight: 700; }
  .lse-h-hero__proof { grid-area: proof; display: grid; gap: 14px; align-content: start; }
  .lse-h-cap { font-size: var(--fs-meta); color: var(--muted); max-width: 44em; }
  .lse-h-trust { grid-area: trust; }
  .lse-h-trust__label { font-size: var(--fs-meta); color: var(--muted); }
  .lse-h-trust__logos { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 34px; margin-top: 14px; }
  @media (min-width: 1000px) {
    .lse-h-hero h1 { max-width: 19ch; }
    .lse-h-hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: "lead proof" "act proof" "act trust";
      column-gap: clamp(48px, 5vw, 80px); row-gap: 28px;
    }
    /* The result sits on a fog panel that runs off the right edge of the screen. */
    .lse-h-hero__proof { position: relative; z-index: 0; padding: 44px 0 36px 40px; }
    .lse-h-hero__proof::before { content: ""; position: absolute; z-index: -1; top: 0; bottom: 0; left: 0; right: -50vw; background: var(--fog); border-radius: 28px 0 0 28px; }
    .lse-h-hero__proof .lse-shot__frame { box-shadow: var(--shadow-lift); border-color: #cfd4cb; }
    .lse-h-trust { align-self: end; padding-top: 22px; border-top: 1px solid var(--line); }
  }

  /* Proof captions: the search in bold, the result under it. */
  .lse-h-proof { display: grid; gap: 16px; align-content: start; }
  .lse-h-proof figcaption { display: grid; gap: 4px; font-size: 17px; line-height: 1.4; max-width: 38em; }
  .lse-h-proof figcaption b { font-size: 18px; letter-spacing: -.01em; }
  .lse-h-proof figcaption span { color: var(--ink-2); }

  /* ---------- Rankings ---------- */
  .lse-h-rank h2 { max-width: 22ch; }
  .lse-h-rank__grid { display: grid; gap: 56px; margin-top: var(--s6); }
  .lse-h-rank__side { display: grid; gap: 56px; align-content: start; }
  @media (min-width: 1000px) {
    .lse-h-rank__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 48px; }
  }

  /* ---------- Calls ---------- */
  .lse-h-case { display: grid; gap: 32px; margin-top: var(--s6); }
  .lse-h-case + .lse-h-case { margin-top: clamp(72px, 8vw, 112px); }
  .lse-h-case__head { display: grid; gap: 16px; align-content: start; }
  .lse-h-case__head h3 { max-width: 20ch; }
  .lse-h-case__head p { color: var(--ink-2); }
  /* Before, an arrow, after. The arrow sits in its own column so "9 23" never reads as one number. */
  .lse-h-nums { display: grid; grid-template-columns: auto auto auto; justify-content: start; align-items: center; column-gap: clamp(14px, 2vw, 28px); row-gap: 10px; }
  .lse-h-nums__to { grid-row: 1; grid-column: 2; display: block; width: calc(var(--fs-num) * .5); color: var(--ink); }
  .lse-h-nums__to svg { width: 100%; height: auto; }
  .lse-h-nums__l { grid-row: 2; grid-column: 1 / 3; align-self: start; font-size: var(--fs-meta); color: var(--muted); max-width: 8.5em; line-height: 1.3; }
  .lse-h-nums__l--now { grid-column: 3; }
