---
// /seo-for-immigration-lawyers/ from content/v3/seo-for-immigration-lawyers.md (critic: content/v3/CRITIC-practice-3.md).
// Facts: research/FACTS.md. This page owns multilingual pages and hreflang (DEPTH-BRIEF section 5). The commercial
// top is the v2 build: a stacked hero with no form (one city's results page wide on the fog panel, only the AI
// answer chip and the source card marked, never the key-firms row), then the booking calendar. The v2 bands, FAQ and
// Related block gave way to the depth zone (src/content/depth/seo-for-immigration-lawyers.md). Its own look on this
// page: the jump list on the left and the summary on the right, the agency habits as run-in hairline rows, the
// mid-page CTA as the page's one marker band (no PriceBand here), the price as two plain lines side by side on white
// under a black rule (no button), and the open FAQ on fog.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-immigration-lawyers/';
const title = 'SEO for Immigration Lawyers | Found in Every Language';
const description =
  'SEO for immigration lawyers: case pages in each language with hreflang, trust against notarios, national reach, EOIR rules, policy changes, non-US firms.';
const depth = await getDepth('seo-for-immigration-lawyers');
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for immigration lawyers' }]}
  service={{ name: 'SEO for immigration lawyers', offer: false }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="stack"
    h1="SEO for immigration lawyers, found in every language you serve."
    lead="Clients search for green card, citizenship or asylum help in English or in their first language, near your office or far from it. We make your firm the one they find, in your city and beyond it."
    class="im-hero"
    form={{ who: 'your immigration practice', idPrefix: 'im-hero', label: 'immigration-hero', practiceArea: 'Immigration' }}
    formRow={false}
  >
    <figure slot="visual" class="im-hero__fig">
      <div class="im-hero__wide">
        <Shot tag="Cited by Google’s AI" tagSide="right" priority images={[shot(proof.nolaTankerSerpTop, { marks: ['aiChip', 'sourceCard'] })]} />
      </div>
      <div class="im-hero__phone">
        <Shot tag="Cited by Google’s AI" tagSide="right" tagSmall images={[shot(proof.nolaTankerSerpAnswer, { marks: ['aiChip'] })]} />
        <Shot class="im-hero__card" images={[shot(proof.nolaTankerSerpSource, { marks: ['sourceCard'] })]} />
      </div>
      <figcaption class="im-hero__say">
        <span class="im-hero__cap">For a PI firm in New Orleans. On one city search, Google’s AI answer named it a key firm.</span>
        <span class="im-hero__line">An immigration firm can hold its own city’s results page the same way, for each case type it takes.</span>
      </figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} authorLinkLabel="Fahim’s profile and record">
    <Band slot="mid" tone="marker" class="im-mid">
      <p class="im-mid__line">Fahim can check this language plan against your own site in a free, <span class="im-nowrap">30-minute</span> ranking review.</p>
      <Button />
    </Band>

    <Band slot="price" class="im-price">
      <div class="im-price__in">
        <p class="im-price__big">Immigration SEO runs from $2,000 a month with us, and we charge no setup fee. Fahim puts your number in writing before any work begins.</p>
        <p class="im-price__line">It covers the case pages in each language, the profile and reviews, links, site upkeep, call and form tracking and AI answer checks. See <a href="/seo-pricing/">law firm SEO pricing</a> for how the number is set.</p>
      </div>
    </Band>
  </DepthZone>

  <FinalCta heading="Which immigration cases could Google send you, and at what price?" writeHref="#im-hero-form">
    <p>Bring your list of case types. Fahim checks them on Google with you in a free 30-minute call and shows which page to build first.</p>
  </FinalCta>
</InnerPage>

<style>
  .im-hero__fig { display: grid; gap: 22px; }
  .im-hero__phone { display: grid; gap: 18px; }
  .im-hero__phone :global(.im-hero__card) { max-width: 322px; }
  .im-hero__wide { display: none; }
  @media (min-width: 760px) {
    .im-hero__wide { display: block; }
    .im-hero__phone { display: none; }
  }
  .im-hero__say { display: grid; gap: 8px; max-width: 46em; }
  .im-hero__cap { font-size: 17px; line-height: 1.45; color: var(--ink-2); }
  .im-hero__line { margin-top: 6px; font-size: var(--fs-lead); line-height: 1.4; font-weight: 600; color: var(--ink); letter-spacing: -.01em; max-width: 30em; }
  @media (min-width: 1000px) {
    .im-hero__say { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 48px; max-width: none; }
    .im-hero__line { grid-column: 2; grid-row: 1; margin-top: 0; }
  }
</style>

<style is:global>
  /* The booking band and the depth zone: fog, then white, with the usual section space. From 1000px the jump list
     sits on the left and the byline and summary on the right (the copy's order stays the same for readers). */
  @media (min-width: 1000px) {
    .lse-depth[data-depth='seo-for-immigration-lawyers'] .lse-depth__intro { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .lse-depth[data-depth='seo-for-immigration-lawyers'] .lse-depth__lede { grid-column: 2; grid-row: 1; }
    .lse-depth[data-depth='seo-for-immigration-lawyers'] .lse-depth__toc { grid-column: 1; grid-row: 1; }
    .lse-depth[data-depth='seo-for-immigration-lawyers'] .lse-depth__summary { font-size: clamp(19px, .5vw + 16px, 24px); line-height: 1.45; color: var(--ink); }
  }

  /* The agency habits: run-in hairline rows at the text's size, the bold lead in ink. */
  .lse-depth[data-depth='seo-for-immigration-lawyers'] .lse-prose > ul:not(.lse-check) { list-style: none; padding: 0; border-top: 2px solid var(--ink); }
  .lse-depth[data-depth='seo-for-immigration-lawyers'] .lse-prose > ul:not(.lse-check) > li { margin: 0; padding: 14px 0 15px; border-bottom: 1px solid var(--line-2); }
  .lse-depth[data-depth='seo-for-immigration-lawyers'] .lse-prose > ul:not(.lse-check) > li > strong:first-child { color: var(--ink); font-weight: 750; }

  /* The mid-page CTA: the page's one marker band (it has no PriceBand), the line large, the button under it. */
  .im-mid .lse-band__body { display: grid; gap: var(--s4); justify-items: start; }
  .im-mid__line { max-width: 24ch; font-size: clamp(30px, 2.2vw + 18px, 52px); font-weight: 800; line-height: 1.04; letter-spacing: -.032em; color: var(--ink); }
  .im-mid .lse-btn:hover { background: var(--paper); }
  .im-nowrap { white-space: nowrap; }

  /* The price: two plain lines under a black rule, side by side from 1000px, the link in the second. No button. */
  .im-price { padding-top: 0; }
  .im-price__in { display: grid; gap: var(--s3); padding-top: clamp(28px, 3vw, 40px); border-top: 2px solid var(--ink); }
  .im-price__big { max-width: 22em; font-size: clamp(22px, .9vw + 17px, 30px); font-weight: 750; line-height: 1.22; letter-spacing: -.02em; color: var(--ink); }
  .im-price__line { max-width: 30em; font-size: var(--fs-lead); line-height: 1.5; color: var(--ink-2); }
  .im-price__line a { font-weight: 700; color: var(--ink); }
  @media (min-width: 1000px) {
    .im-price__in { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(48px, 5vw, 96px); align-items: start; }
  }
</style>
