---
// /seo-for-immigration-lawyers/ from content/v2/seo-for-immigration-lawyers.md (practice set B).
// Hero: stacked, no form. H1 and line, then one city's results page wide on a fog block, with only the AI
// answer chip and the source card marked (judge ruling 1: never the key-firms row the PI hero marks). On
// phones the same capture shows as two readable crops. The booking calendar follows straight after.
// Then two languages, city and nationwide, trust, FAQ (the page's one price), close.
import Faq, { type FaqItem } from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import Band from '../../components/kit/Band.astro';
import BookingBand from '../../components/kit/BookingBand.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import SearchBox from '../../components/kit/SearchBox.astro';
import Split from '../../components/kit/Split.astro';
import Related from '../../components/practice-b/Related.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';

const faq: FaqItem[] = [
  {
    q: 'Should we build pages by visa type or by city?',
    html: 'Mostly by case type, because clients can live anywhere. City pages go where you have an office or attend court.',
  },
  {
    q: 'Can we rank in Spanish?',
    html: 'Yes, with real Spanish pages at their own address, checked by a fluent speaker. The same goes for any other language your team speaks.',
  },
  {
    q: 'Our attorneys speak a language you don’t. Can you still help?',
    html: 'Yes. Fahim plans the pages and the search work for every language. A fluent speaker at your firm checks every word before it goes live.',
  },
  {
    q: 'What does SEO for an immigration firm cost?',
    html: 'From $2,000 a month for everything it takes to rank, and there is no setup fee. You get your exact number in writing first. See <a href="/seo-pricing/">law firm SEO pricing</a>.',
    text: 'From $2,000 a month for everything it takes to rank, and there is no setup fee. You get your exact number in writing first.',
  },
  {
    q: 'Does this follow bar advertising rules?',
    html: 'Your state bar sets the rules, and your firm approves each page before it is published. No page promises an approval, a result or a timeline.',
  },
];
---
<InnerPage
  title="SEO for Immigration Lawyers | Found in Every Language"
  description="SEO for immigration lawyers: rank for the case types you take, in the languages your clients speak, in your city and beyond it."
  path="/seo-for-immigration-lawyers/"
  crumbs={[{ label: 'SEO for immigration lawyers' }]}
  service={{ name: 'SEO for immigration lawyers', offer: false }}
  faq={faq}
>
  <PageHero
    layout="stack"
    h1="SEO for immigration lawyers, found in every language you serve."
    lead="Clients search for a green card, citizenship or asylum help, often in Spanish and often far from your office. We make your firm the one they find, in your city and beyond it."
    class="im-hero"
  >
    <figure slot="visual" class="im-hero__fig">
      <div class="im-hero__wide">
        <Shot tag="Cited by Google’s AI" tagSide="right" priority images={[shot(proof.nolaTankerSerpTop, { marks: ['aiChip', 'sourceCard'] })]} />
      </div>
      <div class="im-hero__phone">
        <Shot tag="Cited by Google’s AI" tagSide="right" tagSmall images={[shot(proof.nolaTankerSerpAnswer, { marks: ['aiChip'] })]} />
        <Shot class="im-hero__card" images={[shot(proof.nolaTankerSerpSource, { marks: ['sourceCard'] })]} />
      </div>
      <figcaption class="im-hero__say">
        <span class="im-hero__cap">For a PI firm in New Orleans. On one city search, Google’s AI answer cites the firm and lists its page as a source.</span>
        <span class="im-hero__line">An immigration firm can hold its own city’s results page the same way, for each case type it takes.</span>
      </figcaption>
    </figure>
  </PageHero>

  <BookingBand
    heading="Choose a time for your ranking review."
    headingId="im-book-h"
    lead="Free, 30 minutes. Fahim runs your main case types on Google with you and shows who comes up."
    tone="fog"
  >
    <p slot="after">Prefer to write? Send your website through <a href="#im-final-name">the form at the end of this page</a>.</p>
  </BookingBand>

  <Band
    heading="One case type, searched in two languages."
    headingId="im-lang-h"
    lead="Each language gets real pages at their own address, checked by a fluent speaker at your firm. A translate button does not rank."
  >
    <Split ratio="6/6">
      <div slot="a" class="im-lang">
        <h3 class="im-lang__h">English</h3>
        <SearchBox
          label="English searches"
          caption="English searches from our keyword research."
          queries={[
            { text: 'how much does an immigration lawyer cost for green card', mark: 'green card' },
            { text: 'how much does immigration lawyer cost for citizenship', mark: 'citizenship' },
            { text: 'can i apply for asylum without a lawyer', mark: 'asylum' },
            { text: 'can a lawyer stop deportation', mark: 'deportation' },
          ]}
        />
      </div>
      <div slot="b" class="im-lang">
        <h3 class="im-lang__h">Spanish</h3>
        <SearchBox
          label="Spanish searches"
          caption="Example searches."
          queries={[
            { text: 'abogado de inmigración cerca de mí', mark: 'inmigración' },
            { text: 'cómo sacar la green card', mark: 'green card' },
            { text: 'abogado de asilo político', mark: 'asilo' },
          ]}
        />
      </div>
    </Split>
  </Band>

  <Band heading="Win your city first, then the case types that cross state lines." headingId="im-reach-h" tone="fog" wideHeading>
    <div class="im-reach">
      <Rows
        variant="inline"
        items={[
          { title: 'Your city:', text: 'your Google Business Profile, reviews, and city pages where you have an office or attend immigration court.' },
          { title: 'Nationwide:', text: 'a page for every case type you handle, in each language you serve.' },
        ]}
      />
      <p class="lse-small im-reach__note">As general information, federal rules let a lawyer in good standing in any one US state handle cases before USCIS and in immigration court, wherever the client lives. Your attorneys confirm what your own state bar allows in advertising.</p>
    </div>
  </Band>

  <Band heading="Pages a careful client can trust." headingId="im-trust-h" lead="Many readers have heard of scams. Every case-type page shows them a real attorney.">
    <div class="im-trust">
      <Rows
        class="im-trust__rows"
        items={[
          { text: 'The attorney’s name and bar admission, with a link to check it.' },
          { text: 'How the first consultation works, what it costs and in which languages.' },
          { text: 'No promises about approval or speed, on any page.' },
        ]}
      />
    </div>
  </Band>

  <Band heading="Immigration firms ask us." headingId="im-faq-h" tone="fog">
    <Faq items={faq} />
  </Band>

  <FinalCta heading="See who a client finds for your case types." formLabel="immigration-final" idPrefix="im-final" practiceArea="Immigration">
    <p>In 30 minutes, Fahim runs your main case-type searches with you and shows whether your firm comes up, in your city and beyond, and what to build first.</p>
  </FinalCta>
  <Related links={[{ label: 'SEO for criminal defense lawyers', href: '/seo-for-criminal-defense-lawyers/' }, { label: 'SEO for employment lawyers', href: '/seo-for-employment-lawyers/' }]} />
</InnerPage>

<style>
  .im-hero__fig { display: grid; gap: 22px; }
  .im-hero__phone { display: grid; gap: 18px; }
  .im-hero__phone :global(.im-hero__card) { max-width: 322px; }
  .im-hero__wide { display: none; }
  @media (min-width: 760px) {
    .im-hero__wide { display: block; }
    .im-hero__phone { display: none; }
  }
  .im-hero__say { display: grid; gap: 8px; max-width: 46em; }
  .im-hero__cap { font-size: 17px; line-height: 1.45; color: var(--ink-2); }
  .im-hero__line { margin-top: 6px; font-size: var(--fs-lead); line-height: 1.4; font-weight: 600; color: var(--ink); letter-spacing: -.01em; max-width: 30em; }
  @media (min-width: 1000px) {
    .im-hero__say { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 48px; max-width: none; }
    .im-hero__line { grid-column: 2; grid-row: 1; margin-top: 0; }
  }

  .im-lang { display: grid; gap: 16px; align-content: start; }
  .im-lang__h { font-size: 22px; }

  .im-reach { max-width: 860px; display: grid; gap: 20px; }
  .im-reach :global(.lse-row p) { font-size: var(--fs-lead); line-height: 1.45; }
  .im-reach__note { max-width: 44em; }

  .im-trust { max-width: 760px; }
  :global(.im-trust__rows .lse-row p) { font-size: var(--fs-lead); line-height: 1.4; color: var(--ink); }
</style>
