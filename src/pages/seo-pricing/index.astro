---
// /seo-pricing/. Copy: content/v3/seo-pricing.md (critic: content/v3/CRITIC-services.md). Facts: research/FACTS.md.
// The number first: the "hired one by one" breakdown is the hero visual (rows and total from src/data/pricing.ts,
// never retyped). The depth zone follows straight after it (src/content/depth/seo-pricing.md): the models and their
// rules, the drivers, the extras, what other agencies publish (the only market figures on the site, DEPTH-BRIEF 18,
// rulings 1 and 23), cost per lead with the 139 capture, the quote checklist, then the mid-page CTA, the situations,
// the terms on the one highlighter band, the open FAQ and the author box. The real calendar closes the page (no
// second form: the hero has one).
import Button from '../../components/Button.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import BookingBand from '../../components/kit/BookingBand.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import PriceCard from '../../components/kit/PriceCard.astro';
import Rows from '../../components/kit/Rows.astro';
import ShotSwap from '../../components/money/ShotSwap.astro';
import '../../components/services/services.css';
import { proof, shot } from '../../data/proof';
import { phoneProof } from '../../data/proof-money';
import { site } from '../../data/site';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const title = 'Law Firm SEO Pricing 2026 | From $2,000 a Month, All In';
const description =
  'Law firm SEO pricing for 2026: our price, the pricing models and their rules, what moves the number, extras, published prices, cost per lead and terms.';
const path = '/seo-pricing/';
const depth = await getDepth('seo-pricing');

// Depth section 3: what moves the monthly number.
const drivers = [
  { title: 'The market.', text: 'A busy city, where more firms chase the same searches, needs more pages and links each month than a quiet town.' },
  { title: 'The practice areas.', text: 'Each practice a firm wants to grow needs its own pages and its own links. Practices with more firms competing for them need more of both.' },
  { title: 'The offices.', text: 'Each real office needs its own page and its own Business Profile, with reviews to match.' },
  { title: 'The site’s starting point.', text: 'A new site, a neglected one and a penalized one each need different groundwork before new pages can rank.' },
];
// Supplementary H3 3: pricing patterns to refuse.
const traps = [
  { title: 'Counts in place of outcomes.', text: 'A tier that promises a set number of articles or links says nothing about calls.' },
  { title: 'A share of fees, or a fee per new client.', text: 'These tie the agency’s pay to the firm’s fees, which can run into state fee-sharing rules.' },
  { title: 'Long minimum terms.', text: 'The firm keeps paying for work that isn’t working, because leaving costs more.' },
  { title: 'Accounts in the agency’s name.', text: 'The firm pays to build assets it can’t take with it.' },
  { title: 'Return claims with no method.', text: 'A return figure with no inputs can’t be checked, so it proves nothing.' },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Law firm SEO pricing' }]}
  pageType="pricing"
  service={{ name: 'Law firm SEO', serviceType: 'Search engine optimization for law firms' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    class="cost-hero"
    h1="Law firm SEO pricing: one price, from $2,000 a month."
    lead="One price pays for all the work it takes to rank your firm. No setup fee, no packages to decode, and you pay month to month."
    form={{ title: 'Get your monthly number.', sub: 'Send your website. Fahim answers within an hour in business hours.', idPrefix: 'price-hero', label: 'pricing-hero' }}
    talk="Prefer a call?"
  >
    <PriceCard
      slot="visual"
      title="What each part costs when a firm buys it on its own"
      titleTag="h2"
      us="Every row above, with us: from $2,000 a month."
      usMark="from $2,000 a month"
    />
  </PageHero>

  <DepthZone depth={depth} authorLinkLabel="About S. M. Fahim">
    <div slot="drivers" class="bsv-rows"><Rows variant="inline" items={drivers} /></div>
    <figure slot="calls" class="cost-calls">
      <ShotSwap
        tag="139 calls"
        wide={[shot(proof.nolaCalls, { marks: ['total', 'growth'] })]}
        narrow={[shot(phoneProof.nolaCallsTotal, { marks: ['total', 'growth'] })]}
      />
    </figure>
    <div slot="traps" class="bsv-rows"><Rows variant="inline" items={traps} /></div>

    <Band slot="mid" tone="fog" class="bsv-mid">
      <p class="bsv-mid__line">Get your firm’s own number from Fahim, in writing, before any work starts.</p>
      <Button />
    </Band>

    <PriceBand
      slot="price"
      variant="plain"
      heading="No setup fee. No lock-in."
      headingId="terms-h"
      lead="One price from $2,000 a month covers the whole job, and you can stop in any month."
      class="cost-terms"
    />
  </DepthZone>

  <BookingBand
    id="book"
    heading="Ask Fahim for your law firm SEO price, in writing."
    headingId="book-h"
    lead="Choose a time below. In 30 minutes, Fahim checks your market live and tells you what the work would involve."
  >
    <Fragment slot="after">
      <p>Prefer to write? Email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or use <a href="#price-hero-site">the form at the top of this page</a>. Fahim answers within an hour in business hours.</p>
      <p>See <a class="lse-link" href="/law-firm-seo-services/">what the monthly work includes</a>.</p>
    </Fragment>
  </BookingBand>
</InnerPage>

<style is:global>
  /* Hero: on phones the card comes before the form (H1, line, card, form). */
  @media (max-width: 999px) {
    .cost-hero .lse-hero__grid { gap: 0; }
    .cost-hero .lse-hero__text { display: contents; }
    .cost-hero .lse-hero__visual { order: 1; margin-top: 32px; }
    .cost-hero .lse-hero__text .lse-hero__act { order: 2; margin-top: 40px; }
  }
  @media (min-width: 1000px) {
    .cost-hero .lse-hero__visual { padding-top: 40px; padding-bottom: 40px; }
  }

  /* The 139 capture under its paragraph, at the width of the text and a little more. */
  .cost-calls { max-width: 820px; }

  /* Terms on the highlighter: the heading, one line, the button. */
  .cost-terms .lse-price__lead { font-size: clamp(21px, .8vw + 16px, 28px); font-weight: 600; line-height: 1.35; max-width: 28em; }
</style>
