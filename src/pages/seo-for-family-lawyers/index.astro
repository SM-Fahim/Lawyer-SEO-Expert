---
// /seo-for-family-lawyers/. Copy: content/v3/seo-for-family-lawyers.md (critic: content/v3/CRITIC-practice-2.md).
// Facts: research/FACTS.md. The commercial top is the v2 build: a split hero (H1, line, then the jackknife #1 still
// cited by Google's AI a week later, on the fog panel), and the real calendar straight after it. The v2 bands, FAQ
// and Related block gave way to the depth zone (src/content/depth/seo-for-family-lawyers.md): the four searches in a
// SearchBox, the matter table, the protective order checklist, the AI page steps, a full fog mid-page CTA, the
// proposal mistakes as plain rows, the price as one large line on white (no PriceBand on this page), then the open
// FAQ on fog, the author box and FinalCta.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import BookingBand from '../../components/kit/BookingBand.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import SearchBox from '../../components/kit/SearchBox.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-family-lawyers/';
const title = 'SEO for Family Lawyers | The Answer They Keep Finding';
const description =
  "SEO for family lawyers: the searches to win, a page per matter, safe protective order pages, the Map, reviews and rules, and Google's AI answers.";
const depth = await getDepth('seo-for-family-lawyers');

// "Family law SEO mistakes that cost consultations": plain rows, no glyph.
const mistakes = [
  { text: 'A national template that quotes no state’s rules, or the wrong state’s.' },
  { text: 'Statistics with no primary source behind them.' },
  { text: 'One page per town with only the town name changed.' },
  { text: 'Review requests sent only to happy clients, or with suggested wording.' },
  { text: '“Specialist” for a lawyer with no certification.' },
  { text: 'Pop-ups and tracking scripts on safety pages.' },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for family lawyers' }]}
  service={{ name: 'SEO for family lawyers' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    class="fam-hero"
    h1="SEO for family lawyers: be the answer they find again and again."
    lead="Divorce and custody clients research for a long time before they call. We write the pages Google ranks and its AI quotes, so your firm is the name they keep meeting."
  >
    <figure slot="visual" class="fam-fig">
      <Shot tag="Still cited a week later" tagSmall tagSide="right" priority images={[shot(proof.nolaJackknife, { marks: ['aiChip', 'result'] })]} />
      <figcaption class="lse-small">For a PI firm in New Orleans: #1 on Google, and a week later its AI was still citing the page. A family law answer can hold its place the same way while a parent researches.</figcaption>
    </figure>
  </PageHero>

  <BookingBand
    heading="Talk it through with Fahim first."
    headingId="book-h"
    class="fam-book"
    lead="It is free and takes 30 minutes. Fahim runs your city’s divorce and custody searches with you."
  />

  <DepthZone depth={depth} authorLinkLabel="More about S. M. Fahim">
    <div slot="searches" class="fam-searches">
      <SearchBox
        label="Questions people research before calling a family lawyer"
        caption="From our keyword research."
        queries={[
          { text: 'how much does a divorce lawyer cost', mark: 'how much' },
          { text: 'do you need a lawyer for divorce' },
          { text: 'how to file for custody in texas without a lawyer', mark: 'without a lawyer' },
          { text: 'questions to ask lawyer when getting a divorce', mark: 'questions to ask' },
        ]}
      />
    </div>
    <div slot="mistakes" class="fam-rows"><Rows items={mistakes} /></div>

    <Band slot="mid" tone="fog" class="fam-mid">
      <p class="fam-mid__line">See which family law pages Google’s AI quotes in your state.</p>
      <Button />
    </Band>

    <Band slot="price" class="fam-price">
      <p class="fam-price__line">SEO for a family law practice starts <span class="lse-mk">from $2,000 a month</span>, with no setup fee.</p>
      <p class="fam-price__more">Fahim writes down your monthly figure before any work is done. See <a href="/seo-pricing/">law firm SEO pricing</a>.</p>
    </Band>
  </DepthZone>

  <FinalCta heading="See which family law firm parents find first in your county." formLabel="fam-final" idPrefix="fam-final" practiceArea="Family law">
    In 30 minutes, Fahim searches your main divorce and custody questions with you and shows which page to write first.
  </FinalCta>
</InnerPage>

<style is:global>
  .fam-fig { display: grid; gap: 12px; }
  .fam-book { border-top: 1px solid var(--line); }
  /* The calendar band and the depth zone are both white: one section's space between them, not two. */
  .lse-depth[data-depth='seo-for-family-lawyers'] > .lse-depth__part--first { padding-top: 0; }

  /* The four searches at the text's measure, under their lead-in line. */
  .fam-searches { max-width: 35em; }
  .lse-depth__slot:has(> .fam-searches) { margin-top: 24px; }

  /* The proposal mistakes: hairline rows at the text's size and measure, read as part of the copy. */
  .fam-rows { max-width: 35em; font-size: clamp(17px, .25vw + 16px, 19px); line-height: 1.6; }
  .fam-rows .lse-row { padding: 14px 0 15px; }
  .fam-rows .lse-row p { max-width: none; color: var(--ink); font-weight: 500; }
  .lse-depth__slot:has(> .fam-rows) { margin-top: 20px; }
  .lse-depth__slot:has(> .fam-rows) + .lse-prose { margin-top: 28px; }

  /* Mid-page CTA: a full fog band, the one line set large, the button under it. */
  .fam-mid .lse-band__body { display: grid; gap: var(--s4); justify-items: start; }
  .fam-mid__line { max-width: 26ch; font-size: var(--fs-h2); font-weight: 800; line-height: 1.02; letter-spacing: -.032em; color: var(--ink); }

  /* The price: one large line under an ink rule at the text's measure, the details under it. No button. */
  .lse-depth .fam-price { padding-top: 0; }
  .fam-price .lse-band__body { max-width: 35em; padding-top: var(--s4); border-top: 2px solid var(--ink); }
  .fam-price__line { font-size: clamp(24px, 1vw + 18px, 32px); font-weight: 750; line-height: 1.2; letter-spacing: -.02em; color: var(--ink); }
  .fam-price__more { margin-top: var(--s3); color: var(--ink-2); }
  .fam-price__more a { font-weight: 700; }
</style>
