---
// /seo-for-family-lawyers/ from content/v2/seo-for-family-lawyers.md. Clients research for a long time, so
// the hero is the page that kept its place: the jackknife #1, still cited by Google's AI a week later. No form
// in the hero: the real calendar follows. Then the questions they ask, one page per topic, the Map calls once
// they're ready, privacy and the bar, FAQ.
import Faq, { type FaqItem } from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import Band from '../../components/kit/Band.astro';
import BookingBand from '../../components/kit/BookingBand.astro';
import NumPair from '../../components/kit/NumPair.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import SearchBox from '../../components/kit/SearchBox.astro';
import Split from '../../components/kit/Split.astro';
import Related from '../../components/practice-a/Related.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';

const faq: FaqItem[] = [
  {
    q: 'Have you worked with family law firms?',
    html: 'The results we can show are from injury firms. Ranking, the Map and AI answers work the same way, and every page we write for you is written for family law readers.',
  },
  {
    q: 'Is it worth ranking for “without a lawyer” searches?',
    html: 'Yes, if the page is honest and points to one next step. Many readers find their case is harder than they hoped, and they remember who said so.',
  },
  {
    q: 'What does family law SEO cost?',
    html: 'From $2,000 a month, with everything it takes to rank included and no setup fee. Fahim puts your number in writing first. See <a href="/seo-pricing/">law firm SEO pricing</a>.',
  },
  {
    q: 'Can Google’s AI recommend our firm?',
    html: 'Nobody can switch that on. We write pages its AI can quote and check its answers for your key divorce and custody searches every month.',
  },
];
---
<InnerPage
  title="SEO for Family Lawyers | The Answer They Keep Finding"
  description="SEO for family lawyers: rank for the divorce, custody and cost questions clients research, and be the firm they call when ready. Book a ranking review."
  path="/seo-for-family-lawyers/"
  crumbs={[{ label: 'SEO for family lawyers' }]}
  service={{ name: 'SEO for family lawyers' }}
  faq={faq}
>
  <PageHero
    class="fam-hero"
    h1="SEO for family lawyers: be the answer they find again and again."
    lead="Divorce and custody clients research for a long time before they call. We write the pages Google ranks and its AI quotes, so your firm is the name they keep meeting."
  >
    <figure slot="visual" class="fam-fig">
      <Shot tag="Still cited a week later" tagSmall tagSide="right" priority images={[shot(proof.nolaJackknife, { marks: ['aiChip', 'result'] })]} />
      <figcaption class="lse-small">For a PI firm in New Orleans: #1 on Google, and a week later its AI was still citing the page. A family law answer can hold its place the same way while a parent researches.</figcaption>
    </figure>
  </PageHero>

  <BookingBand
    heading="Talk it through with Fahim first."
    headingId="book-h"
    class="fam-book"
    lead="It is free and takes 30 minutes. He runs your city’s divorce and custody searches with you."
  />

  <Band heading="What they ask before they call anyone." headingId="ask-h" tone="fog">
    <div class="fam-ask">
      <SearchBox
        label="Questions people research before calling a family lawyer"
        caption="Real searches from our keyword research."
        queries={[
          { text: 'how much does a divorce lawyer cost', mark: 'how much' },
          { text: 'do you need a lawyer for divorce' },
          { text: 'how to file for custody in texas without a lawyer', mark: 'without a lawyer' },
          { text: 'questions to ask lawyer when getting a divorce', mark: 'questions to ask' },
        ]}
      />
      <p class="lse-lead">We answer each one plainly, in your firm’s voice. Readers remember the firm that was honest with them.</p>
    </div>
  </Band>

  <Band heading="A page for each part of family law you take." headingId="topics-h">
    <div class="fam-topics">
      <Rows
        variant="inline"
        items={[
          { title: 'Divorce.', text: 'How it works in your state, and what changes when it is contested.' },
          { title: 'Custody.', text: 'How decisions are made, and how a parent can prepare.' },
          { title: 'Support.', text: 'How child and spousal support are worked out.' },
          { title: 'Changing an order.', text: 'For people whose life has moved on since the last one.' },
        ]}
      />
      <p class="fam-topics__line">Topics you don’t take get no page.</p>
    </div>
  </Band>

  <Band heading="When they’re ready, the Map gets the call." headingId="ready-h" tone="fog">
    <Split ratio="5/7" align="center">
      <div slot="a" class="fam-num">
        <NumPair after={139} afterLabel="calls" decorative={false} />
        <p class="lse-small">For a PI firm in New Orleans, by Google’s count: June to October 2026, up 39% on a year before. We run your profile and reviews the same way.</p>
      </div>
      <Shot slot="b" images={[shot(proof.nolaCalls, { marks: ['total', 'growth'] })]} />
    </Split>
  </Band>

  <Band heading="Private by design, and inside your bar’s rules." headingId="private-h">
    <div class="fam-private">
      <Rows
        variant="plain"
        items={[
          { text: 'Forms ask only what your team needs to reply.' },
          { text: 'Replies to reviews never mention a case.' },
          { text: '“Specialist” appears only if your attorney is certified and your state allows it.' },
        ]}
      />
      <p class="fam-private__line">You approve every page before it goes live.</p>
    </div>
  </Band>

  <Band heading="Common questions from family law firms." headingId="faq-h" tone="fog">
    <Faq items={faq} />
    <Related
      links={[
        { label: 'SEO for estate planning lawyers', href: '/seo-for-estate-planning-lawyers/' },
        { label: 'SEO for bankruptcy lawyers', href: '/seo-for-bankruptcy-lawyers/' },
        { label: 'law firm SEO services', href: '/law-firm-seo-services/' },
      ]}
    />
  </Band>

  <FinalCta heading="See which firm a parent finds first in your city." formLabel="fam-final" idPrefix="fam-final" practiceArea="Family law">
    In 30 minutes, Fahim searches your main family law questions with you and shows which page to write first.
  </FinalCta>
</InnerPage>

<style is:global>
  .fam-fig { display: grid; gap: 12px; }
  .fam-book { border-top: 1px solid var(--line); }
  .fam-ask { display: grid; gap: var(--s4); max-width: 820px; }
  .fam-topics, .fam-private { max-width: 860px; }
  .fam-topics__line, .fam-private__line { margin-top: var(--s4); font-weight: 700; color: var(--ink); }
  .fam-num { display: grid; gap: 22px; }
  .fam-num .lse-small { font-size: 17px; color: var(--ink-2); max-width: 26em; }
  .fam-private .lse-row p { font-size: clamp(20px, .6vw + 16px, 26px); font-weight: 600; letter-spacing: -.015em; line-height: 1.3; color: var(--ink); max-width: 30em; }
</style>
