---
// /about/. Copy: content/v2/about.md. Facts: research/FACTS.md.
// A support page: it opens on the two people you work with and one result line (critique 2.2), then the people, the two
// services with a proof each, the terms, a short FAQ and the form. No form near the top (CRITIQUE: support
// page, not a landing page).
import Faq, { type FaqItem } from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import Band from '../../components/kit/Band.astro';
import Bio from '../../components/kit/Bio.astro';
import Face from '../../components/kit/Face.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PhoneShot from '../../components/kit/PhoneShot.astro';
import Q from '../../components/kit/Q.astro';
import Rows from '../../components/kit/Rows.astro';
import Split from '../../components/kit/Split.astro';
import { fahim, josh } from '../../data/people';
import { proof, shot } from '../../data/proof';
import { fahimSchema, joshSchema, site } from '../../data/site';
import InnerPage from '../../layouts/InnerPage.astro';

const path = '/about/';
const pageUrl = new URL(path, site.url).href;

const faq: FaqItem[] = [
  {
    q: 'Who will we talk to?',
    html: 'Fahim is on every call. Josh Henderson, our Sales Director, joins calls with firms as well.',
  },
  {
    q: 'Do you work with our practice area?',
    html: 'We have pages for eleven practice areas, from personal injury to environmental law. Our published results so far come from personal injury firms.',
  },
  {
    q: 'Is Josh our lawyer?',
    html: 'No. Josh gives marketing and business input, not legal advice. Contacting us creates no attorney-client relationship.',
  },
  {
    q: 'Do you guarantee rankings?',
    html: 'No. Google decides rankings. On a free 30-minute call, Fahim gives you a realistic view for your firm.',
  },
];

const aboutPage = {
  '@type': 'AboutPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'About Lawyer SEO Expert',
  mainEntity: {
    '@id': `${site.url}/#org`,
    employee: [{ '@id': fahimSchema['@id'] }, { '@id': joshSchema['@id'] }],
  },
};
---
<InnerPage
  title="About Lawyer SEO Expert | Who You Work With"
  description="Meet the people who get law firms ranked on Google, the Map and AI answers. Fahim leads every account, and Josh Henderson joins calls with firms."
  path={path}
  crumbs={[{ label: 'About' }]}
  pageType="company"
  faq={faq}
  schema={[aboutPage, fahimSchema, joshSchema]}
>
  <PageHero
    class="ab-top"
    h1="About us: the people who get law firms found first."
    lead="We put law firms at the top of Google, the Map and AI answers, so more of the right clients call. Here is who you would work with."
  >
    <figure slot="visual" class="ab-hero">
      <div class="ab-hero__people">
        {[fahim, josh].map((p) => (
          <div class="ab-hero__person">
            <Face person={p} size="md" priority />
            <p><b>{p.display}</b><span>{p.role}</span></p>
          </div>
        ))}
      </div>
      <figcaption class="ab-hero__result">A PI firm in New Orleans: <span class="lse-mk">139 calls</span> from Google in five months.</figcaption>
    </figure>
  </PageHero>

  <Band heading="You work with Fahim. Josh joins the calls." headingId="people-h" tone="fog">
    <div class="ab-people">
      <Bio
        person={fahim}
        size="sm"
        role="Law firm SEO expert"
        line="Plans your firm’s SEO, is on every call and checks each piece of work. A small production team helps, with no account manager in between."
      >
        <p class="ab-people__link"><a class="lse-link" href={fahim.href}>More about Fahim</a></p>
      </Bio>
      <Bio
        person={josh}
        size="sm"
        role="Sales Director"
        line="A Texas-licensed attorney since 2008 who has run a practice and advised 50+ law firms. Josh joins calls with firms."
      >
        <p class="ab-people__link"><a class="lse-link" href={josh.href}>More about Josh</a></p>
      </Bio>
    </div>
  </Band>

  <Band heading="Two things, both built around rankings." headingId="do-h">
    <Split ratio="5/7" align="center">
      <div slot="a" class="ab-do">
        <h3>SEO for law firms.</h3>
        <p>Everything it takes to rank in one monthly price, from $2,000 a month.</p>
        <p><a class="lse-link" href="/law-firm-seo-services/">Law firm SEO services</a></p>
      </div>
      <figure slot="b" class="ab-fig">
        <Shot tag="#1" tagSide="right" images={[shot(proof.nolaJackknife, { marks: ['aiChip', 'result'] })]} />
        <figcaption><b><Q text="jackknife truck accident Louisiana" /></b>: #1 for a PI firm in New Orleans, after about three months of groundwork.</figcaption>
      </figure>
    </Split>
    <Split ratio="5/7" align="center" rule>
      <div slot="a" class="ab-do">
        <h3>Websites built to rank.</h3>
        <p>From $2,000 for the build, fixed quote in writing.</p>
        <p><a class="lse-link" href="/lawyer-web-design-development/">Lawyer web design</a></p>
      </div>
      <figure slot="b" class="ab-fig ab-fig--phone">
        <PhoneShot width={240} tag="Our build" tagSmall tagSide="right" images={[shot(proof.nolaSiteHomePhone)]} />
        <figcaption>The site we built for a PI firm in New Orleans.</figcaption>
      </figure>
    </Split>
  </Band>

  <Band heading="How we work with a firm." headingId="how-h" tone="fog">
    <Rows
      class="ab-terms"
      items={[
        { text: 'Your monthly number comes in writing before work starts. No setup fee.' },
        { text: 'Month to month. Stop in any month.' },
        { text: 'You or your ethics counsel approve every page before it goes live.' },
        { text: 'Everything we build is yours to keep.' },
      ]}
    />
  </Band>

  <Band heading="Questions about working together." headingId="faq-h">
    <Faq items={faq} />
  </Band>

  <FinalCta heading="Talk to the people behind Lawyer SEO Expert about your calls and your costs.">
    <p>In 30 minutes, Fahim and Josh look at what would bring your firm more calls first, and what that work costs.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  /* Hero: the two people you work with on the fog panel, and one result line under them. */
  .ab-hero { display: grid; gap: clamp(20px, 2.4vw, 32px); margin: 0; }
  .ab-hero__people { display: flex; flex-wrap: wrap; gap: clamp(24px, 3vw, 48px); }
  .ab-hero__person { display: grid; gap: 12px; justify-items: start; }
  .ab-hero__person p { display: grid; gap: 2px; font-size: 17px; line-height: 1.35; color: var(--ink-2); }
  .ab-hero__person b { font-size: 19px; color: var(--ink); }
  .ab-hero .ab-hero__result { font-size: clamp(19px, .5vw + 16px, 23px); font-weight: 700; line-height: 1.35; letter-spacing: -.01em; color: var(--ink); max-width: 26em; }
  @media (max-width: 759px) {
    .ab-hero__people { gap: 16px; flex-wrap: nowrap; }
    .ab-hero__person { flex: 1 1 0; min-width: 0; }
    .ab-hero__person .lse-face--md { width: 100%; max-width: 150px; }
  }
  .ab-people { max-width: 900px; }
  .ab-people__link { margin-top: 12px; }
  .ab-do { display: grid; gap: 12px; align-content: start; }
  .ab-do h3 { font-size: clamp(30px, 1.6vw + 20px, 44px); letter-spacing: -.03em; }
  .ab-do p { font-size: var(--fs-lead); line-height: 1.45; color: var(--ink-2); max-width: 22em; }
  .ab-fig { display: grid; gap: 14px; margin: 0; }
  .ab-fig figcaption { font-size: 17px; color: var(--ink-2); max-width: 38em; }
  .ab-fig figcaption b { color: var(--ink); }
  .ab-terms { max-width: 900px; }
  .ab-terms .lse-row { padding: 22px 0 24px; }
  .ab-terms .lse-row p { font-size: clamp(21px, .8vw + 16px, 28px); font-weight: 700; letter-spacing: -.02em; line-height: 1.3; color: var(--ink); max-width: 32em; }
</style>
