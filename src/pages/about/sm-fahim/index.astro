---
// /about/sm-fahim/. Copy: content/v2/about-sm-fahim.md. Facts: research/FACTS.md sections 1, 3 and 4.
// A name-search page that opens on what firms get from Fahim: three law firm results, big, then the record from
// before law firms, then the engineering background. No stats band and no timeline.
// Proof notes: the deck's calls-rudin.webp is the 139 chart (proof.nolaCalls, Jun to Oct 2026); LCME's own
// calls-rudin.webp (May to Sept, 119 calls) is not approved. The Idiya screenshot is left out: its totals don't
// match FACTS. $900K, $2.7M and $36M are in PRICES_BY_PAGE for this page only (FACTS 3).
import Faq, { type FaqItem } from '../../../components/Faq.astro';
import FinalCta from '../../../components/FinalCta.astro';
import Shot from '../../../components/Shot.astro';
import Band from '../../../components/kit/Band.astro';
import Face from '../../../components/kit/Face.astro';
import NumPair from '../../../components/kit/NumPair.astro';
import PageHero from '../../../components/kit/PageHero.astro';
import Q from '../../../components/kit/Q.astro';
import Rows from '../../../components/kit/Rows.astro';
import Split from '../../../components/kit/Split.astro';
import { fahim } from '../../../data/people';
import { proof, shot } from '../../../data/proof';
import { fahimSchema, site } from '../../../data/site';
import InnerPage from '../../../layouts/InnerPage.astro';

const path = '/about/sm-fahim/';
const pageUrl = new URL(path, site.url).href;

const faq: FaqItem[] = [
  {
    q: 'Will Fahim really be on our calls?',
    html: 'Yes. Fahim leads every account and is on every call, starting with the free ranking review.',
  },
  {
    q: 'Does Fahim work alone?',
    html: 'No. A small team helps with production, and Fahim reviews all of it.',
  },
  {
    q: 'Is Fahim a lawyer?',
    html: 'No. Fahim is an engineer and law firm SEO expert. <a href="/about/josh-henderson/">Josh Henderson</a>, our Sales Director, is a Texas attorney who joins calls with firms.',
    text: 'No. Fahim is an engineer and law firm SEO expert. Josh Henderson, our Sales Director, is a Texas attorney who joins calls with firms.',
  },
  {
    q: 'Does Fahim build websites too?',
    html: 'Yes. Fahim’s team built the sites for the PI firms in El Paso and New Orleans. See <a href="/lawyer-web-design-development/">lawyer web design</a>.',
    text: 'Yes. Fahim’s team built the sites for the PI firms in El Paso and New Orleans. See lawyer web design.',
  },
];

const profile = {
  '@type': 'ProfilePage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'S. M. Fahim',
  mainEntity: {
    ...fahimSchema,
    jobTitle: 'Law firm SEO expert',
    url: pageUrl,
    knowsAbout: ['Search engine optimization', 'Law firm marketing', 'Web development'],
    sameAs: [fahim.linkedin],
  },
};
---
<InnerPage
  title="S. M. Fahim | SEO Lead for Law Firms | Lawyer SEO Expert"
  description="S. M. Fahim leads the SEO for every law firm we work with. See the results: 139 Map calls in five months for a PI firm, and pages at #1 on Google."
  path={path}
  crumbs={[{ label: 'About', href: '/about/' }, { label: 'S. M. Fahim' }]}
  pageType="company"
  faq={faq}
  schema={[profile]}
>
  <PageHero
    h1="S. M. Fahim, the SEO lead on every law firm account."
    lead="Fahim plans the work that gets law firms found on Google, the Map and AI answers. Fahim joins every call and reviews everything the team makes, so you always talk to the person who plans your rankings."
    panel={false}
  >
    <p slot="text" class="fa-li"><a class="lse-link" href={fahim.linkedin} rel="me noopener">Fahim on LinkedIn</a></p>
    <Face slot="visual" person={fahim} size="lg" priority class="fa-face" />
  </PageHero>

  <Band heading="What Fahim’s work has done for law firms." headingId="results-h" tone="fog">
    <Split ratio="7/5" align="center">
      <figure slot="a" class="fa-fig">
        <Shot tag="139 calls" tagSide="right" images={[shot(proof.nolaCalls, { marks: ['total', 'growth'] })]} />
        <figcaption class="lse-small">June to October 2026: 139 calls, up 39% on the same months of 2025.</figcaption>
      </figure>
      <div slot="b" class="fa-res">
        <h3>A PI firm in New Orleans: 139 calls from its Google profile in five months.</h3>
        <p>39% more than the year before, by Google’s count. Fahim built the firm’s SEO system and leads its marketing.</p>
      </div>
    </Split>
    <Split ratio="5/7" align="center" rule bFirst>
      <div slot="a" class="fa-res">
        <h3>The same firm’s new pages reached #1 on Google within 16 hours.</h3>
        <p>After about three months of groundwork. <b><Q text="jackknife truck accident Louisiana" /></b> ranked #1, and Google’s AI still cited it a week later.</p>
      </div>
      <Shot slot="b" tag="#1" tagSide="right" images={[shot(proof.nolaJackknife, { marks: ['result', 'aiChip'] })]} />
    </Split>
    <Split ratio="7/5" align="center" rule>
      <div slot="a" class="fa-fig">
        <NumPair before={9} after={23} beforeLabel="calls in six months before us" afterLabel="calls in three months with us" />
        <Shot tag="23 calls" tagSide="right" images={[shot(proof.elpasoCallsAfter, { marks: ['total'] })]} />
      </div>
      <div slot="b" class="fa-res">
        <h3>A PI firm in El Paso: 23 calls in three months, up from 9 in six.</h3>
        <p>Fahim’s team built the firm’s website too.</p>
      </div>
    </Split>
    <p class="fa-denver">For a law firm in Denver, Fahim built a client portal and intake, and still maintains its security.</p>
  </Band>

  <Band heading="Other businesses Fahim has grown." headingId="before-h">
    <div class="fa-pair">
      <NumPair before="$900K" after="$2.7M" />
      <div class="fa-res">
        <h3>Idiya, New Zealand: online sales rose from $900K to $2.7M over 10 months.</h3>
        <p>Across two stores, in 2021, with Fahim as head of marketing.</p>
      </div>
    </div>
    <div class="fa-pair fa-pair--rule">
      <NumPair before="near 0" after="19K" />
      <Split ratio="5/7">
        <div slot="a" class="fa-res">
          <h3>Breakthrough Maths, Ireland: 19K visits a month, up from near zero.</h3>
          <p>It became Ireland’s #1 maths grinds provider. Visits measured by Semrush.</p>
        </div>
        <Shot slot="b" tag="19K a month" tagSide="right" images={[shot(proof.breakthroughTraffic, { marks: ['traffic'] })]} />
      </Split>
    </div>
    <p class="lse-lead fa-record">In all: 6.5 years, 67+ businesses in 4 countries, 200+ websites, and 50+ businesses ranked on Google. Together, those clients earn $36M+ a year.</p>
  </Band>

  <Band heading="An engineer who tests before trusting." headingId="eng-h" tone="fog">
    <Rows
      class="fa-eng"
      variant="big"
      items={[
        { title: 'Mechatronics engineering, RUET.', text: 'A BSc in measuring a system, changing one part and measuring again.' },
        { title: 'NASA Space Apps Challenge 2017.', text: 'Named a “Galactic Problem Solver”.' },
        { title: 'A Python blog, 2018.', text: 'It outranked W3Schools within three months.' },
      ]}
    />
  </Band>

  <Band heading="Before your call with Fahim." headingId="faq-h">
    <Faq items={faq} />
  </Band>

  <FinalCta heading="Put your firm’s rankings in front of Fahim." formLabel="fahim-final" idPrefix="fahim-final">
    <p>In 30 minutes, Fahim looks at where your firm ranks for the searches that matter and what would bring more calls first.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  .fa-li { font-size: 18px; }
  .fa-face { margin-left: auto; }
  .fa-fig { display: grid; gap: 22px; margin: 0; align-content: start; }
  .fa-res { display: grid; gap: 12px; align-content: start; }
  .fa-res h3 { font-size: clamp(26px, 1.2vw + 18px, 38px); letter-spacing: -.03em; line-height: 1.08; max-width: 18em; }
  .fa-res p { font-size: var(--fs-lead); line-height: 1.45; color: var(--ink-2); max-width: 28em; }
  .fa-res p b { color: var(--ink); }
  .fa-denver { margin-top: clamp(48px, 6vw, 80px); padding-top: var(--s4); border-top: 1px solid var(--line-2); font-size: var(--fs-lead); color: var(--ink-2); max-width: 40em; }
  .fa-pair { display: grid; gap: 28px; }
  .fa-pair .lse-nums { --n: clamp(44px, 9vw + 10px, 128px); }
  .fa-pair--rule { margin-top: clamp(48px, 6vw, 80px); padding-top: clamp(48px, 6vw, 80px); border-top: 1px solid var(--line-2); }
  .fa-record { margin-top: clamp(48px, 6vw, 80px); padding-top: var(--s4); border-top: 2px solid var(--ink); color: var(--ink); font-weight: 600; max-width: 34em; }
  .fa-eng { max-width: 900px; }
  @media (max-width: 999px) {
    .fa-face { margin-left: 0; }
  }
</style>
