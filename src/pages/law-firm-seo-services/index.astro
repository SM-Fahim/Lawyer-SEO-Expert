---
// /law-firm-seo-services/. Copy: content/v3/law-firm-seo-services.md (critic: content/v3/CRITIC-services.md).
// Facts: research/FACTS.md. The commercial top is v2's hero as built (form row, then the #1 frame: the page's only
// capture). The depth zone follows straight after it: src/content/depth/law-firm-seo-services.md, with the Rows and
// the practice list passed in as slots, the mid-page CTA after the main zone, and the price band (struck total from
// src/data/pricing.ts) above the open FAQ. Then the author box and the closing CTA.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import PracticeLinks from '../../components/PracticeLinks.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import Q from '../../components/kit/Q.astro';
import Rows from '../../components/kit/Rows.astro';
import ShotSwap from '../../components/money/ShotSwap.astro';
import '../../components/services/services.css';
import { fadeRight, proof, shot } from '../../data/proof';
import { phoneProof } from '../../data/proof-money';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const title = 'Law Firm SEO Services | Top of Google, the Map and AI';
const description =
  'Law firm SEO services in the order we work: month 1 data, competitors, law and fixes, then pages, the profile and links, counted in calls.';
const path = '/law-firm-seo-services/';
const depth = await getDepth('law-firm-seo-services');

const wtdTitle = [{ l: 2, t: 40, w: 49, h: 19 }];

// Depth section 4: the five layers of a firm site.
const layers = [
  { title: 'Home page.', text: 'The firm, its offices and its main practices, with the phone number in easy reach.' },
  { title: 'Practice pages.', text: 'One for each practice area, such as personal injury or family law.' },
  { title: 'Case-type pages.', text: 'One for each case type that clients search on its own, such as truck accidents.' },
  { title: 'Answer pages.', text: 'Questions clients have before they pick up the phone, such as what to do after a crash.' },
  { title: 'Office pages.', text: 'One for each real office, with the lawyers there, directions and the areas it serves.' },
];
// Depth section 5: four reasons to link.
const reasons = [
  { title: 'Local presence.', text: 'The firm’s real community work, written up where local sites can cite it.' },
  { title: 'Useful pages.', text: 'Deadline guides and checklists that other sites want to send their readers to.' },
  { title: 'Accurate listings.', text: 'Bar association, court and legal directory profiles that name the firm correctly.' },
  { title: 'Lawyers as sources.', text: 'Comment on local cases and law changes that journalists can quote.' },
];
// Supplementary H3 4: what we won't do, and why.
const refuse = [
  { title: 'A page for every town in reach.', text: 'Pages that swap one town’s name for another fit Google’s description of doorway abuse.' },
  { title: 'Bought or swapped links.', text: 'Google’s spam policies treat both as link spam, and the firm’s rankings carry the risk.' },
  {
    title: 'A guaranteed position.',
    text: 'Google decides rankings, so no agency can promise one. Our <a href="/law-firm-seo-consultant/">guide to vetting an SEO consultant</a> covers the other promises to walk away from.',
  },
  { title: 'Reports that hide a drop.', text: 'A higher average position number means a lower ranking, so a move from 29 to 34 is a fall.' },
  {
    title: 'Technical busywork.',
    text: 'Google’s <a href="https://developers.google.com/crawling/docs/crawl-budget">crawl budget guide</a> is aimed at sites with about a million pages or more, so most law firm sites can skip it.',
  },
  { title: 'Pages made in bulk.', text: 'Google’s scaled content policy covers pages made mainly to rank, whoever or whatever wrote them.' },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Law firm SEO services' }]}
  service={{ name: 'Law firm SEO services', serviceType: 'Search engine optimization for law firms' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    visualFirst
    class="svc-hero"
    h1="Law firm SEO services that turn searches into calls."
    lead="Our lawyer SEO services put your firm where clients look first: the top of Google, the Map and Google’s AI answers."
    form={{ idPrefix: 'svc-hero', label: 'services-hero' }}
  >
    <figure slot="visual" class="svc-hero__fig">
      <ShotSwap
        tag="#1"
        priority
        wide={[shot(proof.nolaWtdQuery), shot(proof.nolaWtdRank, { marks: wtdTitle, alt: 'A New Orleans PI firm’s page, What to Do After a Truck Accident, as the first result on Google' })]}
        narrow={[shot(phoneProof.wtdQuery), fadeRight(shot(phoneProof.wtdRank, { marks: ['title'] }))]}
      />
      <figcaption><b><Q text="what to do after a truck accident in New Orleans" /></b>: a PI firm’s page in New Orleans ranked #1.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} authorLinkLabel="More about Fahim">
    <figure slot="proof" class="lse-depth__proof">
      <ShotSwap
        tag="139 calls"
        tagSide="left"
        wide={[shot(proof.nolaCallsSummary, { marks: ['range', 'growth'] })]}
        narrow={[shot(proof.nolaCallsSummary, { marks: ['range', 'growth'], phone: false })]}
      />
      <figcaption><b>139 calls in five months, up 39%</b><span>A PI firm in New Orleans: calls from its Google Business Profile, June to October 2026, by Google’s own count.</span></figcaption>
    </figure>
    <div slot="layers" class="bsv-rows"><Rows variant="inline" items={layers} /></div>
    <div slot="practices" class="bsv-practice"><PracticeLinks /></div>
    <div slot="reasons" class="bsv-rows"><Rows variant="inline" items={reasons} /></div>
    <div slot="refuse" class="bsv-rows"><Rows variant="inline" items={refuse} /></div>

    <Band slot="mid" tone="fog" class="bsv-mid">
      <p class="bsv-mid__line">Fahim will map your first 90 days and put the price in writing.</p>
      <Button />
    </Band>

    <PriceBand
      slot="price"
      variant="total"
      heading="All seven parts, one monthly price."
      headingId="price-h"
      lead="Agencies often quote SEO one part at a time."
      us="With us, all seven: from $2,000 a month. No setup fee."
      usMark="from $2,000 a month"
    >
      <Fragment slot="link">See <a href="/seo-pricing/">what each part costs on its own</a>.</Fragment>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="Which part of law firm SEO would bring you calls first, and what does it cost?" writeHref="#svc-hero-form">
    <p>Fahim runs the searches your clients use, live, and shows who sits above you on Google, the Map and AI answers.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  /* Hero: the #1 frame on the fog block, full content width. */
  .svc-hero__fig { display: grid; gap: 14px; }
  .svc-hero__fig figcaption { max-width: 46em; }
  .svc-hero__fig figcaption b { color: var(--ink); }

  /* The practice list under its lead-in line. */
  .lse-depth__slot:has(> .bsv-practice) { margin-top: 28px; }
  .lse-depth__slot:has(> .bsv-practice) + .lse-prose { margin-top: 40px; }
</style>
