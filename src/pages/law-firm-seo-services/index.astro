---
// /law-firm-seo-services/. Facts: research/FACTS.md. The commercial top is the row hero (PageHero layout="row": the
// form card, and the #1 frame on the fog panel). The depth zone (src/content/depth/law-firm-seo-services.md, v4:
// written from our own practice) follows straight after it: the practice list at the end of the first 90 days, the
// New Orleans calls summary beside the two-firm results, the mid-page CTA after the counting section, and the price
// band (struck total from src/data/pricing.ts), then the accordion FAQ (fog), the author box and the closing CTA.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import PracticeLinks from '../../components/PracticeLinks.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import Q from '../../components/kit/Q.astro';
import ShotSwap from '../../components/money/ShotSwap.astro';
import '../../components/services/services.css';
import { fadeRight, proof, shot } from '../../data/proof';
import { phoneProof } from '../../data/proof-money';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const title = 'Law Firm SEO Services | Top of Google, the Map and AI';
const description =
  'Law firm SEO services in the order we work: month 1 data, competitors, law and fixes, then pages, the profile and links, counted in calls.';
const path = '/law-firm-seo-services/';
const depth = await getDepth('law-firm-seo-services');

const wtdTitle = [{ l: 2, t: 40, w: 49, h: 19 }];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Law firm SEO services' }]}
  service={{ name: 'Law firm SEO services', serviceType: 'Search engine optimization for law firms' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    class="svc-hero"
    h1="Law firm SEO services that turn searches into calls."
    lead="Our lawyer SEO services put your firm where clients look first: the top of Google, the Map and Google’s AI answers."
    form={{ idPrefix: 'svc-hero', label: 'services-hero' }}
  >
    <figure slot="visual" class="svc-hero__fig">
      <ShotSwap
        tag="#1"
        priority
        wide={[shot(proof.nolaWtdQuery), shot(proof.nolaWtdRank, { marks: wtdTitle, alt: 'A New Orleans PI firm’s page, What to Do After a Truck Accident, as the first result on Google' })]}
        narrow={[shot(phoneProof.wtdQuery), fadeRight(shot(phoneProof.wtdRank, { marks: ['title'] }))]}
      />
      <figcaption><b><Q text="what to do after a truck accident in New Orleans" /></b>: a PI firm’s page in New Orleans ranked #1.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} authorLinkLabel="More about Fahim">
    <figure slot="proof" class="lse-depth__proof">
      <ShotSwap
        tag="139 calls"
        tagSide="left"
        wide={[shot(proof.nolaCallsSummary, { marks: ['range', 'growth'] })]}
        narrow={[shot(proof.nolaCallsSummary, { marks: ['range', 'growth'], phone: false })]}
      />
      <figcaption><b>139 calls in five months, up 39%</b><span>A PI firm in New Orleans: calls from its Google Business Profile, June to October 2026, by Google’s own count.</span></figcaption>
    </figure>
    <div slot="practices" class="bsv-practice"><PracticeLinks /></div>

    <Band slot="mid" tone="fog" class="bsv-mid">
      <p class="bsv-mid__line">Fahim will map your first 90 days and put the price in writing.</p>
      <Button />
    </Band>

    <PriceBand
      slot="price"
      variant="total"
      heading="All seven parts, one monthly price."
      headingId="price-h"
      lead="Agencies often quote SEO one part at a time."
      us="With us, all seven: from $2,000 a month. No setup fee."
      usMark="from $2,000 a month"
    >
      <Fragment slot="link">See <a href="/seo-pricing/">what each part costs on its own</a>.</Fragment>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="Which part of law firm SEO would bring you calls first, and what does it cost?" writeHref="#svc-hero-form">
    <p>Fahim runs the searches your clients use, live, and shows who sits above you on Google, the Map and AI answers.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  /* Hero: the #1 frame on the fog panel, beside the form card. */
  .svc-hero__fig { display: grid; gap: 14px; }
  .svc-hero__fig figcaption { max-width: 46em; }
  .svc-hero__fig figcaption b { color: var(--ink); }

  /* The practice list under its lead-in line. */
  .lse-depth__slot:has(> .bsv-practice) { margin-top: 28px; }
  .lse-depth__slot:has(> .bsv-practice) + .lse-prose { margin-top: 40px; }
</style>
