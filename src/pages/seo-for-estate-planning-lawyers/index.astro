---
// /seo-for-estate-planning-lawyers/. Facts: research/FACTS.md. The hero is the row hero (PageHero layout="row"):
// the H1 and line across, the form card, and the AI answer on the fog panel. The depth zone
// (src/content/depth/seo-for-estate-planning-lawyers.md, v4: written from our own practice) opens on a fog band
// (byline, summary, jump list): the build steps, the jackknife #1 beside the question pages section, the four
// writing rules as large rows, a white mid-page CTA under an ink rule, the price as two lines side by side (no
// PriceBand on this page), then the accordion FAQ (fog), the author box and FinalCta.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-estate-planning-lawyers/';
const title = 'SEO for Estate Planning Lawyers | Be the Answer They Read';
const description =
  'Estate planning SEO: a clear page for each will, trust and probate service, this year’s figures checked at the source, and referrals and reviews within the rules.';
const depth = await getDepth('seo-for-estate-planning-lawyers');

// "Writing for families facing illness or a death": the four writing rules, plain rows.
const writingRules = [
  { text: 'Name incapacity and dementia plainly, then say what is still possible.' },
  { text: 'Use no pressure lines, countdowns or scare statistics.' },
  { text: 'Choose photos of people planning, not hospital beds.' },
  { text: 'Explain the process in family disputes, without taking a side.' },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'SEO for estate planning lawyers' }]}
  service={{ name: 'SEO for estate planning lawyers', offer: false }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    h1="Estate planning SEO that makes you the answer families find first."
    lead="Planning clients read for a while before they pick a lawyer. We make your firm the page that ranks for their questions, and the source Google’s AI answer quotes."
    form={{ who: 'your estate planning firm', idPrefix: 'ep-hero', label: 'estate-hero', practiceArea: 'Estate planning' }}
    class="ep-hero"
  >
    <figure slot="visual" class="ep-hero__fig">
      <Shot tag="Quoted by AI" tagSide="right" priority images={[shot(proof.nolaWtdAi, { crop: 'two', phone: 'two', marks: proof.nolaWtdAi.marks.citations.slice(0, 2), alt: 'Google’s AI answer for what to do after a truck accident in New Orleans, citing a New Orleans PI firm’s page' })]} />
      <figcaption>A PI firm in New Orleans: Google’s AI answer cites its question page.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} authorLinkLabel="Read S. M. Fahim’s profile">
    <figure slot="proof" class="lse-depth__proof">
      <Shot tag="#1" tagSide="right" images={[shot(proof.nolaJackknife, { marks: ['aiChip', 'result'] })]} />
      <figcaption>A New Orleans PI firm’s jackknife crash page, seven days after it went live: the first result, with Google’s AI citing it.</figcaption>
    </figure>

    <div slot="rules" class="ep-rules"><Rows items={writingRules} /></div>

    <Band slot="mid" class="ep-mid">
      <div class="ep-mid__in">
        <p class="ep-mid__line">Find out which will, trust and probate searches show your firm, and which don’t.</p>
        <Button />
      </div>
    </Band>

    <Band slot="price" class="ep-price">
      <div class="ep-price__in">
        <p class="ep-price__line">Estate planning SEO is from $2,000 a month, and there is nothing to pay for setup.</p>
        <p class="ep-price__more">Fahim sends your monthly figure in writing before anything starts. See <a href="/seo-pricing/">law firm SEO pricing</a>.</p>
      </div>
    </Band>
  </DepthZone>

  <FinalCta heading="Get a monthly price for more will, trust and probate calls." writeHref="#ep-hero-form">
    <p>In a 30-minute call, Fahim types your main will, trust and probate questions into Google with you, then your firm’s name, and points to the first fix.</p>
  </FinalCta>
</InnerPage>

<style>
  /* Hero: the AI answer on the fog panel, its one-line caption under it. */
  .ep-hero__fig { display: grid; gap: 12px; margin: 0; }
  /* The capture has no blank top, so the frame gives the tag a white strip to sit on (design-3). */
  .ep-hero__fig :global(.lse-shot__frame) { padding-top: 30px; }
  @media (max-width: 759px) { .ep-hero__fig :global(.lse-shot__frame) { padding-top: 22px; } }
</style>

<style is:global>
  /* The depth zone opens on a fog band (byline, summary, jump list), full bleed, then the sections on white. */
  .lse-depth[data-depth='seo-for-estate-planning-lawyers'] > .lse-depth__part--first { padding-top: 0; }
  .lse-depth[data-depth='seo-for-estate-planning-lawyers'] .lse-depth__intro {
    padding-block: clamp(56px, 6vw, 96px); border-top: 0;
    background: var(--fog); box-shadow: 0 0 0 100vmax var(--fog); clip-path: inset(0 -100vmax);
  }
  .lse-depth[data-depth='seo-for-estate-planning-lawyers'] .lse-depth__intro + .lse-depth__sec { border-top: 0; }

  /* The four writing rules: large plain rows in ink, so they read as rules, not notes. */
  .ep-rules { max-width: 35em; }
  .ep-rules .lse-row { padding: 16px 0 17px; }
  .ep-rules .lse-row p { max-width: none; font-size: clamp(19px, .45vw + 15px, 22px); font-weight: 600; line-height: 1.35; letter-spacing: -.01em; color: var(--ink); }
  .lse-depth__slot:has(> .ep-rules) { margin-top: 20px; }
  .lse-depth__slot:has(> .ep-rules) + .lse-prose { margin-top: 32px; }

  /* Mid-page CTA on white: an ink rule above, a hairline below, the line set large and the button under it. */
  .lse-depth .ep-mid { padding-block: 0; }
  .ep-mid__in {
    display: grid; gap: var(--s4); justify-items: start;
    padding-block: clamp(36px, 4vw, 56px) clamp(40px, 4.5vw, 64px); border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line-2);
  }
  .ep-mid__line { max-width: 22em; font-size: clamp(24px, 1.2vw + 17px, 36px); font-weight: 750; line-height: 1.15; letter-spacing: -.022em; color: var(--ink); }

  /* The price: two lines side by side from 1000px, under a hairline. No button. */
  .lse-depth .ep-price { padding-top: 0; }
  .ep-price__in { max-width: 1040px; display: grid; gap: var(--s3); padding-top: var(--s4); border-top: 1px solid var(--line-2); }
  .ep-price__line { max-width: 22em; font-size: clamp(22px, .8vw + 17px, 28px); font-weight: 750; line-height: 1.22; letter-spacing: -.018em; color: var(--ink); }
  .ep-price__more { max-width: 26em; color: var(--ink-2); }
  .ep-price__more a { font-weight: 700; }
  @media (min-width: 1000px) {
    .ep-price__in { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 4vw, 64px); align-items: start; }
    .ep-price__more { padding-top: 6px; }
  }
</style>
