---
// /seo-for-estate-planning-lawyers/ from content/v2/seo-for-estate-planning-lawyers.md (practice set B).
// Hero: stacked. H1 and line, the short form as one row (on the first screen at 1440), then the AI answer
// on a wide fog block (the typed search over the frame, the caption beside it). Then two search lists, the name search, what the firm gets (the page's one price line), FAQ, close.
import Faq, { type FaqItem } from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import SearchBox from '../../components/kit/SearchBox.astro';
import SearchPanel from '../../components/kit/SearchPanel.astro';
import Related from '../../components/practice-b/Related.astro';
import { proof, shot } from '../../data/proof';
import InnerPage from '../../layouts/InnerPage.astro';

const faq: FaqItem[] = [
  {
    q: 'How long before planning pages bring calls?',
    html: 'That turns on your town, your competition and the state of your site. Planning clients decide slowly, so results build over months. Fahim gives you an honest view in the ranking review.',
  },
  {
    q: 'Should we write about making a will without a lawyer?',
    html: 'Yes, honestly. People search for it. A fair page on what a homemade will can miss earns trust without scaring anyone.',
  },
  {
    q: 'How do you handle pages about illness and death?',
    html: 'Plainly and calmly. No pressure lines and no stock photos of hospital beds. Your attorneys approve each page before it goes live.',
  },
  {
    q: 'What about bar advertising rules?',
    html: 'Rules differ from state to state, including on words like “specialist”. Nothing goes on your site until your firm has signed off on it.',
  },
  {
    q: 'Who will we work with?',
    html: 'Fahim runs your account, is on every call and checks every page, and a small team helps him produce the work. Josh Henderson, our Sales Director and a Texas attorney since 2008, joins calls with firms.',
  },
];
---
<InnerPage
  title="SEO for Estate Planning Lawyers | Be the Answer They Read"
  description="SEO for estate planning lawyers: rank for the will, trust and probate questions families research, and get quoted in Google's AI answers."
  path="/seo-for-estate-planning-lawyers/"
  crumbs={[{ label: 'SEO for estate planning lawyers' }]}
  service={{ name: 'SEO for estate planning lawyers', offer: false }}
  faq={faq}
>
  <PageHero
    layout="stack"
    h1="Estate planning SEO that makes you the answer families find first."
    lead="Planning clients read for a while before they pick a lawyer. We make your firm the page that ranks for their questions, and the source Google’s AI answer quotes."
    form={{ title: 'Which planning questions do you rank for?', sub: 'Fahim answers within an hour in business hours.', idPrefix: 'ep-hero', label: 'estate-hero', practiceArea: 'Estate planning' }}
    talk="Prefer a call?"
    class="ep-hero"
  >
    <div slot="visual" class="ep-hero__vis">
      <div class="ep-hero__proof">
        <SearchBox label="The search typed into Google" queries={[{ text: 'what to do after a truck accident in New Orleans' }]} />
        <Shot tag="Cited 3 times" tagSide="right" priority images={[shot(proof.nolaWtdAi, { marks: ['citations'] })]} />
      </div>
      <div class="ep-hero__say">
        <p class="ep-hero__cap">For a PI firm in New Orleans. Google’s AI answer cites its question page three times.</p>
        <p class="ep-hero__line">A will, trust or probate question works the same way. One clear page that answers it well gets ranked and quoted.</p>
      </div>
    </div>
  </PageHero>

  <Band
    heading="The questions planning clients type before they call."
    headingId="ep-types-h"
    lead="Two kinds of reader: people planning ahead, and families settling an estate after a death. Each gets its own pages."
    tone="fog"
    wideHeading
  >
    <SearchPanel
      columns={[
        {
          heading: 'Planning',
          queries: [
            { text: 'cost of making a will with a lawyer', mark: 'cost' },
            { text: 'do you need a lawyer to get power of attorney' },
            { text: 'how to make a living trust without a lawyer' },
          ],
        },
        {
          heading: 'Probate',
          queries: [
            { text: 'how much does a probate lawyer cost', mark: 'how much' },
            { text: 'do i need a lawyer to become executor of estate' },
            { text: 'what percentage does a lawyer get for settling an estate', mark: 'percentage' },
          ],
        },
      ]}
    />
    <div class="ep-under">
      <p class="lse-small">Taken word for word from our keyword research.</p>
      <p class="lse-lead">Each question gets a short page in plain words, with large readable text and a clear next step. Your attorneys approve every one.</p>
    </div>
  </Band>

  <Band
    heading="A referred client checks your name on Google."
    headingId="ep-name-h"
    lead="Advisers, accountants and past clients send people to you. Many look you up before they call, so that search has to help."
  >
    <div class="ep-name">
      <Rows
        variant="inline"
        items={[
          { title: 'Your Google Business Profile:', text: 'correct details, real photos and a steady flow of new reviews.' },
          { title: 'Attorney pages:', text: 'each attorney’s page comes up when someone searches that attorney’s name.' },
          { title: 'Old listings:', text: 'directories with an old address or phone number get fixed.' },
        ]}
      />
    </div>
  </Band>

  <Band heading="What your planning practice gets each month." headingId="ep-gets-h" tone="fog">
    <div class="ep-gets">
      <Rows
        class="ep-gets__rows"
        items={[
          { text: 'Pages for the will, trust, power of attorney and probate questions you want to win.' },
          { text: 'Your Google Business Profile looked after, with a simple routine for new reviews.' },
          { text: 'A faster, easier site, kept up to date, with every call and form tracked.' },
          { text: 'Google’s AI answers for your main questions, checked monthly.' },
        ]}
      />
      <div class="ep-gets__price">
        <p class="ep-gets__line">You pay one monthly price for all of it: <span class="lse-mk">from $2,000 a month</span>, with nothing to set up. See <a href="/seo-pricing/">law firm SEO pricing</a>.</p>
        <p>The full list is on our <a href="/law-firm-seo-services/">law firm SEO services</a> page.</p>
      </div>
    </div>
  </Band>

  <Band heading="Before you start: planning firm questions." headingId="ep-faq-h">
    <Faq items={faq} />
  </Band>

  <FinalCta heading="See which planning questions your firm ranks for." formLabel="estate-final" idPrefix="ep-final" practiceArea="Estate planning">
    <p>In 30 minutes, Fahim searches your main will, trust and probate questions with you, then your firm’s name, and shows what to fix first.</p>
  </FinalCta>
  <Related links={[{ label: 'SEO for family lawyers', href: '/seo-for-family-lawyers/' }, { label: 'SEO for bankruptcy lawyers', href: '/seo-for-bankruptcy-lawyers/' }]} />
</InnerPage>

<style>
  /* Hero: the search and the AI answer on the left of the fog block, what it shows on the right. */
  .ep-hero__vis { display: grid; gap: 28px; }
  .ep-hero__proof { display: grid; gap: 18px; max-width: 902px; }
  .ep-hero__proof :global(.lse-search__box) { border-radius: 999px; padding: 0; }
  .ep-hero__say { display: grid; gap: 14px; align-content: end; }
  .ep-hero__cap { font-size: 17px; line-height: 1.45; color: var(--ink-2); max-width: 30em; }
  .ep-hero__line { font-size: var(--fs-lead); line-height: 1.4; font-weight: 600; color: var(--ink); max-width: 22em; letter-spacing: -.01em; }
  @media (min-width: 1000px) {
    .ep-hero__vis { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: clamp(36px, 4vw, 64px); align-items: end; }
    .ep-hero__say { padding-bottom: 8px; }
  }
  .ep-name { max-width: 860px; }

  .ep-under { margin-top: var(--s5); display: grid; gap: 14px; }

  .ep-gets { display: grid; gap: var(--s5); }
  :global(.ep-gets__rows .lse-row p) { font-size: var(--fs-lead); line-height: 1.4; color: var(--ink); max-width: 34em; }
  .ep-gets__price { display: grid; gap: 14px; }
  .ep-gets__line { font-size: clamp(22px, 1vw + 16px, 30px); font-weight: 750; line-height: 1.25; letter-spacing: -.02em; color: var(--ink); max-width: 26em; }
  .ep-gets__price p:last-child { color: var(--ink-2); }
  @media (min-width: 1000px) {
    .ep-gets { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(48px, 5vw, 72px); align-items: start; }
    .ep-gets__price { padding-top: 20px; }
  }
</style>
