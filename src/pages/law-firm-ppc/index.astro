---
// /law-firm-ppc/. Copy: content/v3/law-firm-ppc.md (critic: content/v3/CRITIC-mixed.md). Facts: research/FACTS.md
// section 1 (Google Ads / PPC). The only page on the site about Google Ads. No PPC results are approved, so the page
// shows none. The commercial top: the hero (S4: the H1 across, the example search terms and the 3-field form under
// it; the "Running Google Ads now?" select left the hero, critique 2.2) and the owner-confirmed scope band. The depth
// zone follows (src/content/depth/law-firm-ppc.md): the mid-page CTA after the main zone, the $500 price band above
// the open FAQ.
// Schema: the custom Service node carries only the $500 management fee; never the $2,000 SEO offer (R41).
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import Rows from '../../components/kit/Rows.astro';
import SearchPanel from '../../components/kit/SearchPanel.astro';
import '../../components/mixed/mixed.css';
import { site } from '../../data/site';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/law-firm-ppc/';
const pageUrl = new URL(path, site.url).href;
const title = 'Law Firm PPC | Google Ads Run in Your Own Account';
const description =
  'Law firm PPC in your own Google Ads account, from $500 a month: the auction, ownership, negative keywords, lead tracking, ad policies, LSA and bar rules.';
const depth = await getDepth('law-firm-ppc');

const handled = [
  { title: 'Campaign setup.', text: 'Campaigns built around the cases you want, in the places you serve.' },
  { title: 'Search terms.', text: 'We read what people typed before your ad showed, and block the searches that waste money.' },
  { title: 'Ad copy.', text: 'Plain ads that match the search. You approve each one before it runs.' },
  { title: 'Landing page fit.', text: 'Each ad points to the page that answers its search, not your homepage.' },
  { title: 'Budget pacing.', text: 'Spend is spread so your ads keep running to the end of the month.' },
  { title: 'Call tracking.', text: 'Calls and forms counted by campaign, so you see which searches bring them.' },
];

const terms = [
  { title: 'Your account.', text: 'We work in your firm’s own Google Ads account, and it stays yours.' },
  { title: 'Your billing.', text: 'Google bills your firm directly for every click. Our fee is separate.' },
  { title: 'Already running ads?', text: 'We take over your existing account, history and all.' },
  { title: 'In writing first.', text: 'Fahim gives you the monthly fee before any work starts. Month to month.' },
];

// Service JSON-LD with the ads management fee (the kit's serviceSchema only knows the $2,000 SEO and web offers).
const service = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Google Ads management for law firms',
  serviceType: 'Pay-per-click advertising management',
  url: pageUrl,
  provider: { '@id': `${site.url}/#org` },
  areaServed: { '@type': 'Country', name: 'United States' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: 500,
    description: 'Management fee from $500 a month. Ad spend is billed by Google to the firm.',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      minPrice: 500,
      priceCurrency: 'USD',
      unitText: 'MONTH',
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
    },
  },
};
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Law firm PPC' }]}
  faq={depth.faq}
  schema={[service, ...depthSchema(depth, { path, title, description })]}
>
  <PageHero
    layout="top"
    panel={false}
    class="ppc-hero"
    h1="Law firm PPC, run for calls instead of clicks."
    lead="We manage Google Ads for law firms inside your own ad account. We track which searches turn into calls and put your budget behind those."
    form={{ idPrefix: 'ppc-hero', label: 'ppc-hero', format: 'Google Ads review by email' }}
  >
    <figure slot="visual" class="ppc-fig">
      <div class="ppc-card">
        <SearchPanel
          columns={[
            {
              heading: 'Searches worth paying for',
              queries: [
                { text: 'car accident lawyer near me', mark: 'near me' },
                { text: 'free car accident lawyer consultation', mark: 'consultation' },
                { text: 'car accident attorney houston', mark: 'houston' },
              ],
            },
            {
              heading: 'Searches we block',
              strike: true,
              queries: [{ text: 'car accident lawyer salary' }, { text: 'car accident lawyer jobs' }, { text: 'how to become a car accident lawyer' }],
            },
          ]}
        />
      </div>
      <figcaption class="lse-small">Example search terms for a car accident firm.</figcaption>
    </figure>
  </PageHero>

  <Band heading="What we handle inside your ad account." headingId="handle-h" tone="fog">
    <Rows class="ppc-handle" variant="inline" items={handled} />
  </Band>

  <DepthZone depth={depth} authorLinkLabel="About S. M. Fahim">
    <Band slot="mid" tone="fog" class="mx-mid">
      <p class="mx-mid__line">Already running Google Ads? Fahim can go through the account with you in a free 30-minute call.</p>
      <Button />
    </Band>

    <PriceBand slot="price" variant="plain" heading="Management from $500 a month. Ad spend goes straight to Google." headingId="price-h" big="$500">
      <Rows class="ppc-terms" variant="big" items={terms} />
      <Fragment slot="link">Free, 30 minutes. Bring your ad account and Fahim looks at it with you.</Fragment>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="See how many calls your law firm’s ad budget could buy, and our fee." writeHref="#ppc-hero-form">
    <p>Bring your website, and your Google Ads account if you have one. In 30 minutes, Fahim looks at where your ad money goes and which searches turn into calls.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  .ppc-fig { display: grid; gap: 14px; margin: 0; }
  .ppc-card { padding: clamp(20px, 2.4vw, 36px); background: var(--paper); border: 1px solid #cfd4cb; border-radius: var(--r-frame); box-shadow: var(--shadow-lift); }
  @media (min-width: 1000px) {
    .ppc-handle { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(48px, 5vw, 72px); }
  }
  .ppc-terms { border-top-color: var(--ink); }
  .ppc-terms .lse-row { border-bottom-color: rgba(0, 0, 0, .28); }
  .ppc-terms .lse-row p { color: var(--ink); }
</style>
