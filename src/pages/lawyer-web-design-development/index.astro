---
// /lawyer-web-design-development/. Copy: content/v3/lawyer-web-design-development.md (critic: content/v3/CRITIC-mixed.md).
// Facts: research/FACTS.md. The commercial top is the row hero (the New Orleans site on a screen beside the form card,
// the price allowed in this H1 by the judge's ruling), then one fog band with the El Paso site on a phone beside the
// two results as text. The depth zone follows: src/content/depth/lawyer-web-design-development.md, with the six
// parts beside the practice page capture as a slot, the mid-page CTA after the main zone, and the plain price band
// above the open FAQ. The [OWNER Q4] items (build time, hosting, staff edits) stay off the page until answered.
import Button from '../../components/Button.astro';
import FinalCta from '../../components/FinalCta.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import Band from '../../components/kit/Band.astro';
import BrowserShot from '../../components/kit/BrowserShot.astro';
import PageHero from '../../components/kit/PageHero.astro';
import PhoneShot from '../../components/kit/PhoneShot.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import Q from '../../components/kit/Q.astro';
import Rows from '../../components/kit/Rows.astro';
import Split from '../../components/kit/Split.astro';
import '../../components/mixed/mixed.css';
import { proof, shot } from '../../data/proof';
import { site } from '../../data/site';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/lawyer-web-design-development/';
const title = 'Lawyer Web Design Built to Rank | From $2,000';
const description =
  'Lawyer web design that ranks and takes the call: the page plan, a move that keeps rankings, tracking, disclosures, hosting and a fixed quote from $2,000.';
const depth = await getDepth('lawyer-web-design-development');

// The hero's screen: the site's own hero, from "New Orleans personal injury lawyer" to "with Rudin Law." (a band of
// the capture, % of its height), so it fills the panel's width and keeps to the form card's height. Phones keep
// their crop from the top of the screen, at about 200px.
const wdScreen = { top: 22, height: 56.6 };

// Depth section 1: the six parts every build comes with (one template: the part, then one sentence).
const parts = [
  {
    title: 'A page for each search that brings callers.',
    text: 'Each practice area, case type and real office gets its own page, matched to the words clients type, like <q data-no-check>car accident lawyer in New Orleans</q>.',
  },
  { title: 'One tap to call.', text: 'On a phone, the call button and a short form stay within reach.' },
  { title: 'Disclosures written in.', text: 'The responsible lawyer, approved wording on results and any regulator badge go in during the build, not as a patch after launch.' },
  { title: 'Rankings carried over.', text: 'Every old page that ranks or gets visits is redirected, and anything Search Console flags after launch gets fixed.' },
  { title: 'Calls and forms counted from day one.', text: 'Tracking goes in before launch, so the firm sees what the site brings in.' },
  { title: 'Speed checked on real phones.', text: 'The firm gets the real speed scores at launch.' },
];

// The depth zone's WebPage node keeps the page's main image (the New Orleans site on a desktop).
const [person, webPage] = depthSchema(depth, { path, title, description });
const pageSchema = [
  person,
  {
    ...webPage,
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: new URL(proof.nolaSiteHomeDesktop.src, site.url).href,
      width: proof.nolaSiteHomeDesktop.width,
      height: proof.nolaSiteHomeDesktop.height,
    },
  },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Lawyer web design' }]}
  service={{
    name: 'Law firm web design and development',
    serviceType: 'Website design and development for law firms',
    description: 'From $2,000 for the build, fixed written quote. The firm owns the site, the content and every account we set up.',
    offer: 'once',
  }}
  faq={depth.faq}
  schema={pageSchema}
>
  <PageHero
    layout="row"
    class="wd-hero"
    h1="Lawyer web design built to rank, from $2,000."
    lead="We plan your law firm’s website around what clients type into Google, so its pages can climb the results and show up in AI answers."
    form={{ title: 'What could a new website bring your firm, and what would it cost?', sub: 'Send your website. Fahim sends back what the new site should fix and your fixed price, in writing.', idPrefix: 'web-hero', label: 'web-hero', format: 'Website quote by email' }}
  >
    <figure slot="visual" class="wd-fig">
      <BrowserShot tag="Our build" tagSmall tagSide="left" priority images={[{ ...shot(proof.nolaSiteHomeDesktop, { crop: wdScreen }), phone: [{ l: 0, t: 0, w: 100, h: 80 }] }]} />
      <figcaption>The site we built for a PI firm in New Orleans.</figcaption>
    </figure>
  </PageHero>

  <Band
    heading="Pages on the sites we build climb Google and its AI answers."
    headingId="ranks-h"
    lead="Two results, one from each site. The New Orleans one came after about three months of groundwork."
    wideHeading
    tone="fog"
    class="wd-ranks"
  >
    <Split ratio="4/8" align="center">
      <PhoneShot slot="a" class="wd-ranks__phone" width={240} tag="El Paso" tagSmall tagSide="right" images={[shot(proof.elpasoSiteMobile)]} />
      <ul slot="b" class="wd-ranks__rows">
        <li>The site we built for a PI firm in El Paso. On <Q text="Texas El Paso car accident filing deadline" />, Google’s AI answer cites this site’s page ahead of every other source.</li>
        <li>On the New Orleans site in the hero, the page for <Q text="tanker truck accident lawyer in New Orleans" /> reached #3 on Google within 16 hours of going live. Google’s AI answer named the firm as a key firm.</li>
      </ul>
    </Split>
    <p class="wd-ranks__own">Fixed quote in writing. Your firm owns all of it.</p>
  </Band>

  <DepthZone depth={depth} authorLinkLabel="Fahim’s background">
    <div slot="parts" class="wd-parts">
      <Split ratio="6/6">
        <div slot="a" class="mx-rows"><Rows variant="inline" items={parts} /></div>
        <figure slot="b" class="wd-fig">
          <BrowserShot tag="Practice page" tagSmall tagSide="right" images={[shot(proof.nolaSiteCarAccidentPage)]} />
          <figcaption class="lse-small">A practice page on the New Orleans site. The search is the headline, and the form and call button are on the first screen.</figcaption>
        </figure>
      </Split>
    </div>

    <Band slot="mid" tone="fog" class="mx-mid">
      <p class="mx-mid__line">Planning a new site? Fahim can go through your current rankings with you first, free, in 30 minutes.</p>
      <Button />
    </Band>

    <PriceBand slot="price" class="wd-price" variant="plain" heading="One fixed quote for the build." headingId="price-h" big="From $2,000">
      <Rows
        class="wd-terms"
        items={[
          { text: 'Your price is in writing before any work starts.' },
          { text: 'Page count, practice areas, offices and who writes the content set the quote.' },
          { text: 'The site, the content and every account we set up belong to your firm.' },
        ]}
      />
      <Fragment slot="link">Free, 30 minutes. Fahim looks at what your current site ranks for.</Fragment>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="Find out what a law firm website that brings calls would cost you." writeHref="#web-hero-form">
    <p>In 30 minutes, Fahim shows which of your pages earn rankings today, so the new site keeps them.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  .wd-fig { display: grid; gap: 14px; align-content: start; margin: 0; }
  .wd-ranks__own { margin-top: clamp(28px, 3vw, 40px); font-size: var(--fs-lead); font-weight: 700; letter-spacing: -.01em; color: var(--ink); }

  /* The two results beside the El Paso phone: hairline rows at lead size, each search in ink. */
  .wd-ranks__rows { list-style: none; display: grid; border-top: 2px solid var(--ink); }
  .wd-ranks__rows li {
    padding: 26px 0 28px; border-bottom: 1px solid var(--line-2); max-width: 30em;
    font-size: clamp(20px, .6vw + 16px, 25px); line-height: 1.42; letter-spacing: -.01em; color: var(--ink-2);
  }
  .wd-ranks__rows q { font-weight: 700; color: var(--ink); }
  @media (min-width: 1000px) {
    .wd-ranks .lse-split__a { justify-items: center; }
  }
  @media (max-width: 999px) {
    .wd-ranks__phone { justify-self: center; }
  }

  /* Depth section 1: the six parts beside the practice page, under the section's lead-in line. */
  .lse-depth__slot:has(> .wd-parts) { margin-top: 24px; }

  /* The two tables' first column keeps its row labels on one or two lines. */
  @media (min-width: 641px) {
    .lse-depth[data-depth='lawyer-web-design-development'] .lse-prose tbody td:first-child { min-width: 10.5em; }
  }

  /* "From $2,000" stays on one line on its swipe. */
  .wd-price .lse-price__big span { font-size: clamp(46px, 7vw + 20px, 124px); white-space: nowrap; }
  .wd-terms { border-top-color: var(--ink); }
  .wd-terms .lse-row { border-bottom-color: rgba(0, 0, 0, .28); }
  .wd-terms .lse-row p { font-size: var(--fs-lead); font-weight: 600; color: var(--ink); max-width: 34em; }
</style>
