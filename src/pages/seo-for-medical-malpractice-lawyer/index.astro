---
// /seo-for-medical-malpractice-lawyer/ from content/v3/seo-for-medical-malpractice-lawyer.md (critic:
// content/v3/CRITIC-practice-3.md). Facts: research/FACTS.md. Fewer, better inquiries. The hero is variant P4
// (docs/DESIGN-CRITIQUE.md 2.3): on white, the H1 and line with the El Paso search and its first AI source card under
// them, the form on the right. The v2 bands
// (keep or skip, harm pages, the name search), FAQ and Related block gave way to the depth zone
// (src/content/depth/seo-for-medical-malpractice-lawyer.md). Its own look on this page: the jump list under a thick
// rule on its left, the rule tables with the state set large, the harm pages and agency habits as two-column rows
// (the lead left, the rest right), the built marker PriceBand (moved, new heading), and the open FAQ on white.
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import PageHero from '../../components/kit/PageHero.astro';
import { shot } from '../../data/proof';
import { phoneProof } from '../../data/proof-money';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-medical-malpractice-lawyer/';
const title = 'Medical Malpractice SEO | Fewer, Better Inquiries';
const description =
  'Medical malpractice SEO: screening forms, state pre-suit rules, fee caps by state, harm pages, referrals and verdicts, AI deadline answers, UK firms.';
const depth = await getDepth('seo-for-medical-malpractice-lawyer');
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Medical malpractice SEO' }]}
  service={{ name: 'Medical malpractice SEO' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="under"
    visualFirst
    h1="Medical malpractice SEO for fewer, better inquiries."
    lead="You don’t need more calls. You need the right ones. We rank your firm for the harm you take and the questions those families ask."
    form={{ who: 'your malpractice firm', idPrefix: 'mm-hero', label: 'mm-hero', practiceArea: 'Medical malpractice' }}
  >
    <figure slot="visual" class="mm-fig">
      <Shot tag="Source #1" tagSide="right" priority images={[shot(phoneProof.elpasoQuery), shot(phoneProof.elpasoSource, { marks: ['title'] })]} />
      <figcaption>Google’s AI answer on a Texas filing deadline lists an El Paso PI firm’s page first.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} faqTone="white" authorLinkLabel="Background on S. M. Fahim">
    <PriceBand
      slot="price"
      heading="The whole malpractice job, one monthly price."
      headingId="price-h"
      lead="From $2,000 a month for pages, site upkeep, your Google profile, links, call tracking and AI answer checks. No setup fee. Month to month."
    >
      <Fragment slot="link">See <a href="/seo-pricing/">law firm SEO pricing</a></Fragment>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="Price the right malpractice calls with Fahim, case type by case type." writeHref="#mm-hero-form">
    In a free, 30-minute call, Fahim checks your main malpractice searches and your firm’s name with you, and points out the ones bringing wrong-fit calls.
  </FinalCta>
</InnerPage>

<style is:global>
  .mm-fig { display: grid; gap: 12px; margin: 0; }

  /* The depth zone on this page. The jump list hangs from a thick black rule on its left, not a rule on top. */
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-depth__toc { border-top: 0; padding-left: 22px; border-left: 4px solid var(--ink); }
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-depth__toc .lse-jump__h { padding-top: 0; }

  /* A hyphenated word in a heading stays on one line. */
  .mm-nowrap { white-space: nowrap; }

  /* The rule tables: the state set large in the first column, on one line. */
  @media (min-width: 641px) {
    .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-prose tbody td:first-child {
      font-size: clamp(19px, .4vw + 16px, 22px); font-weight: 800; letter-spacing: -.015em; line-height: 1.2; white-space: nowrap;
    }
  }

  /* The harm pages and the agency habits: hairline rows; from 900px the bold lead sits in a left column. */
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-prose > ul:not(.lse-check) { list-style: none; padding: 0; border-top: 2px solid var(--ink); max-width: 46em; }
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-prose > ul:not(.lse-check) > li { position: relative; margin: 0; padding: 15px 0 16px; border-bottom: 1px solid var(--line-2); }
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-prose > ul:not(.lse-check) > li > strong:first-child { display: block; margin-bottom: 4px; color: var(--ink); font-weight: 750; }
  @media (min-width: 900px) {
    .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-prose > ul:not(.lse-check) > li { padding-left: 36%; min-height: 3.6em; }
    .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-prose > ul:not(.lse-check) > li > strong:first-child {
      position: absolute; left: 0; top: 15px; width: 32%; margin: 0;
      font-size: clamp(18px, .3vw + 16px, 20px); line-height: 1.3; letter-spacing: -.01em;
    }
  }

  /* The open FAQ on white: each question under a black rule. */
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-depth__faq .lse-faq--open { border-top: 0; }
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-depth__faq .lse-faq__item { border-top: 2px solid var(--ink); border-bottom: 0; }
</style>
