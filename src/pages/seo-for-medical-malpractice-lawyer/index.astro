---
// /seo-for-medical-malpractice-lawyer/. Facts: research/FACTS.md. Fewer, better inquiries. The hero is the row hero
// (PageHero layout="row"): the H1 and line across, the form card, and the El Paso search with its first AI source
// card on the fog panel. The depth zone (src/content/depth/, v4: written from our own practice) follows: the build
// steps, the screening checklist, the same El Paso firm's calls beside the deadline section, the built marker
// PriceBand, and the accordion FAQ on white. Its own look on this page: the jump list under a thick rule on its left.
import FinalCta from '../../components/FinalCta.astro';
import Shot from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import PriceBand from '../../components/kit/PriceBand.astro';
import PageHero from '../../components/kit/PageHero.astro';
import { proof, shot } from '../../data/proof';
import { phoneProof } from '../../data/proof-money';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const path = '/seo-for-medical-malpractice-lawyer/';
const title = 'Medical Malpractice SEO | Fewer, Better Inquiries';
const description =
  'Medical malpractice SEO from our own practice: harm and state pages, a form that screens, the name search referring lawyers run, timing and cost.';
const depth = await getDepth('seo-for-medical-malpractice-lawyer');
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Medical malpractice SEO' }]}
  service={{ name: 'Medical malpractice SEO' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    h1="Medical malpractice SEO for fewer, better inquiries."
    lead="You don’t need more calls. You need the right ones. We rank your firm for the harm you take and the questions those families ask."
    form={{ who: 'your malpractice firm', idPrefix: 'mm-hero', label: 'mm-hero', practiceArea: 'Medical malpractice' }}
  >
    <figure slot="visual" class="mm-fig">
      <Shot tag="Source #1" tagSide="right" priority images={[shot(phoneProof.elpasoQuery), shot(phoneProof.elpasoSource, { marks: ['title'] })]} />
      <figcaption>Google’s AI answer on a Texas filing deadline lists an El Paso PI firm’s page first.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} faqTone="white" authorLinkLabel="Background on S. M. Fahim">
    <figure slot="proof" class="lse-depth__proof">
      <Shot tag="23 calls" tagSide="right" images={[shot(proof.elpasoCallsAfter, { marks: ['total', 'range'], phone: 'totalRange' })]} />
      <figcaption>The El Paso PI firm behind the deadline page above: 23 calls from its Business Profile, May to July 2026, by Google’s count.</figcaption>
    </figure>
    <PriceBand
      slot="price"
      heading="The whole malpractice job, one monthly price."
      headingId="price-h"
      lead="Pages for each harm and state, site upkeep, your Google profile, links, call tracking and AI answer checks, from $2,000 a month, with nothing charged for setup. Each month is your choice, and what we built stays yours."
    >
      <Fragment slot="link">See <a href="/seo-pricing/">law firm SEO pricing</a></Fragment>
    </PriceBand>
  </DepthZone>

  <FinalCta heading="Price the right malpractice calls with Fahim, case type by case type." writeHref="#mm-hero-form">
    In a free, 30-minute call, Fahim checks your main malpractice searches and your firm’s name with you, and points out the ones bringing wrong-fit calls.
  </FinalCta>
</InnerPage>

<style is:global>
  .mm-fig { display: grid; gap: 12px; margin: 0; }

  /* The depth zone on this page. The jump list hangs from a thick black rule on its left, not a rule on top. */
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-depth__toc { border-top: 0; padding-left: 22px; border-left: 4px solid var(--ink); }
  .lse-depth[data-depth='seo-for-medical-malpractice-lawyer'] .lse-depth__toc .lse-jump__h { padding-top: 0; }
</style>
