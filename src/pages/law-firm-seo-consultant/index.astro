---
// /law-firm-seo-consultant/. Facts: research/FACTS.md. The commercial top is the row hero (PageHero layout="row"):
// the form card beside a client result (El Paso, 23 calls, the after chart cut tight). The depth zone
// (src/content/depth/law-firm-seo-consultant.md, v4: written from our own practice) follows straight after it: our
// own #1 shows once, under the vetting tests, as the answer to the first one (the only inner page allowed to show it,
// DEPTH-BRIEF R3); then the promises, access and second-opinion rows, and the accordion FAQ (fog). No mid-page CTA
// and no price band.
import FinalCta from '../../components/FinalCta.astro';
import Shot, { type ShotImage } from '../../components/Shot.astro';
import DepthZone from '../../components/depth/DepthZone.astro';
import PageHero from '../../components/kit/PageHero.astro';
import Rows from '../../components/kit/Rows.astro';
import ShotSwap from '../../components/money/ShotSwap.astro';
import '../../components/services/services.css';
import { proof, shot } from '../../data/proof';
import { phoneProof } from '../../data/proof-money';
import InnerPage from '../../layouts/InnerPage.astro';
import { depthSchema, getDepth } from '../../lib/depth';

const title = 'Law Firm SEO Consultant | A Second Opinion, Then the Work';
const description =
  'A law firm SEO consultant who checks your live site, not the reports, then leads the fixes. How to vet one, the red flags, who owns what, and the cost.';
const path = '/law-firm-seo-consultant/';
const depth = await getDepth('law-firm-seo-consultant');

// The El Paso after chart, cut tight: from the "23" down to the May to July axis. Marks: the total, and the
// first and last month on the axis (the date range). % of the whole image, measured from its pixels.
const epCrop = { top: 30.5, height: 63 };
// Our own result on a phone: the left 1,250px of the phone crop, so the title reads at about 12px.
const lseNarrow = (img: ShotImage): ShotImage => ({ ...img, phone: [{ l: 0, t: 0, w: 83.4, h: 100, fade: true }] });
const epRange = [
  { l: 3.9, t: 89.6, w: 4.7, h: 2.4 },
  { l: 92, t: 89.6, w: 4.3, h: 2.4 },
];

// Depth section 4 (v4): promises that should end the meeting. The first three are Google's own warnings.
const promises = [
  { title: 'A guaranteed #1 spot.', text: 'Google states that no one can guarantee a #1 ranking on Google.' },
  { title: 'A special relationship with Google.', text: 'Google names it as a claim to be wary of.' },
  { title: 'Methods kept secret.', text: 'Google warns against an SEO who won’t clearly explain what it intends to do.' },
  { title: 'A page for every keyword.', text: 'A page that only repeats another one splits the firm’s strength.' },
  { title: 'Stories in your lawyers’ voice that never happened.', text: 'Made-up experience puts readers, and the firm, at risk.' },
  { title: 'A separate fee for AI answers.', text: 'Google’s AI mostly quotes pages that rank already. Paying for “AI” work before the site ranks buys the wrong thing.' },
];
// Depth section 5 (v4): the access each job needs.
const access = [
  { title: 'For a review.', text: 'Read access to Search Console at most. A second opinion should never need the keys.' },
  { title: 'For hands-on work.', text: 'Manager access on the Business Profile and full-user access in Search Console, with the firm as owner.' },
  { title: 'For the website.', text: 'A named login for each person, removed when the work ends.' },
];
// Depth section 6 (v4): when a second opinion pays.
const moments = [
  { title: 'Calls are down, but the report says traffic is up.', text: 'The visits may come from searches that never bring a client, or the tracking may have stopped.' },
  {
    title: 'A redesign is planned.',
    text: 'A review first lists every page that brings in searchers, so none loses its address. See <a href="/lawyer-web-design-development/">law firm web design</a>.',
  },
  { title: 'An office has moved.', text: 'The order matters: the firm’s own website first, then every directory, and only then the Google profile.' },
  { title: 'A renewal is on the table.', text: 'Check the next proposal against the calls the current work has produced.' },
];
---
<InnerPage
  title={title}
  description={description}
  path={path}
  crumbs={[{ label: 'Law firm SEO consultant' }]}
  service={{ name: 'Law firm SEO consultant', serviceType: 'Search engine optimization consulting for law firms' }}
  faq={depth.faq}
  schema={depthSchema(depth, { path, title, description })}
>
  <PageHero
    layout="row"
    class="con-hero"
    h1="A law firm SEO consultant who gets you ranked, not just advised."
    lead="Find out what holds your firm back on Google, get the fixes in order, and have the same person lead the work that follows."
    form={{ idPrefix: 'con-hero', label: 'consultant-hero' }}
  >
    <figure slot="visual" class="con-hero__fig">
      <Shot
        tag="23 calls"
        tagSide="right"
        priority
        images={[shot(proof.elpasoCallsAfter, { crop: epCrop, phone: 'totalRange', marks: epRange, alt: 'Google Business Profile for an El Paso PI firm: 23 calls from May to July 2026, rising every month' })]}
      />
      <figcaption>A PI firm in El Paso, May to July 2026, by Google’s own count.</figcaption>
    </figure>
  </PageHero>

  <DepthZone depth={depth} faqTone="fog" authorLinkLabel="Fahim’s full background">
    <figure slot="serp" class="con-serp">
      <ShotSwap
        tag="#1"
        wide={[shot(proof.lseSerpTall, { crop: 'search', alt: '' }), shot(proof.lseSerpTall, { crop: 'result', marks: ['title'] })]}
        narrow={[lseNarrow(shot(phoneProof.lseSearch)), lseNarrow(shot(phoneProof.lseResult, { marks: ['title'] }))]}
      />
      <figcaption class="lse-small">Google search, United States, 8 November 2026.</figcaption>
    </figure>
    <div slot="promises" class="bsv-rows"><Rows variant="inline" items={promises} /></div>
    <div slot="access" class="bsv-rows"><Rows variant="inline" items={access} /></div>
    <div slot="moments" class="bsv-rows"><Rows variant="inline" items={moments} /></div>
  </DepthZone>

  <FinalCta heading="Ask a law firm SEO consultant how many more calls you could get, and for how much." writeHref="#con-hero-form">
    <p>In 30 minutes you see who takes the calls you want today, what to fix first and what the work would cost.</p>
  </FinalCta>
</InnerPage>

<style is:global>
  /* Hero: the chart with its tag, on the fog panel. */
  .con-hero__fig { display: grid; gap: 14px; align-content: start; margin: 0; }

  /* Our own result, under the first test's answer, wide enough that the result's lines read; caption under it. */
  .con-serp { display: grid; gap: 10px; max-width: 920px; }
</style>
