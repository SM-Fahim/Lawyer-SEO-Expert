---
// A real screenshot on a white sheet, with the review marks layered over it in HTML:
//   marks     highlighter strokes (multiply blend, so the text stays readable). One per figure, ideally.
//   chip      a rank chip in the left gutter, at the height of the result it ranks. Real positions only.
//   brackets  thin brackets in a right gutter with an italic label, for a span of the page ("Sponsored, above").
// Positions are percentages of the image, so they hold at any width. The image never shows larger than its
// natural size (the captures are low resolution), so the figure's max width is the image's own.
// Margin notes go next to the figure in a .lse-review__side cell, not in here.
interface Box { x: number; y: number; w: number; h: number }
interface Bracket { y: number; h: number; label: string }
interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  marks?: Box[];
  chip?: { y: number; label: string; aria: string };
  brackets?: Bracket[];
  /** Load eagerly with high priority: only for the hero. */
  priority?: boolean;
  class?: string;
}
const { src, width, height, alt, marks = [], chip, brackets = [], priority = false, class: className } = Astro.props;
const pct = (n: number) => `${n}%`;
---
<div class:list={['lse-serp', 'lse-sheet', chip && 'lse-serp--chip', brackets.length > 0 && 'lse-serp--brackets', className]} style={`--w:${width}px`}>
  <div class="lse-serp__shot">
    <img src={src} width={width} height={height} alt={alt} loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : undefined}>
    {marks.map((m) => (
      <span class="lse-serp__mark" aria-hidden="true" style={`left:${pct(m.x)};top:${pct(m.y)};width:${pct(m.w)};height:${pct(m.h)}`}></span>
    ))}
    {chip && <span class="lse-serp__chip lse-chip" style={`top:${pct(chip.y)}`} role="img" aria-label={chip.aria}>{chip.label}</span>}
    {brackets.map((b) => (
      <span class="lse-serp__bracket" style={`top:${pct(b.y)};height:${pct(b.h)}`}><span>{b.label}</span></span>
    ))}
  </div>
</div>

<style is:global>
  .lse-serp { position: relative; padding: clamp(14px, 2.4vw, 28px); width: fit-content; max-width: 100%; }
  .lse-serp__shot { position: relative; max-width: var(--w); }
  .lse-serp__shot img { width: 100%; border-radius: 2px; }
  .lse-serp--chip { padding-left: clamp(46px, 6vw, 72px); }
  .lse-serp--brackets { padding-right: clamp(118px, 15vw, 190px); }
  .lse-serp__mark {
    position: absolute; background: var(--marker); mix-blend-mode: multiply;
    border-radius: var(--r-mark); transform: rotate(-.4deg);
  }
  .lse-serp__chip {
    position: absolute; left: calc(-1 * clamp(46px, 6vw, 72px) / 2); transform: translate(-50%, -50%);
    font-size: clamp(20px, 2vw, 26px);
  }
  .lse-serp__bracket {
    position: absolute; left: calc(100% + 14px); width: 10px;
    border: 1px solid var(--ink); border-left: 0; border-radius: 0 3px 3px 0;
  }
  .lse-serp__bracket > span {
    position: absolute; left: 22px; top: 50%; transform: translateY(-50%);
    width: clamp(84px, 11vw, 150px);
    font: italic 400 clamp(14px, 1.2vw, 17px) / 1.3 var(--serif); color: var(--ink-2);
  }
</style>
