---
// A starting price as a plain line in the headline serif: the name and price as one sentence, then what it
// covers, then text links. Not a receipt, table or comparison. Only the approved prices ($2,000; check-dist).
interface Props {
  /** The bold sentence, e.g. "SEO for law firms, from $2,000 a month." */
  line: string;
}
const { line } = Astro.props;
---
<div class="lse-price">
  <h3 class="lse-price__line">{line}</h3>
  <div class="lse-price__what"><slot /></div>
  {Astro.slots.has('links') && <p class="lse-price__links lse-links"><slot name="links" /></p>}
</div>

<style is:global>
  .lse-price { padding: var(--s4) 0 var(--s5); border-top: 1px solid var(--ink); }
  .lse-price__line { font-size: clamp(30px, 2.4vw + 14px, 46px); line-height: 1.1; letter-spacing: -.012em; max-width: 20ch; }
  .lse-price__what { margin-top: var(--s2); max-width: 36em; color: var(--ink-2); }
  .lse-price__links { margin-top: var(--s2); font-weight: 600; }
</style>
