---
// The practice-area pages as big text links in columns, with hairlines. No icons, no descriptions.
// The hover is the highlighter, so the link you are about to open is marked.
import { practicePages } from '../data/pages';
---
<ul class="lse-practice">
  {practicePages.map((p) => (
    <li><a href={p.href}>{p.label}</a></li>
  ))}
</ul>

<style is:global>
  .lse-practice { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); column-gap: 40px; border-top: 2px solid var(--ink); }
  .lse-practice li { border-bottom: 1px solid var(--line); }
  .lse-practice a {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 18px 0 19px;
    font-size: clamp(20px, .5vw + 17px, 24px); font-weight: 700; letter-spacing: -.02em; line-height: 1.2;
    text-decoration: none;
  }
  .lse-practice a::after {
    content: ""; flex: none; width: 10px; height: 10px;
    border-top: 2px solid currentColor; border-right: 2px solid currentColor; transform: rotate(45deg);
    margin-right: 4px;
  }
  .lse-practice a:hover { background: linear-gradient(178deg, transparent 18%, var(--marker) 18%, var(--marker) 82%, transparent 82%) no-repeat 0 0 / 100% 100%; }
</style>
