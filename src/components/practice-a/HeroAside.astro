---
// Practice set A: a hero with the compact form beside the H1 (7/5 at 1000px and up) and the proof frame under
// both at the full content width, on white with a hairline frame. Built for medical malpractice, whose AI
// answer capture is wide and only reads well when it gets the whole width. PageHero has no shape for it.
// Phones: H1, line, form, then the visual.
import { site } from '../../data/site';
import LeadForm from '../LeadForm.astro';
import type { HeroForm } from '../kit/PageHero.astro';
interface Props {
  h1: string;
  lead?: string;
  form: HeroForm;
  talk?: string;
  headingId?: string;
}
const { h1, lead, form, talk = 'Rather talk it through?', headingId = 'hero-h' } = Astro.props;
---
<section class="lse-hero pa-aside" aria-labelledby={headingId}>
  <div class="lse-wrap">
    <div class="pa-aside__grid">
      <div class="pa-aside__text">
        <h1 id={headingId} class="lse-hero__h">{h1}</h1>
        {lead && <p class="lse-lead lse-hero__lead">{lead}</p>}
      </div>
      <div class="lse-hero__act pa-aside__act">
        <LeadForm compact title={form.title} titleTag={form.titleTag ?? 'h2'} sub={form.sub} idPrefix={form.idPrefix} label={form.label} format={form.format ?? 'Ranking review by email'} submitLabel={form.submitLabel} practiceArea={form.practiceArea ?? null}>
          <Fragment slot="privacy">We use your details to reply and to measure our ads. <a href="/privacy-policy/">Privacy policy</a>.</Fragment>
        </LeadForm>
        {talk && <p class="lse-hero__talk">{talk} <a href={site.cta.href} data-cal>{site.cta.label}</a></p>}
      </div>
    </div>
    <div class="pa-aside__visual"><slot name="visual" /></div>
  </div>
</section>

<style is:global>
  .pa-aside__grid { display: grid; gap: 36px; grid-template-columns: minmax(0, 1fr); }
  .pa-aside .lse-hero__h { max-width: 14ch; }
  .pa-aside__visual { margin-top: clamp(48px, 6vw, 88px); padding-top: clamp(32px, 4vw, 48px); border-top: 2px solid var(--ink); display: grid; gap: 14px; }
  @media (min-width: 1000px) {
    .pa-aside__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(48px, 5vw, 80px); align-items: start; }
    .pa-aside__act { padding: 28px 28px 24px; border: 1px solid var(--line-2); border-radius: var(--r-frame); }
  }
</style>
