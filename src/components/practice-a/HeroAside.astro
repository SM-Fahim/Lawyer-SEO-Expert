---
// Practice set A: a hero with the compact form beside the H1 (7/5 at 1000px and up) and the proof frame under
// both at the full content width, on white with a hairline frame. Built for medical malpractice, whose AI
// answer capture is wide and only reads well when it gets the whole width. PageHero has no shape for it.
// Phones: H1, line, form, then the visual.
import { askTitle, site } from '../../data/site';
import LeadForm from '../LeadForm.astro';
import HeroTrust from '../kit/HeroTrust.astro';
import type { HeroForm } from '../kit/PageHero.astro';
interface Props {
  h1: string;
  lead?: string;
  form: HeroForm;
  talk?: string;
  headingId?: string;
}
const { h1, lead, form, talk = site.ask.talk, headingId = 'hero-h' } = Astro.props;
---
<section class="pa-aside" aria-labelledby={headingId}>
  <div class="lse-wrap">
    <div class="pa-aside__grid">
      <div class="pa-aside__text">
        <h1 id={headingId} class="pa-aside__h">{h1}</h1>
        {lead && <p class="lse-lead pa-aside__lead">{lead}</p>}
      </div>
      <div class="pa-aside__act">
        <LeadForm compact title={form.title ?? askTitle(form.who)} titleTag={form.titleTag ?? 'h2'} sub={form.sub ?? site.ask.sub} idPrefix={form.idPrefix} label={form.label} format={form.format ?? 'Plan and price by email'} submitLabel={form.submitLabel ?? site.ask.submit} done={form.done ?? site.ask.done} practiceArea={form.practiceArea ?? null}>
          <Fragment slot="privacy">We use your details to reply and to measure our ads. <a href="/privacy-policy/">Privacy policy</a>.</Fragment>
        </LeadForm>
        {talk && <p class="pa-aside__talk">{talk} <a href={site.cta.href} data-cal>{site.cta.label}</a></p>}
        <HeroTrust />
      </div>
    </div>
    <div class="pa-aside__visual"><slot name="visual" /></div>
  </div>
</section>

<style is:global>
  .pa-aside { position: relative; padding: clamp(20px, 2.6vw, 40px) 0 clamp(72px, 8vw, 112px); }
  .pa-aside__grid { display: grid; gap: 36px; grid-template-columns: minmax(0, 1fr); }
  .pa-aside__h { font-size: clamp(40px, 3vw + 20px, 76px); max-width: 13ch; }
  .pa-aside__lead { margin-top: clamp(18px, 2vw, 26px); max-width: 30em; }
  .pa-aside__act { display: grid; gap: 14px; align-content: start; }
  .pa-aside__talk { font-size: 16px; color: var(--ink-2); }
  .pa-aside__talk a { font-weight: 700; }
  .pa-aside__visual { margin-top: clamp(48px, 6vw, 88px); padding-top: clamp(32px, 4vw, 48px); border-top: 2px solid var(--ink); display: grid; gap: 14px; }
  @media (min-width: 1000px) {
    .pa-aside__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(48px, 5vw, 80px); align-items: end; }
  }
</style>
