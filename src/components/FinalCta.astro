---
// The closing section of a page, call-first (judge ruling 4): by the end of the page trust is highest, so the close
// is the real calendar. H2 and the lead on the left with Fahim and Josh, one line each, and one text link back to
// the form ("Prefer to write?"); the calendar card on the right (5/7 at 1000px and up). Never a button beside it.
// It carries id="book", so a /#book link without JavaScript lands on the calendar. Use it once per page, last.
import { fahim, josh } from '../data/people';
import CalendlyInline from './CalendlyInline.astro';
import Face from './kit/Face.astro';
interface Props {
  /** Asks about calls and cost, names the page's practice or service, and is unique on the site (ruling 3). */
  heading: string;
  /** Where "Send your website" goes: the page's hero form (like "#pi-hero-form"), or the contact page. */
  writeHref?: string;
}
const { heading, writeHref = '/contact-us/' } = Astro.props;
const people = [
  { person: fahim, line: 'Leads every account and is on every call.' },
  { person: josh, line: 'Texas attorney since 2008. Joins calls with firms.' },
];
---
<section class="lse-section lse-final" id="book" aria-labelledby="final-h">
  <div class="lse-wrap lse-final__grid">
    <div class="lse-final__text">
      <h2 id="final-h">{heading}</h2>
      <div class="lse-final__lead lse-lead"><slot /></div>
      <ul class="lse-final__people">
        {people.map(({ person, line }) => (
          <li>
            <Face person={person} size="xs" />
            <p><strong>{person.name}</strong> {line}</p>
          </li>
        ))}
      </ul>
      <p class="lse-final__write">Prefer to write? <a href={writeHref} data-final-write>Send your website</a></p>
    </div>
    <div class="lse-final__cal">
      <CalendlyInline lazy head={false} formHref={writeHref} extraClass="lse-final__card" />
    </div>
  </div>
</section>

<script>
  // "Send your website" to the hero form on the same page: once the page has scrolled there, the website field
  // takes the focus, so the visitor can type at once.
  document.querySelectorAll<HTMLAnchorElement>('a[data-final-write]').forEach((link) => {
    const hash = link.getAttribute('href') ?? '';
    if (!hash.startsWith('#')) return;
    link.addEventListener('click', () => {
      const field = document.getElementById(hash.slice(1))?.querySelector<HTMLInputElement>('input[name="website"]');
      if (field) window.setTimeout(() => field.focus({ preventScroll: true }), 0);
    });
  });
</script>

<style is:global>
  .lse-final__grid { display: grid; gap: var(--s5); }
  .lse-final h2 { font-size: var(--fs-h2); letter-spacing: -.035em; line-height: 1.02; max-width: 17ch; }
  .lse-final__lead { margin-top: var(--s3); max-width: 30em; }
  .lse-final__people { list-style: none; margin-top: var(--s4); display: grid; gap: 14px; max-width: 30em; }
  .lse-final__people li { display: flex; align-items: center; gap: 16px; padding-top: 14px; border-top: 1px solid var(--line); }
  .lse-final__people .lse-face--xs { width: 72px; }
  .lse-final__people p { font-size: 16px; line-height: 1.45; color: var(--ink-2); }
  .lse-final__people strong { display: block; color: var(--ink); font-size: 17px; }
  .lse-final__write { margin-top: var(--s4); font-size: 17px; color: var(--ink-2); }
  .lse-final__write a { font-weight: 700; }
  .lse-final__card { background: var(--paper); border: 1px solid var(--line-2); border-radius: var(--r-frame); overflow: hidden; }
  [id$='-form'] { scroll-margin-top: 120px; }
  @media (min-width: 1000px) {
    .lse-final__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(48px, 5vw, 72px); align-items: start; }
  }
</style>
