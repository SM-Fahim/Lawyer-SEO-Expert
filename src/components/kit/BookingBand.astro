---
// A booking section with the real calendar: the way to act straight after a hero that has no form. The
// calendar (CalendlyInline lazy) mounts only as it nears the screen, so it never slows the first paint; the
// card's own calendar-shaped placeholder holds its place until then. The card has no head of its own: the band's
// H2 and lead already say what it is.
// Layouts: 'full' (H2 and lead on top, the calendar the full content width under them) or 'split' (H2, lead
// and the default slot on the left at 5, the calendar on the right at 7). The default slot is for a reply
// line; slot "after" goes under the calendar. Never a button beside it.
// id="book" when it closes the page in place of FinalCta (the header and booking links land there).
import CalendlyInline from '../CalendlyInline.astro';
interface Props {
  heading: string;
  headingId: string;
  lead?: string;
  layout?: 'full' | 'split';
  tone?: 'white' | 'fog';
  id?: string;
  /** Where "send your website" points if the calendar can't load: the page's form, or /contact-us/. */
  formHref?: string;
  class?: string;
}
const { heading, headingId, lead, layout = 'full', tone = 'white', id, formHref, class: className } = Astro.props;
---
<section class:list={['lse-section', 'lse-bookband', `lse-bookband--${layout}`, { 'lse-section--fog': tone === 'fog' }, className]} id={id} aria-labelledby={headingId}>
  <div class="lse-wrap lse-bookband__grid">
    <div class="lse-bookband__text">
      <h2 id={headingId}>{heading}</h2>
      {lead && <p class="lse-lead lse-h2-lead">{lead}</p>}
      {Astro.slots.has('default') && <div class="lse-bookband__more"><slot /></div>}
    </div>
    <div class="lse-bookband__cal">
      <CalendlyInline lazy head={false} formHref={formHref} extraClass="lse-bookband__card" />
      {Astro.slots.has('after') && <div class="lse-bookband__after"><slot name="after" /></div>}
    </div>
  </div>
</section>

<style is:global>
  .lse-bookband__grid { display: grid; gap: var(--s5); }
  .lse-bookband__more { margin-top: var(--s3); color: var(--ink-2); max-width: 30em; display: grid; gap: 8px; }
  .lse-bookband__card { background: var(--paper); border: 1px solid var(--line-2); border-radius: var(--r-frame); overflow: hidden; }
  .lse-bookband__after { margin-top: var(--s3); color: var(--ink-2); display: grid; gap: 8px; max-width: 46em; }
  @media (min-width: 1000px) {
    .lse-bookband--split .lse-bookband__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(48px, 5vw, 72px); align-items: start; }
  }
</style>
