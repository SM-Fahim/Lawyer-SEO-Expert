---
// "Hired one by one": what each part costs a month on its own, then the struck total (a black marker stroke
// through it). Reads src/data/pricing.ts, never retyped values. Used inside PriceBand and PriceCard.
// A page that shows it needs every amount in its PRICES_BY_PAGE entry (scripts/check-dist.mjs).
import { included, separateTotal, type PriceRow } from '../../data/pricing';
interface Props {
  rows?: readonly PriceRow[];
  total?: string;
  /** Words before the struck total. */
  totalLabel?: string;
  /** Leave the rows out and show only the struck total line. */
  totalOnly?: boolean;
  class?: string;
}
const { rows = included, total = separateTotal, totalLabel = 'Hired one by one:', totalOnly = false, class: className } = Astro.props;
---
<div class:list={['lse-costs', { 'lse-costs--total': totalOnly }, className]}>
  {!totalOnly && (
    <ul class="lse-costs__rows">
      {rows.map((r) => <li><span>{r.item}</span><b>{r.cost}</b></li>)}
    </ul>
  )}
  <p class="lse-costs__sep"><span>{totalLabel}</span> <s class="lse-strike">{total} a month</s></p>
</div>

<style is:global>
  /* Rows: the part on the left, its usual monthly cost on the right. --rule is the hairline: darker on the
     marker band, the normal line on white. */
  .lse-costs { --rule: rgba(0, 0, 0, .22); }
  .lse-costs__rows { list-style: none; border-top: 2px solid var(--ink); }
  .lse-costs__rows li { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding: 13px 0 14px; border-bottom: 1px solid var(--rule); color: var(--ink); line-height: 1.3; }
  .lse-costs__rows span { font-size: clamp(17px, .3vw + 15px, 19px); font-weight: 500; }
  .lse-costs__rows b { flex: none; font-size: clamp(18px, .4vw + 15px, 21px); font-weight: 800; letter-spacing: -.01em; font-variant-numeric: tabular-nums lining-nums; text-align: right; }
  /* The total, struck through with a black marker stroke. */
  .lse-costs__sep { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 6px 20px; padding-top: 16px; border-top: 2px solid var(--ink); margin-top: -1px; font-size: clamp(19px, .5vw + 16px, 23px); font-weight: 700; color: var(--ink); }
  .lse-costs--total .lse-costs__sep { justify-content: flex-start; margin-top: 0; padding-bottom: 16px; border-bottom: 2px solid var(--ink); }
  .lse-costs--total .lse-strike { margin-left: 0; }
  .lse-strike { position: relative; text-decoration: none; font-weight: 800; white-space: nowrap; margin-left: auto; }
  .lse-strike::after { content: ""; position: absolute; left: -5px; right: -5px; top: calc(50% - .05em); height: .13em; background: var(--ink); transform: rotate(-2deg); border-radius: 2px; clip-path: polygon(0 25%, 100% 0, 100% 75%, 0 100%); }
  /* Phones: the label and the struck total stay on one line, and the stroke's overhang stays inside the column. */
  @media (max-width: 480px) {
    .lse-costs__sep { flex-wrap: nowrap; gap: 10px; font-size: 17px; }
    .lse-costs__sep .lse-strike { margin-right: 5px; }
  }
</style>
