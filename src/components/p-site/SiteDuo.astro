---
// A site we built, on a desktop and a phone: the browser frame, with the phone frame overlapping its lower
// right corner (the web design hero). docs/kit.md lists this as "not in the kit": it only arranges BrowserShot
// and PhoneShot, and changes neither.
import BrowserShot from '../kit/BrowserShot.astro';
import PhoneShot from '../kit/PhoneShot.astro';
import type { ShotImage } from '../Shot.astro';
interface Props {
  desktop: ShotImage;
  phone: ShotImage;
  tag?: string;
  tagSmall?: boolean;
  priority?: boolean;
}
const { desktop, phone, tag, tagSmall = true, priority = false } = Astro.props;
---
<div class="ps-duo">
  <BrowserShot class="ps-duo__desk" tag={tag} tagSmall={tagSmall} tagSide="left" priority={priority} images={[desktop]} />
  <PhoneShot class="ps-duo__phone" priority={priority} images={[phone]} />
</div>

<style is:global>
  /* The desktop frame leaves room on the right for the phone to hang off its corner. */
  .ps-duo { position: relative; padding-right: 13%; padding-bottom: 12%; }
  .ps-duo__desk { position: relative; z-index: 0; }
  .ps-duo__phone { position: absolute; z-index: 1; right: 0; bottom: 0; width: 25%; min-width: 92px; max-width: 200px; }
  .ps-duo__phone .lse-shot__frame { box-shadow: 0 18px 40px -18px rgba(0, 0, 0, .45); }
  @media (max-width: 560px) {
    .ps-duo__phone .lse-shot__frame { border-width: 5px; border-radius: 18px; }
  }
</style>
