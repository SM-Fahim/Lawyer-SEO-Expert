---
// One result, one hairline row. Two shapes:
//   figure  a big serif number on the left, its sentence on the right, the source underneath in small type.
//   title   a bold lead-in ("A personal injury firm in New Orleans.") with the text, and a capture in `media`.
// Every number has its source and date next to it, or it doesn't go on the page.
interface Props {
  figure?: string;
  /** Read out instead of the figure, if the figure alone is unclear. */
  figureLabel?: string;
  title?: string;
}
const { figure, figureLabel, title } = Astro.props;
const hasMedia = Astro.slots.has('media');
const hasSource = Astro.slots.has('source');
---
<div class:list={['lse-row', figure && 'lse-row--fig', hasMedia && 'lse-row--media']}>
  {figure && <p class="lse-row__fig" aria-label={figureLabel}>{figure}</p>}
  <div class="lse-row__text">
    <p>{title && <strong>{title} </strong>}<slot /></p>
    {hasSource && <p class="lse-row__src"><slot name="source" /></p>}
  </div>
  {hasMedia && <div class="lse-row__media"><slot name="media" /></div>}
</div>

<style is:global>
  .lse-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px 40px; padding: var(--s4) 0; border-top: 1px solid var(--rule); }
  .lse-row:last-child { border-bottom: 1px solid var(--rule); }
  .lse-row__text { max-width: 34em; }
  .lse-row__text > p:first-child { font-size: var(--fs-lead); line-height: 1.45; }
  .lse-row__text strong { font-weight: 600; }
  .lse-row__src { margin-top: 8px; font-size: var(--fs-meta); color: var(--muted); }
  .lse-row__fig { font: 500 clamp(56px, 5vw + 16px, 96px) / .9 var(--serif); letter-spacing: -.02em; font-variant-numeric: lining-nums; }
  @media (min-width: 761px) {
    .lse-row--fig { grid-template-columns: 200px minmax(0, 1fr); align-items: baseline; }
  }
  @media (min-width: 1000px) {
    .lse-row--media { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: start; }
  }
</style>
