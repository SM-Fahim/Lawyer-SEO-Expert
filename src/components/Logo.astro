---
// The concept-3 lockup (highlighter S, "SEO" on the same swipe), redrawn in Libre Franklin for homepage v2.
// Inlined so it costs no request. Lettering is outlined to paths, so it needs no font.
// `reverse` is for the black footer: white lettering, the swipes and their letters stay as they are.
import lockup from '../assets/logo/lse-lockup.svg?raw';
import reverse from '../assets/logo/lse-lockup-reverse.svg?raw';
interface Props {
  variant?: 'default' | 'reverse';
  class?: string;
}
const { variant = 'default', class: className } = Astro.props;
const svg = (variant === 'reverse' ? reverse : lockup)
  .replace(/<title>[\s\S]*?<\/title>/, '')
  .replace(/\swidth="[^"]*"\sheight="[^"]*"\srole="img"\saria-label="[^"]*"/, ' aria-hidden="true" focusable="false"');
---
<a class:list={['lse-logo', className]} href="/" aria-label="Lawyer SEO Expert, home" set:html={svg} />

<style>
  .lse-logo { display: inline-block; line-height: 0; border-radius: 2px; }
  .lse-logo :global(svg) { height: 38px; width: auto; }
  @media (max-width: 760px) { .lse-logo :global(svg) { height: 30px; } }
</style>
