---
// "Let's see if we're a fit": the 30-minute call with the real calendar, for the CRM landers. It follows
// BookingBand's split layout (text 5, calendar 7) but titles the calendar card for this call, since a ranking
// review is not what these visitors came for. The calendar mounts lazily, as on every page, and a
// calendar-shaped skeleton holds its place until then.
import CalendlyInline from '../CalendlyInline.astro';
import Rows from '../kit/Rows.astro';
interface Props {
  headingId: string;
  tone?: 'white' | 'fog';
  id?: string;
}
const { headingId, tone = 'white', id } = Astro.props;
---
<section class:list={['lse-section', 'crm-book', { 'lse-section--fog': tone === 'fog' }]} id={id} aria-labelledby={headingId}>
  <div class="lse-wrap crm-book__grid">
    <div>
      <h2 id={headingId}>Let’s see if we’re a fit.</h2>
      <p class="lse-lead lse-h2-lead">A 30-minute call about what you need, and a clear plan for what comes next.</p>
      <h3 class="crm-book__h">On the call</h3>
      <Rows
        class="crm-book__rows"
        variant="numbered"
        titleTag="p"
        items={[
          { title: 'Your current process', text: 'Where things slow your team down today.' },
          { title: 'A custom plan', text: 'How we would automate your own workflow.' },
          { title: 'Price and timeline', text: 'An exact price and delivery dates.' },
        ]}
      />
      <p class="crm-book__note">No sales pressure. If it isn’t a fit, we’ll say so.</p>
    </div>
    <div>
      <CalendlyInline lazy titleTag="h3" title="Book a 30-minute call" sub="Free. Choose a time that suits you." extraClass="crm-book__card" />
    </div>
  </div>
</section>

<style is:global>
  .crm-book__grid { display: grid; gap: var(--s5); }
  .crm-book__h { margin-top: var(--s5); font-size: var(--fs-h3); }
  .crm-book__rows { margin-top: var(--s2); }
  .crm-book__rows .lse-row__t { font-weight: 800; color: var(--ink); }
  .crm-book__note { margin-top: var(--s3); font-weight: 700; color: var(--ink); }
  .crm-book__card { background: var(--paper); border: 1px solid var(--line-2); border-radius: var(--r-frame); overflow: hidden; }
  @media (min-width: 1000px) {
    .crm-book__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(48px, 5vw, 72px); align-items: start; }
  }
</style>
