---
// FAQ accordion: native <details>, so it needs no script. Hairline dividers, first question open.
// Build the page's FAQPage JSON-LD from the same items with faqSchema() in src/lib/schema.ts, so the two match.
export interface FaqItem {
  q: string;
  /** The answer as shown. May hold links and inline placeholders. */
  html: string;
  /** Plain answer for JSON-LD. Defaults to html, so set it when html has markup. */
  text?: string;
}
interface Props {
  items: FaqItem[];
  /** Which item starts open. -1 for none. */
  open?: number;
}
const { items, open = 0 } = Astro.props;
---
<div class="lse-faq">
  {items.map((item, i) => (
    <details open={i === open}>
      <summary><span>{item.q}</span><span class="lse-faq__pm" aria-hidden="true"></span></summary>
      <div class="lse-faq__a"><p set:html={item.html}></p></div>
    </details>
  ))}
</div>

<style is:global>
  .lse-faq { border-top: 2px solid var(--ink); max-width: 56em; }
  .lse-faq details { border-bottom: 1px solid var(--line); }
  .lse-faq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 22px 0; cursor: pointer; list-style: none;
    font-size: clamp(19px, .5vw + 16px, 23px); font-weight: 700; letter-spacing: -.018em; line-height: 1.3; color: var(--ink);
  }
  .lse-faq summary::-webkit-details-marker { display: none; }
  .lse-faq summary:hover > span:first-child { text-decoration: underline; text-decoration-color: var(--marker); text-decoration-thickness: 3px; text-underline-offset: .25em; }
  .lse-faq__pm { position: relative; flex: none; width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--ink); }
  .lse-faq__pm::before, .lse-faq__pm::after { content: ""; position: absolute; left: 8px; top: 13px; width: 12px; border-top: 2px solid var(--ink); }
  .lse-faq__pm::after { transform: rotate(90deg); transition: transform .15s; }
  .lse-faq details[open] .lse-faq__pm { background: var(--marker); }
  .lse-faq details[open] .lse-faq__pm::after { transform: rotate(0); }
  .lse-faq__a { padding: 0 56px 26px 0; max-width: 44em; color: var(--ink-2); }
</style>
