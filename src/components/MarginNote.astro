---
// A margin note: italic serif that says when and how something was measured.
// Put it in a .lse-review__side cell next to what it describes. On wide screens it gets a hairline leader
// and a dot pointing left; under 1080px it drops inline under the item with a marker bar.
// `leader={false}` for notes that sit under another note.
interface Props {
  leader?: boolean;
  as?: 'p' | 'figcaption' | 'div';
  class?: string;
}
const { leader = true, as: Tag = 'p', class: className } = Astro.props;
---
<Tag class:list={['lse-note', leader && 'lse-note--leader', className]}><slot /></Tag>

<style is:global>
  .lse-note {
    position: relative;
    font: italic 400 var(--fs-note) / 1.4 var(--serif);
    color: var(--ink-2);
    max-width: 24em;
    border-left: 3px solid var(--marker);
    padding-left: 14px;
  }
  @media (min-width: 1080px) {
    .lse-note--leader { border-left: 0; padding-left: 0; }
    .lse-note--leader::before { content: ""; position: absolute; left: -56px; top: .7em; width: 44px; border-top: 1px solid var(--ink); }
    .lse-note--leader::after { content: ""; position: absolute; left: -60px; top: calc(.7em - 3px); width: 7px; height: 7px; border-radius: 50%; background: var(--ink); }
  }
</style>
