---
// Every page's shell. Sitewide features come from src/data/features.ts, so pages never list them.
import '../styles/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { featuresFor } from '../data/features';
import { site } from '../data/site';
import type { PageType } from '../../worker/pagetype';

interface Props {
  /** Sent to Meta as ViewContent's content_category. Layouts set it, so pages rarely do. */
  pageType: PageType;
  title: string;
  description: string;
  /** The page's own path, with trailing slash. Used for the canonical and feature exclusions. */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Overrides the robots tag. Ignored with noindex. */
  robots?: string;
  /** Links the RSS feed from this page. */
  feed?: boolean;
  /** Blog posts: their article tags, see Seo.astro. */
  article?: {
    published: string;
    modified: string;
    section: string;
    locale?: string | undefined;
    siteName?: string | undefined;
    imageWidth?: number | undefined;
    imageHeight?: number | undefined;
    imageAlt?: string | undefined;
    imageType?: string | undefined;
  };
  schema?: object[];
  /** False leaves the Organization and WebSite nodes out of the JSON-LD. */
  siteGraph?: boolean;
}
const { path, pageType, ...seo } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-page-type={pageType}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{/* Meta domain verification for lawyerseoexpert.com (Legal CMO Expert portfolio, domain ID 1500144445354951).
    Server-rendered on purpose: Meta reads it without running JavaScript. */}
<meta name="facebook-domain-verification" content="jxdbg59fjyan5q2zm71a9ke66z2trv">
<Seo path={path} {...seo} />
<link rel="preload" href="/fonts/libre-franklin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href={site.logo} type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#ffffff">
<script is:inline>document.documentElement.classList.add('js')</script>
{featuresFor(path, 'head').map((f) => <f.component />)}
</head>
<body>
<a class="lse-skip" href="#main">Skip to content</a>
<Header />
<main id="main">
  <slot />
</main>
<Footer />
{featuresFor(path, 'body').map((f) => <f.component />)}
</body>
</html>
