{
  "name": "lawyerseoexpert-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist.mjs && node scripts/check-unique.mjs",
    "check": "astro check && tsc -p worker/tsconfig.json && tsc -p tests/worker/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "types": "wrangler types --strict-vars=false worker/worker-configuration.d.ts",
    "local": "npm run build && wrangler dev --local-upstream localhost:8787 --var LIVE:false --var REDDIT_TEST_ID: --var EMAIL_TO:",
    "seo-baseline": "node scripts/seo-baseline.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "test": "vitest run && npm run test:runtime && npm run test:unique",
    "test:runtime": "node tests/runtime/router-runtime.mjs",
    "test:unique": "node --test tests/unique/",
    "test:e2e": "npm run build && playwright test",
    "verify-live": "node scripts/verify-live.mjs",
    "broken-report": "node scripts/broken-report.mjs",
    "check-blocklists": "node scripts/check-blocklists.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check-unique": "node scripts/check-unique.mjs",
    "refresh-lcme-snapshot": "node scripts/check-unique.mjs --refresh"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "astro": "7.4.5",
    "esbuild": "0.28.2",
    "parse5": "8.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
