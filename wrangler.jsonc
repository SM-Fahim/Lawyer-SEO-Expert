{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Workers Builds Worker must have this exact name.
  "name": "lawyerseoexpert-site",
  // Pinned: two Cloudflare accounts are in play on this PC. Do not remove.
  "account_id": "afdd6dc89aef390d5327db09d0c00b8f",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-08",
  "upload_source_maps": true,
  // Off since launch (2026-11-09): the router's noindex depends only on LIVE, so with LIVE true the workers.dev
  // host would serve indexable copies. Check changes on a version preview URL (`npx wrangler versions upload`).
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Needed: without this, browser page loads that match no file skip the Worker, so redirects,
    // the broken-page log and the add-ons would never see them. Files that never move can skip it.
    "run_worker_first": ["/*", "!/img/*", "!/fonts/*", "!/_astro/*"]
  },
  "vars": {
    // Live since 2026-11-09. While it is not "true" the Worker adds X-Robots-Tag: noindex everywhere.
    "LIVE": "true",
    "SITE_HOST": "lawyerseoexpert.com",
    "REDDIT_PIXEL_ID": "a2_hx7ja4uz0lm1",
    "REDDIT_TEST_ID": "", // ignored while LIVE is true
    // GA4 Measurement Protocol (worker/ga4.ts). Also needs the GA4_API_SECRET secret, or nothing is sent.
    "GA4_MEASUREMENT_ID": "G-YCNP1LPT5W",
    // Meta Pixel (dataset) ID, for the Conversions API (worker/meta.ts). Also needs the META_CAPI_TOKEN
    // secret, or nothing is sent. The browser's copy is in src/data/site.ts.
    "META_PIXEL_ID": "1120676457364234",
    "EMAIL_FROM": "leads@notify.lawyerseoexpert.com",
    "EMAIL_TO": "fahim@wpseogeeks.com,fahim@legalcmoexpert.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lse-site",
      "database_id": "7386cb66-d3eb-4c0d-84b4-ed6982b32729",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["leads@notify.lawyerseoexpert.com"],
      "allowed_destination_addresses": ["fahim@wpseogeeks.com", "fahim@legalcmoexpert.com"]
    }
  ],
  // Retries unsent lead emails and deletes old events. Crons only ever run on production.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Previews do NOT inherit production settings. They get their own D1 and never send real email:
  // no send_email binding here on purpose, and blank EMAIL_TO means leads are logged only.
  // Crons don't belong here, because Previews never run them. REDDIT_PIXEL_ID blank means Reddit is off.
  "previews": {
    "vars": {
      "LIVE": "false",
      "SITE_HOST": "lawyerseoexpert.com",
      "REDDIT_PIXEL_ID": "", // the test pixel, once the owner chooses to test on a Preview
      "REDDIT_TEST_ID": "",
      "GA4_MEASUREMENT_ID": "", // blank: Previews never send to GA4
      "META_PIXEL_ID": "", // blank: Previews never send to Meta
      "EMAIL_FROM": "",
      "EMAIL_TO": ""
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "lse-site-preview",
        "database_id": "bcbbb735-afb4-4d27-818f-97d376a138a3",
        "migrations_dir": "migrations"
      }
    ]
  }
  // A deploy replaces this Worker's routes, so keep this complete. Live since 2026-11-09 (owner OK).
  // The /intake routes belong to another Worker (rudin-intake-staging) and must never be listed here.
  // www (since 2026-11-09): the router sends every www request to the apex in one 301. Rudin's www /intake
  // routes are more specific, so Cloudflare still sends those to rudin-intake-staging first.
  ,"routes": [
    { "pattern": "lawyerseoexpert.com/*", "zone_name": "lawyerseoexpert.com" },
    { "pattern": "www.lawyerseoexpert.com/*", "zone_name": "lawyerseoexpert.com" }
  ]
}
